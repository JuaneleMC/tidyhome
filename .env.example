# ==========================================
# Configuración Base de Datos Serverless (Turso)
# ==========================================
# Para conectar con tu base de datos gratuita de Turso:
# 1. Instala el CLI de Turso o ve a https://turso.tech
# 2. turso db create tareas-hogar
# 3. turso db show tareas-hogar --url (Pega el valor en TURSO_DATABASE_URL)
# 4. turso db tokens create tareas-hogar (Pega el token en TURSO_AUTH_TOKEN)
#
# Si no especificas estas variables, la app usará automáticamente
# una base de datos SQLite local ('file:local.db') sin necesidad de configuración previa.

TURSO_DATABASE_URL="libsql://tu-base-de-datos.turso.io"
TURSO_AUTH_TOKEN="tu-turso-auth-token-aqui"
