---
interface Props {
  title?: string;
  description?: string;
}

const {
  title = 'TidyHome - Reparto Flexible de Tareas del Hogar',
  description = 'Organiza y reparte las tareas del hogar entre convivientes con flexibilidad y sincronización en tiempo real.',
} = Astro.props;
---

<!doctype html>
<html lang="es" class="dark">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no, viewport-fit=cover" />
    <title>{title}</title>
    <meta name="description" content={description} />
    
    <!-- PWA & Mobile Icons -->
    <link rel="icon" type="image/svg+xml" href="/icon.svg" />
    <link rel="manifest" href="/manifest.webmanifest" />
    <meta name="theme-color" content="#0b0f19" />
    <meta name="mobile-web-app-capable" content="yes" />
    <meta name="apple-mobile-web-app-status-bar-style" content="black-translucent" />
    <meta name="apple-mobile-web-app-title" content="TidyHome" />
    <link rel="apple-touch-icon" href="/icon.svg" />

    <!-- Google Fonts: Plus Jakarta Sans -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800&display=swap" rel="stylesheet" />

    <!-- Canvas Confetti CDN for completions -->
    <script src="https://cdn.jsdelivr.net/npm/canvas-confetti@1.9.3/dist/confetti.browser.min.js" defer></script>
  </head>
  <body class="bg-[#0b0f19] text-slate-100 min-h-screen flex flex-col font-sans selection:bg-indigo-500 selection:text-white pb-24 sm:pb-20">
    
    <!-- Top Header -->
    <header class="sticky top-0 z-40 glass-header px-4 py-3 sm:px-6">
      <div class="max-w-4xl mx-auto flex items-center justify-between gap-3">
        <!-- Logo -->
        <div class="flex items-center gap-2.5">
          <div class="w-10 h-10 rounded-xl bg-gradient-to-tr from-indigo-600 via-purple-600 to-pink-500 flex items-center justify-center shadow-lg shadow-indigo-500/25 ring-1 ring-white/20">
            <span class="text-xl">🏠</span>
          </div>
          <div>
            <div class="flex items-center gap-2">
              <span class="font-extrabold text-lg sm:text-xl tracking-tight bg-gradient-to-r from-white via-indigo-100 to-indigo-300 bg-clip-text text-transparent">
                TidyHome
              </span>
              <span class="px-1.5 py-0.5 text-[10px] font-semibold bg-indigo-500/20 text-indigo-300 rounded border border-indigo-500/30">
                PWA
              </span>
            </div>
            <p class="text-[11px] text-slate-400 font-medium">Reparto de tareas</p>
          </div>
        </div>

        <!-- Active User Selector & Quick Sync -->
        <div class="flex items-center gap-2">
          <!-- Quick Sync Button -->
          <button
            id="btn-sync-all"
            title="Sincronizar tareas de la semana"
            class="p-2 rounded-xl bg-slate-800/80 hover:bg-slate-700/80 text-slate-300 hover:text-white border border-slate-700/60 transition active:scale-95 flex items-center justify-center"
          >
            <svg id="sync-icon" class="w-4 h-4 transition-transform duration-700" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 4v5h.582m15.356 2A8.001 8.001 0 004.582 9m0 0H9m11 11v-5h-.581m0 0a8.003 8.003 0 01-15.357-2m15.357 2H15" />
            </svg>
          </button>

          <!-- User Selector Dropdown -->
          <div class="relative" id="user-selector-container">
            <button
              id="user-selector-btn"
              class="flex items-center gap-2 px-3 py-1.5 rounded-xl bg-slate-800/90 hover:bg-slate-700/90 border border-slate-700/70 transition shadow-sm active:scale-95"
            >
              <span id="active-user-avatar" class="text-lg">👤</span>
              <div class="text-left hidden xs:block">
                <span class="text-[10px] uppercase font-bold text-slate-400 block leading-none">Activo</span>
                <span id="active-user-name" class="text-xs font-semibold text-white leading-tight">Cargando...</span>
              </div>
              <svg class="w-3.5 h-3.5 text-slate-400" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7" />
              </svg>
            </button>

            <!-- Dropdown Menu -->
            <div
              id="user-dropdown-menu"
              class="hidden absolute right-0 mt-2 w-56 glass-card rounded-2xl shadow-2xl z-50 p-2 border border-slate-700/80 divide-y divide-slate-800"
            >
              <div class="px-2 py-1.5 text-[11px] font-semibold text-slate-400 uppercase tracking-wider">
                Cambiar de Conviviente
              </div>
              <div id="user-dropdown-list" class="py-1 space-y-1">
                <!-- Injected via JavaScript -->
              </div>
              <div class="pt-1.5">
                <button
                  id="btn-open-new-user-from-dropdown"
                  class="w-full flex items-center gap-2 px-2.5 py-1.5 rounded-lg text-xs font-medium text-indigo-400 hover:bg-indigo-500/10 transition"
                >
                  <span>➕</span> Dar de alta conviviente
                </button>
              </div>
            </div>
          </div>
        </div>
      </div>
    </header>

    <!-- Main Content Slot -->
    <main class="flex-1 max-w-4xl w-full mx-auto px-4 py-4 sm:px-6">
      <slot />
    </main>

    <!-- Bottom Navigation Bar (Mobile First) -->
    <nav class="fixed bottom-0 left-0 right-0 z-40 glass-nav px-2 py-2 sm:py-2.5">
      <div class="max-w-md mx-auto grid grid-cols-4 gap-1">
        <!-- Tab 1: Mi Panel -->
        <button
          id="nav-tab-panel"
          data-tab="panel"
          class="nav-tab flex flex-col items-center justify-center py-1.5 px-1 rounded-xl text-indigo-400 transition group active:scale-95"
        >
          <div class="nav-icon-container relative p-1 rounded-lg group-hover:bg-slate-800/50 transition">
            <svg class="w-5 h-5 transition-transform group-hover:scale-110" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5H7a2 2 0 00-2 2v12a2 2 0 002 2h10a2 2 0 002-2V7a2 2 0 00-2-2h-2M9 5a2 2 0 002 2h2a2 2 0 002-2M9 5a2 2 0 012-2h2a2 2 0 012 2m-6 9l2 2 4-4" />
            </svg>
            <span id="badge-my-pending" class="hidden absolute -top-1 -right-1 w-4 h-4 bg-pink-500 text-white text-[9px] font-bold rounded-full flex items-center justify-center">0</span>
          </div>
          <span class="text-[11px] font-semibold tracking-tight mt-0.5">Mi Panel</span>
        </button>

        <!-- Tab 2: Casa / Dashboard -->
        <button
          id="nav-tab-dashboard"
          data-tab="dashboard"
          class="nav-tab flex flex-col items-center justify-center py-1.5 px-1 rounded-xl text-slate-400 hover:text-slate-200 transition group active:scale-95"
        >
          <div class="nav-icon-container relative p-1 rounded-lg group-hover:bg-slate-800/50 transition">
            <svg class="w-5 h-5 transition-transform group-hover:scale-110" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 12l2-2m0 0l7-7 7 7M5 10v10a1 1 0 001 1h3m10-11l2 2m-2-2v10a1 1 0 01-1 1h-3m-6 0a1 1 0 001-1v-4a1 1 0 011-1h2a1 1 0 011 1v4a1 1 0 001 1m-6 0h6" />
            </svg>
          </div>
          <span class="text-[11px] font-semibold tracking-tight mt-0.5">Casa</span>
        </button>

        <!-- Tab 3: Catálogo -->
        <button
          id="nav-tab-catalog"
          data-tab="catalog"
          class="nav-tab flex flex-col items-center justify-center py-1.5 px-1 rounded-xl text-slate-400 hover:text-slate-200 transition group active:scale-95"
        >
          <div class="nav-icon-container relative p-1 rounded-lg group-hover:bg-slate-800/50 transition">
            <svg class="w-5 h-5 transition-transform group-hover:scale-110" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 11H5m14 0a2 2 0 012 2v6a2 2 0 01-2 2H5a2 2 0 01-2-2v-6a2 2 0 012-2m14 0V9a2 2 0 00-2-2M5 11V9a2 2 0 012-2m0 0V5a2 2 0 012-2h6a2 2 0 012 2v2M7 7h10" />
            </svg>
          </div>
          <span class="text-[11px] font-semibold tracking-tight mt-0.5">Catálogo</span>
        </button>

        <!-- Tab 4: Convivientes -->
        <button
          id="nav-tab-roommates"
          data-tab="roommates"
          class="nav-tab flex flex-col items-center justify-center py-1.5 px-1 rounded-xl text-slate-400 hover:text-slate-200 transition group active:scale-95"
        >
          <div class="nav-icon-container relative p-1 rounded-lg group-hover:bg-slate-800/50 transition">
            <svg class="w-5 h-5 transition-transform group-hover:scale-110" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 20h5v-2a3 3 0 00-5.356-1.857M17 20H7m10 0v-2c0-.656-.126-1.283-.356-1.857M7 20H2v-2a3 3 0 015.356-1.857M7 20v-2c0-.656.126-1.283.356-1.857m0 0a5.002 5.002 0 019.288 0M15 7a3 3 0 11-6 0 3 3 0 016 0zm6 3a2 2 0 11-4 0 2 2 0 014 0zM7 10a2 2 0 11-4 0 2 2 0 014 0z" />
            </svg>
          </div>
          <span class="text-[11px] font-semibold tracking-tight mt-0.5">Convivientes</span>
        </button>
      </div>
    </nav>

    <!-- Global Toast Container -->
    <div id="toast-container" class="fixed top-20 right-4 left-4 sm:left-auto sm:w-96 z-50 pointer-events-none flex flex-col gap-2"></div>

    <!-- PWA Service Worker Registration -->
    <script is:inline>
      if ('serviceWorker' in navigator) {
        window.addEventListener('load', () => {
          navigator.serviceWorker.register('/sw.js').catch((err) => {
            console.warn('Service worker registration failed:', err);
          });
        });
      }
    </script>
  </body>
</html>
