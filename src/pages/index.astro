    if (!dashboardData) {
      const res = await fetch('/api/chores/dashboard');
      dashboardData = await res.json();
    }

    if (!dashboardData) return;

    const stats = dashboardData.userStats || [];

    // Render Roommates Cards
    if (usersList.length === 0) {
      cardsEl.innerHTML = `
        <div class="col-span-full glass-card rounded-2xl p-6 text-center space-y-2">
          <div class="text-3xl">👥</div>
          <h4 class="text-sm font-bold text-white">No hay convivientes dados de alta</h4>
          <p class="text-xs text-slate-400">Pulsa "+ Añadir Conviviente" para agregar al primer miembro de la casa.</p>
        </div>
      `;
