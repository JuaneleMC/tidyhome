  const COMMON_SHOPPING_UNITS_LIST = [
    'ud', 'pack 6L', 'garrafa 5L', '100gr', '250gr', '500gr', '1 kg',
    'botella', 'pack 6 latas', 'barra', 'docena', 'bote', 'paquete', 'caja', 'rollo'
  ];

  let shoppingCatalogList: any[] = [];
  let shoppingSubtab: 'list' | 'catalog' = 'list';
  let catalogCategoryFilter: string = 'all';
  let catalogSearchQuery: string = '';

  // Control de sub-pestañas: Lista de la compra vs Artículos en uso
  function setShoppingSubtab(subtab: 'list' | 'catalog') {
    shoppingSubtab = subtab;
    const btnList = document.getElementById('shopping-subtab-btn-list');
    const btnCatalog = document.getElementById('shopping-subtab-btn-catalog');
    const panelList = document.getElementById('shopping-panel-list');
    const panelCatalog = document.getElementById('shopping-panel-catalog');
    const fabBtn = document.getElementById('btn-shopping-fab-add');

    if (subtab === 'list') {
      btnList?.classList.add('bg-emerald-600', 'text-white', 'font-bold');
      btnList?.classList.remove('text-slate-400');
      btnCatalog?.classList.remove('bg-emerald-600', 'text-white', 'font-bold');
      btnCatalog?.classList.add('text-slate-400');
      panelList?.classList.remove('hidden');
      panelCatalog?.classList.add('hidden');
      fabBtn?.classList.remove('hidden');
      loadShoppingList();
    } else {
      btnCatalog?.classList.add('bg-emerald-600', 'text-white', 'font-bold');
      btnCatalog?.classList.remove('text-slate-400');
      btnList?.classList.remove('bg-emerald-600', 'text-white', 'font-bold');
      btnList?.classList.add('text-slate-400');
      panelCatalog?.classList.remove('hidden');
      panelList?.classList.add('hidden');
      fabBtn?.classList.add('hidden');
      loadShoppingCatalog();
    }
