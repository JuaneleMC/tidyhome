  function setGarageSubtab(subtab: 'maint' | 'incidents' | 'history') {
    garageSubtab = subtab;
    const btnMaint = document.getElementById('garage-subtab-btn-maint');
    const btnInc = document.getElementById('garage-subtab-btn-incidents');
    const btnHist = document.getElementById('garage-subtab-btn-history');

    const panelMaint = document.getElementById('garage-panel-maint');
    const panelInc = document.getElementById('garage-panel-incidents');
    const panelHist = document.getElementById('garage-panel-history');

    [btnMaint, btnInc, btnHist].forEach((b) => {
      b?.classList.remove('bg-indigo-600', 'text-white', 'font-bold');
      b?.classList.add('text-slate-400');
    });

    [panelMaint, panelInc, panelHist].forEach((p) => p?.classList.add('hidden'));

    if (subtab === 'maint') {
      btnMaint?.classList.add('bg-indigo-600', 'text-white', 'font-bold');
      btnMaint?.classList.remove('text-slate-400');
      panelMaint?.classList.remove('hidden');
    } else if (subtab === 'incidents') {
      btnInc?.classList.add('bg-indigo-600', 'text-white', 'font-bold');
      btnInc?.classList.remove('text-slate-400');
      panelInc?.classList.remove('hidden');
    } else if (subtab === 'history') {
      btnHist?.classList.add('bg-indigo-600', 'text-white', 'font-bold');
      btnHist?.classList.remove('text-slate-400');
      panelHist?.classList.remove('hidden');
    }
  }

  function renderGarageSubpanels(v: any) {
    // 1. Mantenimientos
    const maintContainer = document.getElementById('garage-maint-list');
    if (maintContainer) {
      if (!v.maintenance || v.maintenance.length === 0) {
        maintContainer.innerHTML = `
          <div class="glass-card rounded-2xl p-6 text-center space-y-2">
            <div class="text-2xl">🔧</div>
            <p class="text-xs text-slate-400">Sin tareas de mantenimiento configuradas para este vehículo.</p>
            <button type="button" class="btn-inner-add-maint text-xs text-indigo-400 font-bold hover:underline">+ Añadir primer mantenimiento</button>
          </div>
        `;
        maintContainer.querySelector('.btn-inner-add-maint')?.addEventListener('click', () => openNewMaintModal());
      } else {
        const sortedMaintenance = [...(v.maintenance || [])].sort((a: any, b: any) => {
          const aOverdue = a.status === 'overdue';
          const bOverdue = b.status === 'overdue';
          if (aOverdue && !bOverdue) return -1;
          if (!aOverdue && bOverdue) return 1;

          const getUrgency = (item: any) => {
            const candidates: number[] = [];
            if (item.remainingDays !== null && item.remainingDays !== undefined) {
              candidates.push(item.remainingDays);
            }
            if (item.remainingKm !== null && item.remainingKm !== undefined) {
              candidates.push(item.remainingKm / 40);
            }
            if (candidates.length === 0) return Infinity;
            return Math.min(...candidates);
          };

          const aScore = getUrgency(a);
          const bScore = getUrgency(b);
          if (aScore !== bScore) return aScore - bScore;

          return (a.name || '').localeCompare(b.name || '', 'es', { sensitivity: 'base' });
        });

        maintContainer.innerHTML = sortedMaintenance.map((m: any) => {
          const isOverdue = m.status === 'overdue';
          const isSoon = m.status === 'soon';

          let statusBadge = '';
          if (isOverdue) {
            statusBadge = '<span class="px-2 py-0.5 rounded-full text-[10px] font-bold bg-rose-500 text-white shadow-xs">⚠️ Vencida</span>';
          } else if (isSoon) {
            statusBadge = '<span class="px-2 py-0.5 rounded-full text-[10px] font-bold bg-amber-500 text-slate-900 shadow-xs">⏳ Próxima</span>';
          } else {
            statusBadge = '<span class="px-2 py-0.5 rounded-full text-[10px] font-bold bg-emerald-500/20 text-emerald-400 border border-emerald-500/30">✓ Al día</span>';
          }

          let remainingText = '';
          if (m.remainingKm !== null && m.remainingKm !== undefined) {
            if (m.remainingKm <= 0) {
              remainingText += `<span class="${isOverdue ? 'text-rose-700 font-extrabold' : 'text-rose-600 font-bold'}">Excedida en ${Math.abs(m.remainingKm).toLocaleString('es-ES')} km</span>`;
            } else {
              remainingText += `Faltan ${m.remainingKm.toLocaleString('es-ES')} km`;
            }
          }
          if (m.remainingDays !== null && m.remainingDays !== undefined) {
            if (remainingText) remainingText += ' · ';
            if (m.remainingDays <= 0) {
              remainingText += `<span class="${isOverdue ? 'text-rose-700 font-extrabold' : 'text-rose-600 font-bold'}">Excedida en ${Math.abs(m.remainingDays)} días</span>`;
            } else {
              remainingText += `Faltan ${m.remainingDays} días (${m.nextDueDate})`;
            }
          }

          let intervalsText = '';
          if (m.intervalKm) intervalsText += `Cada ${m.intervalKm.toLocaleString('es-ES')} km`;
          if (m.intervalMonths) {
            if (intervalsText) intervalsText += ' o ';
            intervalsText += `cada ${m.intervalMonths} meses`;
          }

          return `
            <div class="glass-card rounded-2xl p-3 border transition ${
              isOverdue
                ? 'card-overdue border-rose-300'
                : isSoon
                ? 'border-amber-400/80 bg-amber-50/60'
                : 'border-slate-700/60'
            }">
              <div class="flex items-start justify-between gap-2.5">
                <div class="flex-1 min-w-0">
                  <div class="flex items-start gap-1.5 flex-wrap">
                    <h4 class="text-xs sm:text-sm font-bold break-words leading-tight ${isOverdue ? 'text-rose-950 font-extrabold' : 'text-white'}">${escHtml(m.name)}</h4>
                    <span class="shrink-0">${statusBadge}</span>
                  </div>
                  <div class="text-[11px] leading-tight mt-1 flex items-center gap-1.5 flex-wrap">
                    <span class="${isOverdue ? 'text-rose-800 font-bold' : 'text-indigo-600 font-semibold'}">${remainingText || 'Al día'}</span>
                    <span class="text-slate-400 text-[10px]">(${intervalsText || 'Sin periodicidad'})</span>
                  </div>
                  <div class="text-[10px] leading-tight mt-0.5 ${isOverdue ? 'text-rose-900/70 font-medium' : 'text-slate-400'}">
                    Última vez: ${m.lastDoneDate || 'Nunca registrada'} ${m.lastDoneKm ? `(${m.lastDoneKm.toLocaleString('es-ES')} km)` : ''}
                  </div>
                </div>

                <div class="flex flex-col items-end gap-1 shrink-0">
                  <button
                    type="button"
                    class="btn-maint-execute px-2.5 py-1 rounded-lg bg-indigo-600 hover:bg-indigo-500 text-white text-xs font-bold shadow-xs transition active:scale-95"
                    data-id="${m.id}"
                    data-name="${escHtml(m.name)}"
                  >
                    ✓ Registrar
                  </button>
                  <div class="flex items-center gap-0.5">
                    <button
                      type="button"
                      class="btn-maint-edit p-1 text-slate-400 hover:text-indigo-400 transition text-xs"
                      data-id="${m.id}"
                      title="Editar regla"
                    >
                      ✏️
                    </button>
                    <button
                      type="button"
                      class="btn-maint-delete p-1 text-slate-400 hover:text-rose-400 transition text-xs"
                      data-id="${m.id}"
                      data-name="${escHtml(m.name)}"
                      title="Eliminar regla"
                    >
                      🗑️
                    </button>
                  </div>
                </div>
              </div>
            </div>
          `;
        }).join('');

        maintContainer.querySelectorAll('.btn-maint-execute').forEach((btn) => {
          btn.addEventListener('click', () => {
            const id = Number(btn.getAttribute('data-id'));
            const name = btn.getAttribute('data-name') || 'Mantenimiento';
            openExecuteMaintModal(id, name);
          });
        });

        maintContainer.querySelectorAll('.btn-maint-edit').forEach((btn) => {
          btn.addEventListener('click', () => {
            const id = Number(btn.getAttribute('data-id'));
            openNewMaintModal(id);
          });
        });

        maintContainer.querySelectorAll('.btn-maint-delete').forEach((btn) => {
          btn.addEventListener('click', async () => {
            const id = Number(btn.getAttribute('data-id'));
            const name = btn.getAttribute('data-name');
            if (confirm(`¿Eliminar la tarea "${name}" de este vehículo?`)) {
              await fetch(`/api/garage/maintenance/${id}`, { method: 'DELETE' });
              showToast('Tarea eliminada', 'info');
              loadGarage();
            }
          });
        });
      }
    }

    // 2. Incidencias
    const incContainer = document.getElementById('garage-incidents-list');
    if (incContainer) {
      const openIncidents = (v.incidents || []).filter((i: any) => i.status === 'open');
      if (openIncidents.length === 0) {
        incContainer.innerHTML = `
          <div class="glass-card rounded-2xl p-6 text-center space-y-2">
            <div class="text-2xl">✅</div>
            <p class="text-xs text-slate-400">Sin incidencias ni averías activas en este vehículo.</p>
          </div>
        `;
      } else {
        incContainer.innerHTML = openIncidents.map((inc: any) => `
          <div class="glass-card rounded-2xl p-3 border border-amber-300/80 bg-amber-50/70 space-y-1.5">
            <div class="flex items-start justify-between gap-2.5">
              <div class="flex-1 min-w-0">
                <div class="flex items-start gap-1.5 flex-wrap">
                  <span class="text-sm shrink-0">⚠️</span>
                  <h4 class="text-xs sm:text-sm font-bold text-amber-950 break-words leading-tight">${escHtml(inc.title)}</h4>
                </div>
                ${inc.description ? `<p class="text-xs text-slate-600 mt-1 break-words leading-tight">${escHtml(inc.description)}</p>` : ''}
                <div class="text-[10px] text-slate-500 mt-0.5 flex items-center gap-2">
                  <span>Reportado: ${inc.reportedDate}</span>
                  ${inc.reportedByName ? `<span>por ${escHtml(inc.reportedByName)}</span>` : ''}
                </div>
              </div>

              <button
                type="button"
                class="btn-resolve-incident px-2.5 py-1 rounded-lg bg-emerald-600 hover:bg-emerald-500 text-white text-xs font-bold shadow-xs transition active:scale-95 shrink-0"
                data-id="${inc.id}"
                data-title="${escHtml(inc.title)}"
              >
                ✓ Resolver
              </button>
            </div>
          </div>
        `).join('');

        incContainer.querySelectorAll('.btn-resolve-incident').forEach((btn) => {
          btn.addEventListener('click', () => {
            const id = Number(btn.getAttribute('data-id'));
            const title = btn.getAttribute('data-title') || '';
            openResolveIncidentModal(id, title);
          });
        });
      }
    }

    // 3. Historial (Libro de revisiones)
    const histContainer = document.getElementById('garage-history-list');
    if (histContainer) {
      if (!v.logs || v.logs.length === 0) {
        histContainer.innerHTML = `
          <div class="glass-card rounded-2xl p-6 text-center space-y-2">
            <div class="text-2xl">📖</div>
            <p class="text-xs text-slate-400">Aún no hay registros en el libro de revisiones de este vehículo.</p>
          </div>
        `;
      } else {
        histContainer.innerHTML = v.logs.map((l: any) => `
          <div class="glass-card rounded-2xl p-3 border border-slate-700/60 text-xs space-y-1">
            <div class="flex items-center justify-between gap-2">
              <span class="font-bold text-white truncate">${escHtml(l.title)}</span>
              <span class="text-[10px] font-semibold text-slate-400 shrink-0">${l.performedDate}</span>
            </div>
            <div class="flex items-center gap-2 text-[11px] text-slate-400 flex-wrap">
              ${l.performedKm ? `<span class="text-blue-300 font-mono font-bold">${l.performedKm.toLocaleString('es-ES')} km</span>` : ''}
              ${l.workshop ? `<span class="bg-slate-800 px-1.5 py-0.2 rounded text-slate-300">🏢 ${escHtml(l.workshop)}</span>` : ''}
              ${l.cost ? `<span class="bg-emerald-500/15 text-emerald-300 px-1.5 py-0.2 rounded font-bold">${escHtml(l.cost)}</span>` : ''}
              ${l.performedByName ? `<span>por ${escHtml(l.performedByName)}</span>` : ''}
            </div>
            ${l.notes ? `<p class="text-[11px] text-slate-400 italic pt-0.5">${escHtml(l.notes)}</p>` : ''}
          </div>
        `).join('');
      }
    }
  }

  // Modals for Garage
  function openUpdateKmModal() {
    const v = garageData.find((item) => item.id === activeVehicleId);
    if (!v) return;

    const modal = document.getElementById('modal-update-km');
    const nameEl = document.getElementById('modal-km-vehicle-name');
    const inputKm = document.getElementById('input-new-km') as HTMLInputElement;
    const inputDate = document.getElementById('input-date-km') as HTMLInputElement;

    if (nameEl) nameEl.textContent = `${v.name} ${v.plate ? `(${v.plate})` : ''}`;
    if (inputKm) inputKm.value = String(v.currentKm || 0);
    if (inputDate) inputDate.value = new Date().toISOString().split('T')[0];

    modal?.classList.remove('hidden');
    modal?.classList.add('flex');
  }

  function closeUpdateKmModal() {
    const modal = document.getElementById('modal-update-km');
    modal?.classList.add('hidden');
    modal?.classList.remove('flex');
  }

  function openExecuteMaintModal(maintId: number, name: string) {
    const v = garageData.find((item) => item.id === activeVehicleId);
    const modal = document.getElementById('modal-execute-maintenance');
    const inputId = document.getElementById('input-exec-maint-id') as HTMLInputElement;
    const titleEl = document.getElementById('modal-exec-maint-name');
    const inputDate = document.getElementById('input-exec-date') as HTMLInputElement;
    const inputKm = document.getElementById('input-exec-km') as HTMLInputElement;
    const selectUser = document.getElementById('select-exec-user') as HTMLSelectElement;

    if (inputId) inputId.value = String(maintId);
    if (titleEl) titleEl.textContent = name;
    if (inputDate) inputDate.value = new Date().toISOString().split('T')[0];
    if (inputKm) inputKm.value = v && v.hasMileage ? String(v.currentKm || 0) : '';

    if (selectUser) {
      selectUser.innerHTML = usersList.map((u) => `
        <option value="${u.id}" ${activeUser?.id === u.id ? 'selected' : ''}>${escHtml(u.avatar || '👤')} ${escHtml(u.name)}</option>
      `).join('');
    }

    modal?.classList.remove('hidden');
    modal?.classList.add('flex');
  }

  function closeExecuteMaintModal() {
    const modal = document.getElementById('modal-execute-maintenance');
    modal?.classList.add('hidden');
    modal?.classList.remove('flex');
  }

  function openNewMaintModal(maintId?: number) {
    const modal = document.getElementById('modal-new-maintenance');
    const titleEl = document.getElementById('modal-maint-rule-title');
    const inputId = document.getElementById('input-maint-rule-id') as HTMLInputElement;
    const inputName = document.getElementById('input-maint-name') as HTMLInputElement;
    const inputKm = document.getElementById('input-maint-interval-km') as HTMLInputElement;
    const inputMonths = document.getElementById('input-maint-interval-months') as HTMLInputElement;
    const inputLastKm = document.getElementById('input-maint-last-km') as HTMLInputElement;
    const inputLastDate = document.getElementById('input-maint-last-date') as HTMLInputElement;

    const v = garageData.find((item) => item.id === activeVehicleId);

    if (maintId && v) {
      const item = (v.maintenance || []).find((m: any) => m.id === maintId);
      if (item) {
        if (titleEl) titleEl.textContent = 'Editar Mantenimiento';
        if (inputId) inputId.value = String(item.id);
        if (inputName) inputName.value = item.name || '';
        if (inputKm) inputKm.value = item.intervalKm ? String(item.intervalKm) : '';
        if (inputMonths) inputMonths.value = item.intervalMonths ? String(item.intervalMonths) : '';
        if (inputLastKm) inputLastKm.value = item.lastDoneKm ? String(item.lastDoneKm) : '';
        if (inputLastDate) inputLastDate.value = item.lastDoneDate || '';
      }
    } else {
      if (titleEl) titleEl.textContent = 'Nuevo Mantenimiento';
      if (inputId) inputId.value = '';
      if (inputName) inputName.value = '';
      if (inputKm) inputKm.value = '';
      if (inputMonths) inputMonths.value = '';
      if (inputLastKm) inputLastKm.value = '';
      if (inputLastDate) inputLastDate.value = '';
    }

    modal?.classList.remove('hidden');
    modal?.classList.add('flex');
  }

  function closeNewMaintModal() {
    const modal = document.getElementById('modal-new-maintenance');
    modal?.classList.add('hidden');
    modal?.classList.remove('flex');
  }

  function openNewIncidentModal() {
    const modal = document.getElementById('modal-new-incident');
    const selectUser = document.getElementById('select-incident-user') as HTMLSelectElement;
    const inputDate = document.getElementById('input-incident-date') as HTMLInputElement;
    const form = document.getElementById('form-new-incident') as HTMLFormElement;

    form?.reset();
    if (inputDate) inputDate.value = new Date().toISOString().split('T')[0];
    if (selectUser) {
      selectUser.innerHTML = usersList.map((u) => `
        <option value="${u.id}" ${activeUser?.id === u.id ? 'selected' : ''}>${escHtml(u.avatar || '👤')} ${escHtml(u.name)}</option>
      `).join('');
    }

    modal?.classList.remove('hidden');
    modal?.classList.add('flex');
  }

  function closeNewIncidentModal() {
    const modal = document.getElementById('modal-new-incident');
    modal?.classList.add('hidden');
    modal?.classList.remove('flex');
  }

  function openResolveIncidentModal(incidentId: number, title: string) {
    const modal = document.getElementById('modal-resolve-incident');
    const inputId = document.getElementById('input-resolve-incident-id') as HTMLInputElement;
    const titleEl = document.getElementById('resolve-incident-title-text');
    const inputDate = document.getElementById('input-resolve-date') as HTMLInputElement;
    const form = document.getElementById('form-resolve-incident') as HTMLFormElement;

    form?.reset();
    if (inputId) inputId.value = String(incidentId);
    if (titleEl) titleEl.textContent = title;
    if (inputDate) inputDate.value = new Date().toISOString().split('T')[0];

    modal?.classList.remove('hidden');
    modal?.classList.add('flex');
  }

  function closeResolveIncidentModal() {
    const modal = document.getElementById('modal-resolve-incident');
    modal?.classList.add('hidden');
    modal?.classList.remove('flex');
  }

  function openNewVehicleModal() {
    const modal = document.getElementById('modal-new-vehicle');
    const form = document.getElementById('form-new-vehicle') as HTMLFormElement;
    form?.reset();
    modal?.classList.remove('hidden');
    modal?.classList.add('flex');
  }

  function closeNewVehicleModal() {
    const modal = document.getElementById('modal-new-vehicle');
    modal?.classList.add('hidden');
    modal?.classList.remove('flex');
  }

  // ==========================================
  // EVENT LISTENERS & INITIALIZATION
  // ==========================================
  document.addEventListener('DOMContentLoaded', async () => {
    // 1. Initial Load
    await loadUsers();
    await loadCalendar();
    await loadGarage();
    await loadShoppingList();

    // Calendario: navegación de mes y cierre del desglose
    const shiftMonth = (delta: number) => {
      const d = new Date(calYear, calMonth - 1 + delta, 1);
      calYear = d.getFullYear();
      calMonth = d.getMonth() + 1;
      loadCalendar();
    };
    document.getElementById('btn-cal-prev')?.addEventListener('click', () => shiftMonth(-1));
    document.getElementById('btn-cal-next')?.addEventListener('click', () => shiftMonth(1));
    document.getElementById('btn-cal-today')?.addEventListener('click', () => {
      calYear = new Date().getFullYear();
      calMonth = new Date().getMonth() + 1;
      loadCalendar();
    });
    const calModal = document.getElementById('cal-day-modal');
    document.getElementById('btn-cal-day-close')?.addEventListener('click', () => calModal?.classList.add('hidden'));
    calModal?.addEventListener('click', (e) => {
      if (e.target === calModal) calModal.classList.add('hidden');
    });

    // 2. Navigation Tabs
    document.querySelectorAll('.nav-tab').forEach((tabBtn) => {
      tabBtn.addEventListener('click', () => {
        const tab = tabBtn.getAttribute('data-tab') as any;
        if (tab) switchTab(tab);
      });
    });

    // 3. User Selector Dropdown Toggle
    const userBtn = document.getElementById('user-selector-btn');
    const userMenu = document.getElementById('user-dropdown-menu');

    userBtn?.addEventListener('click', (e) => {
      e.stopPropagation();
      userMenu?.classList.toggle('hidden');
    });

    document.addEventListener('click', () => {
      userMenu?.classList.add('hidden');
    });

    // 4. Global Sync Button
    document.getElementById('btn-sync-all')?.addEventListener('click', () => {
      syncWeek();
    });

    // Modal registrar tarea hecha
    document.getElementById('btn-close-log-chore')?.addEventListener('click', closeLogChoreModal);
    document.getElementById('btn-cancel-log-chore')?.addEventListener('click', closeLogChoreModal);
    document.getElementById('btn-confirm-log-chore')?.addEventListener('click', confirmLogChore);
    document.getElementById('log-mode-existing')?.addEventListener('click', () => setLogMode('existing'));
    document.getElementById('log-mode-new')?.addEventListener('click', () => setLogMode('new'));
    document.getElementById('log-chore-search')?.addEventListener('input', renderLogChoreList);

    // 6. Dashboard Grouping Toggle (Por Día vs Por Conviviente)
    const btnGroupDay = document.getElementById('btn-group-by-day');
    const btnGroupUser = document.getElementById('btn-group-by-user');

    btnGroupDay?.addEventListener('click', () => {
      dashboardGroupBy = 'day';
      btnGroupDay.classList.add('bg-indigo-600', 'text-white');
      btnGroupDay.classList.remove('text-slate-400');
      btnGroupUser?.classList.remove('bg-indigo-600', 'text-white');
      btnGroupUser?.classList.add('text-slate-400');
      renderDashboardGroups();
    });

    btnGroupUser?.addEventListener('click', () => {
      dashboardGroupBy = 'user';
      btnGroupUser.classList.add('bg-indigo-600', 'text-white');
      btnGroupUser.classList.remove('text-slate-400');
      btnGroupDay?.classList.remove('bg-indigo-600', 'text-white');
      btnGroupDay?.classList.add('text-slate-400');
      renderDashboardGroups();
    });

    // 7. Dashboard Status Filter
    document.getElementById('filter-dashboard-status')?.addEventListener('change', (e) => {
      dashboardFilterStatus = (e.target as HTMLSelectElement).value as any;
      renderDashboardGroups();
    });

    // 8. Catalog Frequency Filter Pills
    document.querySelectorAll('.catalog-filter-btn').forEach((btn) => {
      btn.addEventListener('click', () => {
        const freq = btn.getAttribute('data-freq') || 'all';
        catalogFilterFreq = freq;

        document.querySelectorAll('.catalog-filter-btn').forEach((b) => {
          b.classList.remove('bg-indigo-600', 'text-white');
          b.classList.add('bg-slate-800', 'text-slate-300');
        });

        btn.classList.add('bg-indigo-600', 'text-white');
        btn.classList.remove('bg-slate-800', 'text-slate-300');

        renderCatalog();
      });
    });

    // 9. Quick Emoji Pickers in Modals
    document.querySelectorAll('.quick-emoji').forEach((btn) => {
      btn.addEventListener('click', () => {
        const emoji = btn.textContent || '🧹';
        const input = document.getElementById('input-chore-icon') as HTMLInputElement;
        if (input) input.value = emoji.trim();
      });
    });

    document.querySelectorAll('.quick-avatar').forEach((btn) => {
      btn.addEventListener('click', () => {
        const avatar = btn.textContent || '👤';
        const input = document.getElementById('input-user-avatar') as HTMLInputElement;
        if (input) input.value = avatar.trim();
      });
    });

    
    // Switcher de vista Calendario: Mes vs Semana
    document.getElementById('btn-cal-tab-month')?.addEventListener('click', () => setCalendarViewMode('month'));
    document.getElementById('btn-cal-tab-week')?.addEventListener('click', () => setCalendarViewMode('week'));

    // Subtabs de Garaje
    document.getElementById('garage-subtab-btn-maint')?.addEventListener('click', () => setGarageSubtab('maint'));
    document.getElementById('garage-subtab-btn-incidents')?.addEventListener('click', () => setGarageSubtab('incidents'));
    document.getElementById('garage-subtab-btn-history')?.addEventListener('click', () => setGarageSubtab('history'));

    // Modales de Garaje
    document.getElementById('btn-close-chore-history')?.addEventListener('click', closeChoreHistoryModal);
    document.getElementById('btn-done-chore-history')?.addEventListener('click', closeChoreHistoryModal);

    document.getElementById('btn-close-update-km')?.addEventListener('click', closeUpdateKmModal);
    document.getElementById('btn-cancel-update-km')?.addEventListener('click', closeUpdateKmModal);

    document.getElementById('btn-close-exec-maint')?.addEventListener('click', closeExecuteMaintModal);
    document.getElementById('btn-cancel-exec-maint')?.addEventListener('click', closeExecuteMaintModal);

    document.getElementById('btn-open-new-maint-modal')?.addEventListener('click', () => openNewMaintModal());
    document.getElementById('btn-close-new-maint')?.addEventListener('click', closeNewMaintModal);
    document.getElementById('btn-cancel-new-maint')?.addEventListener('click', closeNewMaintModal);

    document.getElementById('btn-open-new-incident-modal')?.addEventListener('click', openNewIncidentModal);
    document.getElementById('btn-close-new-incident')?.addEventListener('click', closeNewIncidentModal);
    document.getElementById('btn-cancel-new-incident')?.addEventListener('click', closeNewIncidentModal);

    document.getElementById('btn-close-resolve-incident')?.addEventListener('click', closeResolveIncidentModal);
    document.getElementById('btn-cancel-resolve-incident')?.addEventListener('click', closeResolveIncidentModal);

    document.getElementById('btn-open-new-vehicle-modal')?.addEventListener('click', openNewVehicleModal);
    document.getElementById('btn-close-new-vehicle')?.addEventListener('click', closeNewVehicleModal);
    document.getElementById('btn-cancel-new-vehicle')?.addEventListener('click', closeNewVehicleModal);

    // Form Update Km
    document.getElementById('form-update-km')?.addEventListener('submit', async (e) => {
      e.preventDefault();
      const km = (document.getElementById('input-new-km') as HTMLInputElement).value;
      const date = (document.getElementById('input-date-km') as HTMLInputElement).value;
      try {
        const res = await fetch('/api/garage/km', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ vehicleId: activeVehicleId, km: Number(km), date, userId: activeUser?.id }),
        });
        const data = await res.json();
        if (data.success) {
          triggerConfetti();
          showToast('Kilometraje actualizado correctamente', 'success');
          closeUpdateKmModal();
          await loadGarage();
        } else {
          showToast(data.error || 'Error al actualizar km', 'error');
        }
      } catch (err) {
        showToast('Error de conexión', 'error');
      }
    });

    // Form Execute Maintenance
    document.getElementById('form-exec-maint')?.addEventListener('submit', async (e) => {
      e.preventDefault();
      const maintId = (document.getElementById('input-exec-maint-id') as HTMLInputElement).value;
      const performedDate = (document.getElementById('input-exec-date') as HTMLInputElement).value;
      const performedKm = (document.getElementById('input-exec-km') as HTMLInputElement).value;
      const performedBy = (document.getElementById('select-exec-user') as HTMLSelectElement).value;
      const workshop = (document.getElementById('input-exec-workshop') as HTMLInputElement).value;
      const cost = (document.getElementById('input-exec-cost') as HTMLInputElement).value;
      const notes = (document.getElementById('input-exec-notes') as HTMLTextAreaElement).value;

      try {
        const res = await fetch('/api/garage/execute', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({
            vehicleId: activeVehicleId,
            maintenanceId: maintId ? Number(maintId) : null,
            performedDate,
            performedKm: performedKm ? Number(performedKm) : null,
            performedBy: performedBy ? Number(performedBy) : null,
            workshop,
            cost,
            notes,
          }),
        });
        const data = await res.json();
        if (data.success) {
          triggerConfetti();
          showToast('Mantenimiento registrado y anotado en historial', 'success');
          closeExecuteMaintModal();
          await loadGarage();
        } else {
          showToast(data.error || 'Error al guardar', 'error');
        }
      } catch (err) {
        showToast('Error de conexión', 'error');
      }
    });

    // Form New/Edit Maintenance
    document.getElementById('form-new-maintenance')?.addEventListener('submit', async (e) => {
      e.preventDefault();
      const id = (document.getElementById('input-maint-rule-id') as HTMLInputElement).value;
      const name = (document.getElementById('input-maint-name') as HTMLInputElement).value;
      const intervalKm = (document.getElementById('input-maint-interval-km') as HTMLInputElement).value;
      const intervalMonths = (document.getElementById('input-maint-interval-months') as HTMLInputElement).value;
      const lastDoneKm = (document.getElementById('input-maint-last-km') as HTMLInputElement).value;
      const lastDoneDate = (document.getElementById('input-maint-last-date') as HTMLInputElement).value;

      try {
        const res = await fetch('/api/garage/maintenance', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({
            id: id ? Number(id) : undefined,
            vehicleId: activeVehicleId,
            name,
            intervalKm: intervalKm ? Number(intervalKm) : null,
            intervalMonths: intervalMonths ? Number(intervalMonths) : null,
            lastDoneKm: lastDoneKm ? Number(lastDoneKm) : null,
            lastDoneDate: lastDoneDate || null,
          }),
        });
        const data = await res.json();
        if (data.success) {
          showToast(id ? 'Tarea actualizada' : 'Tarea de mantenimiento creada', 'success');
          closeNewMaintModal();
          await loadGarage();
        } else {
          showToast(data.error || 'Error al guardar', 'error');
        }
      } catch (err) {
        showToast('Error de conexión', 'error');
      }
    });

    // Form Report Incident
    document.getElementById('form-new-incident')?.addEventListener('submit', async (e) => {
      e.preventDefault();
      const title = (document.getElementById('input-incident-title') as HTMLInputElement).value;
      const description = (document.getElementById('input-incident-desc') as HTMLTextAreaElement).value;
      const reportedBy = (document.getElementById('select-incident-user') as HTMLSelectElement).value;
      const reportedDate = (document.getElementById('input-incident-date') as HTMLInputElement).value;

      try {
        const res = await fetch('/api/garage/incidents', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({
            vehicleId: activeVehicleId,
            title,
            description,
            reportedBy: reportedBy ? Number(reportedBy) : null,
            reportedDate,
          }),
        });
        const data = await res.json();
        if (data.success) {
          showToast('Incidencia reportada', 'warning');
          closeNewIncidentModal();
          await loadGarage();
        } else {
          showToast(data.error || 'Error al guardar', 'error');
        }
      } catch (err) {
        showToast('Error de conexión', 'error');
      }
    });

    // Form Resolve Incident
    document.getElementById('form-resolve-incident')?.addEventListener('submit', async (e) => {
      e.preventDefault();
      const incidentId = (document.getElementById('input-resolve-incident-id') as HTMLInputElement).value;
      const resolutionNotes = (document.getElementById('input-resolve-notes') as HTMLTextAreaElement).value;
      const workshop = (document.getElementById('input-resolve-workshop') as HTMLInputElement).value;
      const resolvedDate = (document.getElementById('input-resolve-date') as HTMLInputElement).value;

      try {
        const res = await fetch('/api/garage/incidents', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({
            action: 'resolve',
            incidentId: Number(incidentId),
            resolutionNotes,
            workshop,
            resolvedDate,
            performedBy: activeUser?.id,
          }),
        });
        const data = await res.json();
        if (data.success) {
          triggerConfetti();
          showToast('Incidencia resuelta y archivada', 'success');
          closeResolveIncidentModal();
          await loadGarage();
        } else {
          showToast(data.error || 'Error al resolver', 'error');
        }
      } catch (err) {
        showToast('Error de conexión', 'error');
      }
    });

    // Form New Vehicle
    document.getElementById('form-new-vehicle')?.addEventListener('submit', async (e) => {
      e.preventDefault();
      const name = (document.getElementById('input-veh-name') as HTMLInputElement).value;
      const plate = (document.getElementById('input-veh-plate') as HTMLInputElement).value;
      const icon = (document.getElementById('input-veh-icon') as HTMLInputElement).value;
      const hasMileage = (document.getElementById('check-veh-has-mileage') as HTMLInputElement).checked;
      const currentKm = (document.getElementById('input-veh-initial-km') as HTMLInputElement).value;

      try {
        const res = await fetch('/api/garage', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({
            name,
            plate,
            icon,
            hasMileage,
            currentKm: hasMileage && currentKm ? Number(currentKm) : 0,
          }),
        });
        const data = await res.json();
        if (data.success) {
          triggerConfetti();
          showToast('Vehículo añadido al garaje', 'success');
          closeNewVehicleModal();
          activeVehicleId = data.vehicle.id;
          await loadGarage();
        } else {
          showToast(data.error || 'Error al crear vehículo', 'error');
        }
      } catch (err) {
        showToast('Error de conexión', 'error');
      }
    });

    // Vehicle icon buttons
    document.querySelectorAll('.quick-veh-icon').forEach((btn) => {
      btn.addEventListener('click', () => {
        const input = document.getElementById('input-veh-icon') as HTMLInputElement;
        if (input) input.value = (btn.textContent || '🚗').trim();
      });
    });

    // Toggle container veh km
    document.getElementById('check-veh-has-mileage')?.addEventListener('change', (e) => {
      const checked = (e.target as HTMLInputElement).checked;
      document.getElementById('container-veh-km')?.classList.toggle('hidden', !checked);
    });

    // 10. Modal Nueva Tarea
    const modalChore = document.getElementById('modal-new-chore');
    const openChoreBtn = document.getElementById('btn-open-new-chore-modal');
    const closeChoreBtn = document.getElementById('btn-close-new-chore-modal');
    const cancelChoreBtn = document.getElementById('btn-cancel-new-chore');
    const formChore = document.getElementById('form-new-chore') as HTMLFormElement;
    const selectFreq = document.getElementById('select-chore-frequency') as HTMLSelectElement | null;
    const containerSecondDay = document.getElementById('container-second-day');
    const labelDay1 = document.getElementById('label-chore-day-1');

    // Escuchar cambio en periodicidad para mostrar/ocultar segundo día y responsable
    selectFreq?.addEventListener('change', () => {
      const isOnce = selectFreq.value === 'once';
      const containerDay1 = document.getElementById('container-day-1');
      const containerAssignmentMode = document.getElementById('container-assignment-mode');
      const containerAssignee = document.getElementById('container-assignee');
      const selectAssignee = document.getElementById('select-chore-assignee') as HTMLSelectElement | null;

      if (containerDay1) containerDay1.classList.toggle('hidden', isOnce);
      if (containerAssignmentMode) containerAssignmentMode.classList.toggle('hidden', isOnce);
      if (containerAssignee) containerAssignee.classList.toggle('hidden', isOnce);

      if (selectAssignee) {
        if (isOnce) {
          selectAssignee.removeAttribute('required');
          selectAssignee.value = '';
        } else {
          selectAssignee.setAttribute('required', 'true');
        }
      }

      if (selectFreq.value === 'twice_weekly') {
        containerSecondDay?.classList.remove('hidden');
        if (labelDay1) labelDay1.textContent = 'Primer día';
      } else {
        containerSecondDay?.classList.add('hidden');
        if (labelDay1) labelDay1.textContent = 'Día preferido';
      }
    });

    // Escuchar cambio en modalidad de reparto (fija vs rotativa)
    document.querySelectorAll('input[name="assignment-mode"]').forEach((radio) => {
      radio.addEventListener('change', (e) => {
        const val = (e.target as HTMLInputElement).value;
        const descEl = document.getElementById('desc-assignment-mode');
        const labelAssignee = document.getElementById('label-assignee-select');
        if (val === 'rotating') {
          if (descEl) descEl.textContent = '🔄 La tarea irá rotando automáticamente entre todos los convivientes cada semana.';
          if (labelAssignee) labelAssignee.textContent = 'Punto de partida de la rotación';
        } else {
          if (descEl) descEl.textContent = '📌 La tarea estará siempre asignada a la misma persona seleccionada.';
          if (labelAssignee) labelAssignee.textContent = 'Responsable habitual';
        }
      });
    });

    openChoreBtn?.addEventListener('click', openNewChoreModal);
    closeChoreBtn?.addEventListener('click', closeChoreModal);
    cancelChoreBtn?.addEventListener('click', closeChoreModal);

    formChore?.addEventListener('submit', async (e) => {
      e.preventDefault();
      const editId = (document.getElementById('input-edit-chore-id') as HTMLInputElement).value;
      const name = (document.getElementById('input-chore-name') as HTMLInputElement).value;
      const frequency = (document.getElementById('select-chore-frequency') as HTMLSelectElement).value;
      const assignmentMode = (document.querySelector('input[name="assignment-mode"]:checked') as HTMLInputElement)?.value || 'fixed';
      const defaultAssigneeId = (document.getElementById('select-chore-assignee') as HTMLSelectElement).value;
      const icon = (document.getElementById('input-chore-icon') as HTMLInputElement).value;
      const category = (document.getElementById('input-chore-category') as HTMLInputElement).value;
      const dayOfWeek = (document.getElementById('select-chore-day') as HTMLSelectElement).value;
      const secondDayOfWeek = (document.getElementById('select-chore-second-day') as HTMLSelectElement)?.value;

      const isOnce = frequency === 'once';
      const cleanAssigneeId = isOnce || !defaultAssigneeId ? null : Number(defaultAssigneeId);

      const url = editId ? `/api/catalog/${editId}` : '/api/catalog';
      const method = editId ? 'PUT' : 'POST';

      try {
        const res = await fetch(url, {
          method,
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({
            name,
            frequency,
            assignmentMode: isOnce ? 'fixed' : assignmentMode,
            defaultAssigneeId: cleanAssigneeId,
            icon,
            category,
            dayOfWeek: Number(dayOfWeek),
            secondDayOfWeek: frequency === 'twice_weekly' ? Number(secondDayOfWeek || 4) : undefined,
          }),
        });

        const data = await res.json();
        if (data.success) {
          showToast(editId ? '¡Tarea actualizada correctamente!' : '¡Tarea agregada al catálogo y programada!', 'success');
          closeChoreModal();
          formChore.reset();
          await loadCatalog();
          if (activeTab === 'dashboard') loadDashboard();
        } else {
          showToast(data.error || 'Error al guardar tarea', 'error');
        }
      } catch (err) {
        showToast('Error de conexión', 'error');
      }
    });

    // 11. Modal Nuevo / Editar Conviviente
    const modalUser = document.getElementById('modal-new-user');
    const openUserBtn = document.getElementById('btn-open-new-user-modal');
    const openUserFromDropdown = document.getElementById('btn-open-new-user-from-dropdown');
    const closeUserBtn = document.getElementById('btn-close-new-user-modal');
    const cancelUserBtn = document.getElementById('btn-cancel-new-user');
    const formUser = document.getElementById('form-new-user') as HTMLFormElement;

    openUserBtn?.addEventListener('click', openNewUserModal);
    openUserFromDropdown?.addEventListener('click', openNewUserModal);
    closeUserBtn?.addEventListener('click', closeUserModal);
    cancelUserBtn?.addEventListener('click', closeUserModal);

    formUser?.addEventListener('submit', async (e) => {
      e.preventDefault();
      const editId = (document.getElementById('input-edit-user-id') as HTMLInputElement).value;
      const name = (document.getElementById('input-user-name') as HTMLInputElement).value;
      const email = (document.getElementById('input-user-email') as HTMLInputElement).value;
      const avatar = (document.getElementById('input-user-avatar') as HTMLInputElement).value;
      const color = (document.getElementById('input-user-color') as HTMLInputElement).value;

      const url = editId ? `/api/users/${editId}` : '/api/users';
      const method = editId ? 'PUT' : 'POST';

      try {
        const res = await fetch(url, {
          method,
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ name, email, avatar, color }),
        });

        const data = await res.json();
        if (data.success) {
          showToast(editId ? `Conviviente "${name}" actualizado con éxito` : `¡Conviviente ${name} creado con éxito!`, 'success');
          closeUserModal();
          formUser.reset();
          await loadUsers();
          if (editId) {
            if (activeUser?.id === Number(editId)) {
              setActiveUser(Number(editId));
            }
          } else {
            setActiveUser(data.user.id);
          }
          if (activeTab === 'roommates') loadRoommates();
          if (activeTab === 'dashboard') loadDashboard();
        } else {
          showToast(data.error || 'Error al guardar conviviente', 'error');
        }
      } catch (err) {
        showToast('Error de conexión', 'error');
      }
    });

    // 12. Shopping List & Catalog Listeners (Listonic Style)
    // Subtab toggling
    document.getElementById('shopping-subtab-btn-list')?.addEventListener('click', () => setShoppingSubtab('list'));
    document.getElementById('shopping-subtab-btn-catalog')?.addEventListener('click', () => setShoppingSubtab('catalog'));

    // Catalog live search
    const inputCatalogSearch = document.getElementById('input-catalog-search') as HTMLInputElement | null;
    const btnCatalogClearSearch = document.getElementById('btn-catalog-clear-search');

    inputCatalogSearch?.addEventListener('input', () => {
      catalogSearchQuery = inputCatalogSearch.value;
      renderShoppingCatalog();
    });

    btnCatalogClearSearch?.addEventListener('click', () => {
      if (inputCatalogSearch) inputCatalogSearch.value = '';
      catalogSearchQuery = '';
      renderShoppingCatalog();
      inputCatalogSearch?.focus();
    });

    // Search / Create in Catalog Form
    const formCatalogSearch = document.getElementById('form-catalog-search') as HTMLFormElement | null;
    formCatalogSearch?.addEventListener('submit', async (e) => {
      e.preventDefault();
      const val = inputCatalogSearch?.value.trim();
      if (!val) return;

      const existing = shoppingCatalogList.find((i) => i.name.toLowerCase() === val.toLowerCase());
      if (existing) {
        await addFromCatalog(existing.id);
        if (inputCatalogSearch) inputCatalogSearch.value = '';
        catalogSearchQuery = '';
        renderShoppingCatalog();
      } else {
        await createAndAddCatalogItem(val);
      }
    });

    document.getElementById('btn-shopping-clear-bought')?.addEventListener('click', clearBoughtShoppingItems);

    // Finalizar compra por completo (vaciar pendientes y comprados, manteniendo artículos en uso)
    document.getElementById('btn-shopping-finish-all')?.addEventListener('click', async () => {
      if (confirm('¿Finalizar compra? Se vaciará toda la lista actual (pendientes y el carro). Los artículos en uso seguirán guardados en la despensa.')) {
        try {
          const res = await fetch('/api/shopping/clear-all', { method: 'POST' });
          const data = await res.json();
          if (data.success) {
            triggerConfetti();
            showToast('¡Compra finalizada! Lista vaciada y despensa lista 🎉', 'success');
            await loadShoppingList();
            await loadShoppingCatalog();
          } else {
            showToast(data.error || 'Error al finalizar compra', 'error');
          }
        } catch (err) {
          showToast('Error de conexión', 'error');
        }
      }
    });

    document.getElementById('btn-toggle-bought-section')?.addEventListener('click', () => {
      isBoughtSectionOpen = !isBoughtSectionOpen;
      const container = document.getElementById('shopping-bought-container');
      const chevron = document.getElementById('bought-chevron');
      if (container) container.classList.toggle('hidden', !isBoughtSectionOpen);
      if (chevron) chevron.textContent = isBoughtSectionOpen ? '▼' : '▶';
    });

    // FAB y Modal de Artículo Puntual (de una sola vez)
    document.getElementById('btn-shopping-fab-add')?.addEventListener('click', openAddOneOffModal);
    document.getElementById('btn-close-add-one-off')?.addEventListener('click', closeAddOneOffModal);
    document.getElementById('btn-cancel-add-one-off')?.addEventListener('click', closeAddOneOffModal);

    document.getElementById('btn-one-off-qty-down')?.addEventListener('click', () => {
      const inp = document.getElementById('input-one-off-qty') as HTMLInputElement | null;
      if (inp) {
        const val = parseInt(inp.value || '1', 10);
        if (val > 1) inp.value = String(val - 1);
      }
    });

    document.getElementById('btn-one-off-qty-up')?.addEventListener('click', () => {
      const inp = document.getElementById('input-one-off-qty') as HTMLInputElement | null;
      if (inp) {
        const val = parseInt(inp.value || '1', 10);
        inp.value = String(val + 1);
      }
    });

    document.querySelectorAll('.btn-one-off-chip').forEach((chip) => {
      chip.addEventListener('click', () => {
        const u = chip.getAttribute('data-unit');
        const inp = document.getElementById('input-one-off-unit') as HTMLInputElement | null;
        if (inp && u) inp.value = u;
      });
    });

    const formAddOneOff = document.getElementById('form-add-one-off') as HTMLFormElement | null;
    formAddOneOff?.addEventListener('submit', async (e) => {
      e.preventDefault();
      const inputName = document.getElementById('input-one-off-name') as HTMLInputElement | null;
      const inputQty = document.getElementById('input-one-off-qty') as HTMLInputElement | null;
      const inputUnit = document.getElementById('input-one-off-unit') as HTMLInputElement | null;
      const inputNotes = document.getElementById('input-one-off-notes') as HTMLInputElement | null;
      const checkCatalog = document.getElementById('check-one-off-save-catalog') as HTMLInputElement | null;
      const selectCat = document.getElementById('select-one-off-category') as HTMLSelectElement | null;

      if (!inputName || !inputName.value.trim()) return;

      const name = inputName.value.trim();
      const qty = inputQty?.value.trim() || '1';
      const unit = inputUnit?.value.trim() || undefined;
      const notes = inputNotes?.value.trim();
      const category = selectCat?.value !== 'auto' ? selectCat?.value : undefined;
      const saveToCatalog = Boolean(checkCatalog?.checked);

      try {
        const res = await fetch('/api/shopping', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({
            name,
            category,
            quantity: qty,
            unit,
            notes,
            saveToCatalog,
            isOneOff: !saveToCatalog,
            addedBy: activeUser?.id,
          }),
        });

        const data = await res.json();
        if (data.success) {
          showToast(`"${name}" añadido a la compra 🛒`, 'success');
          closeAddOneOffModal();
          await loadShoppingList();
          await loadShoppingCatalog();
        } else {
          showToast(data.error || 'Error al añadir artículo', 'error');
        }
      } catch (err) {
        showToast('Error de conexión', 'error');
      }
    });

    // Unit Picker Modal Listeners
    document.getElementById('btn-close-change-unit')?.addEventListener('click', closeChangeUnitModal);
    document.getElementById('btn-cancel-change-unit')?.addEventListener('click', closeChangeUnitModal);

    const formChangeUnit = document.getElementById('form-change-unit') as HTMLFormElement | null;
    formChangeUnit?.addEventListener('submit', async (e) => {
      e.preventDefault();
      const inputId = (document.getElementById('input-unit-target-id') as HTMLInputElement).value;
      const inputType = (document.getElementById('input-unit-target-type') as HTMLInputElement).value;
      const inputUnit = (document.getElementById('input-selected-unit') as HTMLInputElement).value.trim();
      const checkUpdateCatalog = (document.getElementById('check-update-catalog-unit') as HTMLInputElement)?.checked;

      if (!inputId || !inputUnit) return;

      try {
        if (inputType === 'shopping') {
          const res = await fetch(`/api/shopping/${inputId}`, {
            method: 'PATCH',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ unit: inputUnit }),
          });
          const data = await res.json();
          if (data.success) {
            showToast(`Unidad cambiada a "${inputUnit}"`, 'success');
            // Si marcó guardar también en catálogo para siempre
            if (checkUpdateCatalog && data.item?.catalogId) {
              await fetch(`/api/shopping/catalog/${data.item.catalogId}`, {
                method: 'PATCH',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({ defaultUnit: inputUnit }),
              });
            }
          }
        } else {
          // Actualizar artículo del catálogo directamente
          await fetch(`/api/shopping/catalog/${inputId}`, {
            method: 'PATCH',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ defaultUnit: inputUnit }),
          });
          showToast(`Unidad por defecto guardada: "${inputUnit}"`, 'success');
        }

        closeChangeUnitModal();
        await loadShoppingList();
        await loadShoppingCatalog();
      } catch (err) {
        showToast('Error al actualizar unidad', 'error');
      }
    });

    // Edit Catalog Item Modal Listeners
    document.getElementById('btn-close-edit-catalog-item')?.addEventListener('click', closeEditCatalogModal);
    document.getElementById('btn-cancel-edit-catalog-item')?.addEventListener('click', closeEditCatalogModal);

    const formEditCatalog = document.getElementById('form-edit-catalog-item') as HTMLFormElement | null;
    formEditCatalog?.addEventListener('submit', async (e) => {
      e.preventDefault();
      const id = (document.getElementById('input-edit-catalog-id') as HTMLInputElement).value;
      const name = (document.getElementById('input-edit-catalog-name') as HTMLInputElement).value.trim();
      const category = (document.getElementById('select-edit-catalog-category') as HTMLSelectElement).value;
      const defaultUnit = (document.getElementById('input-edit-catalog-unit') as HTMLInputElement).value.trim();

      if (!id || !name) return;

      try {
        const res = await fetch(`/api/shopping/catalog/${id}`, {
          method: 'PATCH',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ name, category, defaultUnit }),
        });
        const data = await res.json();
        if (data.success) {
          showToast('Artículo en uso actualizado ✅', 'success');
          closeEditCatalogModal();
          await loadShoppingCatalog();
          await loadShoppingList();
        } else {
          showToast(data.error || 'Error al actualizar', 'error');
        }
      } catch (err) {
        showToast('Error de conexión', 'error');
      }
    });

    document.getElementById('btn-delete-catalog-item')?.addEventListener('click', async () => {
      const id = (document.getElementById('input-edit-catalog-id') as HTMLInputElement).value;
      const name = (document.getElementById('input-edit-catalog-name') as HTMLInputElement).value;

      if (!id) return;
      if (confirm(`¿Eliminar "${name}" de tus artículos en uso? (Ya no aparecerá en el catálogo habitual)`)) {
        try {
          const res = await fetch(`/api/shopping/catalog/${id}`, { method: 'DELETE' });
          const data = await res.json();
          if (data.success) {
            showToast('Artículo eliminado de la despensa', 'info');
            closeEditCatalogModal();
            await loadShoppingCatalog();
            await loadShoppingList();
          } else {
            showToast(data.error || 'Error al eliminar', 'error');
          }
        } catch (err) {
          showToast('Error de conexión', 'error');
        }
      }
    });

    // Delegation for go-shopping shortcuts (from chores card or catalog)
    document.addEventListener('click', (e) => {
      const target = (e.target as HTMLElement).closest('.btn-catalog-go-shopping, .btn-chore-go-shopping');
      if (target) {
        e.preventDefault();
        switchTab('shopping');
      }
    });
  });
</script>
