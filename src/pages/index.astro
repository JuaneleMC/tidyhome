---
import Layout from '../layouts/Layout.astro';
import '../styles/global.css';
---

<Layout title="TidyHome - Reparto Inteligente de Tareas del Hogar">
  
  <!-- ========================================== -->
  <!-- TAB 1: CALENDARIO (MES + SEMANA ACTUAL) -->
  <!-- ========================================== -->
  <section id="view-calendar" class="tab-view block space-y-4">
    <!-- Switcher Superior: Mes vs Semana actual -->
    <div class="inline-flex p-1 rounded-xl bg-slate-800/80 border border-slate-700/60 text-xs font-semibold w-full">
      <button
        id="btn-cal-tab-month"
        type="button"
        class="cal-view-toggle-btn flex-1 py-1.5 rounded-lg bg-indigo-600 text-white font-bold transition shadow-sm"
      >
        🗓️ Mes
      </button>
      <button
        id="btn-cal-tab-week"
        type="button"
        class="cal-view-toggle-btn flex-1 py-1.5 rounded-lg text-slate-400 hover:text-white font-semibold transition"
      >
        📋 Semana actual (Casa)
      </button>
    </div>

    <!-- SUB-VIEW 1: MES COMPLETO -->
    <div id="cal-subview-month" class="space-y-2.5">
      <div class="flex items-center justify-between gap-3">
        <div>
          <h2 class="text-base sm:text-lg font-bold text-white tracking-tight flex items-center gap-2">
            <span>🗓️</span> Calendario Mensual
          </h2>
          <p class="text-xs text-slate-400 font-medium">Tareas del mes por conviviente</p>
        </div>
        <div class="inline-flex items-center gap-1">
          <button id="btn-cal-prev" class="w-8 h-8 rounded-lg bg-slate-800 text-slate-300 hover:text-white font-bold transition active:scale-90" title="Mes anterior">‹</button>
          <button id="btn-cal-today" class="px-2.5 h-8 rounded-lg bg-slate-800 text-slate-300 hover:text-white text-[11px] font-semibold transition active:scale-95">Hoy</button>
          <button id="btn-cal-next" class="w-8 h-8 rounded-lg bg-slate-800 text-slate-300 hover:text-white font-bold transition active:scale-90" title="Mes siguiente">›</button>
        </div>
      </div>

      <div class="text-center text-sm font-extrabold text-white tracking-tight" id="cal-month-title">—</div>

      <!-- Filtro por conviviente -->
      <div id="cal-user-filter" class="flex items-center gap-1.5 overflow-x-auto pb-1 text-xs"></div>

      <div class="glass-card rounded-2xl p-2.5 sm:p-3">
        <div class="grid grid-cols-7 gap-1 mb-1 text-center text-[10px] font-bold uppercase tracking-wider text-slate-400">
          <span>Lun</span><span>Mar</span><span>Mié</span><span>Jue</span><span>Vie</span><span>Sáb</span><span>Dom</span>
        </div>
        <div id="cal-grid" class="grid grid-cols-7 gap-1"></div>
      </div>

      <!-- Modal desglose del día -->
      <div id="cal-day-modal" class="hidden fixed inset-0 z-50 flex items-end sm:items-center justify-center bg-slate-900/50 backdrop-blur-sm p-3">
        <div class="glass-card rounded-2xl w-full max-w-md max-h-[75vh] overflow-y-auto p-4 space-y-3">
          <div class="flex items-center justify-between">
            <h3 id="cal-day-title" class="text-sm font-extrabold text-white capitalize"></h3>
            <button id="btn-cal-day-close" class="text-slate-400 hover:text-white text-xl leading-none px-1">&times;</button>
          </div>
          <div id="cal-day-list" class="space-y-2"></div>
          <button id="btn-cal-day-add" type="button" class="w-full py-2.5 rounded-xl bg-indigo-600 hover:bg-indigo-500 text-white text-xs font-bold shadow-lg shadow-indigo-600/30 transition active:scale-95">
            + Añadir tarea hecha
          </button>
        </div>
      </div>
    </div>

    <!-- SUB-VIEW 2: SEMANA ACTUAL (CASA) -->
    <div id="cal-subview-week" class="hidden space-y-4">
      <!-- Household Summary Banner -->
      <div class="glass-card rounded-2xl p-4 sm:p-5 relative overflow-hidden">
        <div class="flex items-center justify-between gap-3">
          <div>
            <div class="flex items-center gap-2">
              <span class="text-xl">🏠</span>
              <h2 class="text-base sm:text-lg font-bold text-white tracking-tight">
                Estado General de la Casa
              </h2>
            </div>
            <p id="dashboard-week-range" class="text-xs text-slate-400 font-medium mt-0.5">
              Semana actual
            </p>
          </div>

          <!-- Global Percentage Badge -->
          <div class="flex flex-col items-end">
            <span id="dashboard-global-pct" class="text-xl sm:text-2xl font-extrabold text-emerald-400 leading-none">
              0%
            </span>
            <span class="text-[10px] text-slate-400 font-semibold uppercase tracking-wider mt-0.5">
              Completado
            </span>
          </div>
        </div>

        <!-- Progress bar -->
        <div class="mt-3.5 space-y-1">
          <div class="w-full h-2.5 bg-slate-800 rounded-full overflow-hidden p-0.5 border border-slate-700/50">
            <div
              id="dashboard-progress-bar"
              class="h-full bg-gradient-to-r from-emerald-500 via-teal-400 to-indigo-500 rounded-full transition-all duration-500 ease-out"
              style="width: 0%"
            ></div>
          </div>
          <div class="flex justify-between text-[11px] text-slate-400 pt-0.5">
            <span><strong id="dashboard-done-count" class="text-emerald-400 font-bold">0</strong> hechas</span>
            <span><strong id="dashboard-pending-count" class="text-amber-400 font-bold">0</strong> pendientes</span>
          </div>
        </div>

        <!-- Household notice banner about "¡Lo hago yo!" -->
        <div class="mt-3 pt-3 border-t border-slate-700/50 flex items-center gap-2 text-xs text-slate-300">
          <span class="text-pink-400 text-sm">💡</span>
          <span>
            ¿Tienes tiempo libre? Pulsa <strong class="text-pink-400 font-semibold">"¡Lo hago yo!"</strong> en cualquier tarea pendiente para asumirla y completarla.
          </span>
        </div>
      </div>

      <!-- Dashboard Grouping Toggle: Por Día vs Por Conviviente -->
      <div class="flex items-center justify-between gap-2">
        <div class="inline-flex p-1 rounded-xl bg-slate-800/80 border border-slate-700/60 text-xs font-semibold">
          <button
            id="btn-group-by-day"
            class="dashboard-group-btn px-3 py-1.5 rounded-lg bg-indigo-600 text-white shadow-sm transition"
          >
            📅 Por Día
          </button>
          <button
            id="btn-group-by-user"
            class="dashboard-group-btn px-3 py-1.5 rounded-lg text-slate-400 hover:text-white transition"
          >
            👥 Por Conviviente
          </button>
        </div>

        <div class="flex items-center gap-2">
          <span class="text-[11px] text-slate-400 hidden xs:inline">Filtro:</span>
          <select
            id="filter-dashboard-status"
            class="text-xs bg-slate-800 border border-slate-700 rounded-lg px-2.5 py-1.5 text-slate-200 focus:outline-none focus:ring-1 focus:ring-indigo-500"
          >
            <option value="all">Todas las tareas</option>
            <option value="pending">Solo pendientes</option>
            <option value="completed">Solo completadas</option>
          </select>
        </div>
      </div>

      <!-- Dashboard Groups Container -->
      <div id="dashboard-groups-container" class="space-y-4">
        <!-- Loading Skeleton -->
        <div class="glass-card rounded-2xl p-4 animate-pulse space-y-3">
          <div class="h-5 bg-slate-800 rounded w-1/3"></div>
          <div class="h-16 bg-slate-800 rounded-xl"></div>
          <div class="h-16 bg-slate-800 rounded-xl"></div>
        </div>
      </div>
    </div>
  </section>

  <!-- ========================================== -->
  <!-- TAB 2: GARAJE / VEHÍCULOS -->
  <!-- ========================================== -->
  <section id="view-garage" class="tab-view hidden space-y-4">
    <!-- Header with Add Vehicle button -->
    <div class="flex items-center justify-between gap-3">
      <div>
        <h2 class="text-base sm:text-lg font-bold text-white tracking-tight flex items-center gap-2">
          <span>🚗</span> Garaje & Flota
        </h2>
        <p class="text-xs text-slate-400 font-medium">Mantenimientos, revisiones e incidencias</p>
      </div>

      <button
        id="btn-open-new-vehicle-modal"
        class="inline-flex items-center gap-1.5 px-3.5 py-2 rounded-xl bg-gradient-to-r from-blue-600 to-indigo-600 hover:from-blue-500 hover:to-indigo-500 text-white text-xs font-bold shadow-lg shadow-blue-600/20 active:scale-95 transition"
      >
        <span class="text-base leading-none">+</span>
        <span>Añadir Vehículo</span>
      </button>
    </div>

    <!-- Fleet Selector Pills -->
    <div id="garage-fleet-pills" class="flex items-center gap-1.5 overflow-x-auto pb-1 text-xs">
      <!-- Injected by JS -->
    </div>

    <!-- Active Vehicle Hero Card -->
    <div id="garage-vehicle-hero" class="glass-card rounded-2xl p-4 sm:p-5 relative overflow-hidden space-y-3 border border-slate-700/60">
      <!-- Loading placeholder -->
      <div class="animate-pulse space-y-2">
        <div class="h-5 bg-slate-800 rounded w-1/3"></div>
        <div class="h-8 bg-slate-800 rounded w-1/2"></div>
      </div>
    </div>

    <!-- Sub-Tabs inside Active Vehicle -->
    <div class="inline-flex p-1 rounded-xl bg-slate-800/80 border border-slate-700/60 text-xs font-semibold w-full">
      <button
        id="garage-subtab-btn-maint"
        type="button"
        class="garage-subtab-btn flex-1 py-1.5 rounded-lg bg-indigo-600 text-white font-bold transition shadow-sm flex items-center justify-center gap-1.5"
      >
        <span>🔧 Mantenimientos</span>
        <span id="badge-count-overdue" class="hidden px-1.5 py-0.2 bg-rose-500 text-white rounded-full text-[10px]">0</span>
      </button>
      <button
        id="garage-subtab-btn-incidents"
        type="button"
        class="garage-subtab-btn flex-1 py-1.5 rounded-lg text-slate-400 hover:text-white font-semibold transition flex items-center justify-center gap-1.5"
      >
        <span>⚠️ Incidencias</span>
        <span id="badge-count-incidents" class="hidden px-1.5 py-0.2 bg-amber-500 text-slate-900 font-bold rounded-full text-[10px]">0</span>
      </button>
      <button
        id="garage-subtab-btn-history"
        type="button"
        class="garage-subtab-btn flex-1 py-1.5 rounded-lg text-slate-400 hover:text-white font-semibold transition"
      >
        📖 Historial
      </button>
    </div>

    <!-- SUB-PANEL 1: MANTENIMIENTOS -->
    <div id="garage-panel-maint" class="space-y-3">
      <div class="flex items-center justify-between gap-2 px-1">
        <span class="text-xs font-bold text-slate-400 uppercase tracking-wider">Plan del Fabricante</span>
      </div>
      <div id="garage-maint-list" class="space-y-2.5 pb-20">
        <!-- Injected by JS -->
      </div>

      <button
        id="btn-open-new-maint-modal"
        type="button"
        class="fixed bottom-24 right-4 sm:bottom-24 sm:right-6 z-40 inline-flex items-center gap-1.5 px-4 py-3 rounded-full bg-indigo-600 hover:bg-indigo-500 text-white text-sm font-bold shadow-xl shadow-indigo-600/40 active:scale-95 transition"
        title="Añadir mantenimiento"
      >
        <span class="text-xl leading-none">+</span>
        <span>Añadir Mantenimiento</span>
      </button>
    </div>

    <!-- SUB-PANEL 2: INCIDENCIAS -->
    <div id="garage-panel-incidents" class="hidden space-y-3">
      <div class="flex items-center justify-between gap-2 px-1">
        <span class="text-xs font-bold text-slate-400 uppercase tracking-wider">Averías & Síntomas</span>
        <button
          id="btn-open-new-incident-modal"
          type="button"
          class="text-xs text-amber-400 hover:text-amber-300 font-semibold flex items-center gap-1"
        >
          <span>+ Reportar Síntoma</span>
        </button>
      </div>
      <div id="garage-incidents-list" class="space-y-2.5">
        <!-- Injected by JS -->
      </div>
    </div>

    <!-- SUB-PANEL 3: HISTORIAL (LIBRO DE REVISIONES) -->
    <div id="garage-panel-history" class="hidden space-y-3">
      <div class="px-1">
        <span class="text-xs font-bold text-slate-400 uppercase tracking-wider">Libro de Revisiones Digital</span>
      </div>
      <div id="garage-history-list" class="space-y-2.5">
        <!-- Injected by JS -->
      </div>
    </div>
  </section>
  <!-- ========================================== -->
  <!-- TAB 3: CATÁLOGO DE TAREAS -->
  <!-- ========================================== -->
  <section id="view-catalog" class="tab-view hidden space-y-4">
    <!-- Header with Add Chore button -->
    <div class="flex items-center justify-between gap-3">
      <div>
        <h2 class="text-base sm:text-lg font-bold text-white tracking-tight flex items-center gap-2">
          <span>📋</span> Tareas
        </h2>
        <p class="text-xs text-slate-400 font-medium">
          Configuración periódica y reparto habitual del hogar
        </p>
      </div>

      <button
        id="btn-open-new-chore-modal"
        class="fixed bottom-24 right-4 sm:bottom-24 sm:right-6 z-40 inline-flex items-center gap-1.5 px-4 py-3 rounded-full bg-indigo-600 hover:bg-indigo-500 text-white text-sm font-bold shadow-xl shadow-indigo-600/40 active:scale-95 transition"
        title="Nueva tarea"
      >
        <span class="text-xl leading-none">+</span>
        <span>Nueva Tarea</span>
      </button>
    </div>

    <!-- Frequency Filter Pills -->
    <div class="flex items-center gap-1.5 overflow-x-auto pb-1 text-xs">
      <button data-freq="all" class="catalog-filter-btn px-3 py-1.5 rounded-lg bg-indigo-600 text-white font-semibold transition">
        Todas
      </button>
      <button data-freq="daily" class="catalog-filter-btn px-3 py-1.5 rounded-lg bg-slate-800 text-slate-300 hover:text-white font-medium transition">
        Diarias
      </button>
      <button data-freq="twice_weekly" class="catalog-filter-btn px-3 py-1.5 rounded-lg bg-slate-800 text-slate-300 hover:text-white font-medium transition">
        2 por semana
      </button>
      <button data-freq="weekly" class="catalog-filter-btn px-3 py-1.5 rounded-lg bg-slate-800 text-slate-300 hover:text-white font-medium transition">
        Semanales
      </button>
      <button data-freq="biweekly" class="catalog-filter-btn px-3 py-1.5 rounded-lg bg-slate-800 text-slate-300 hover:text-white font-medium transition">
        Quincenales
      </button>
      <button data-freq="monthly" class="catalog-filter-btn px-3 py-1.5 rounded-lg bg-slate-800 text-slate-300 hover:text-white font-medium transition">
        Mensuales
      </button>
      <button data-freq="once" class="catalog-filter-btn px-3 py-1.5 rounded-lg bg-slate-800 text-slate-300 hover:text-white font-medium transition">
        Puntuales
      </button>
    </div>

    <!-- Catalog List Container -->
    <div id="catalog-list-container" class="grid grid-cols-1 sm:grid-cols-2 gap-2.5">
      <!-- Loading Skeleton -->
      <div class="glass-card rounded-2xl p-4 animate-pulse space-y-2">
        <div class="h-4 bg-slate-800 rounded w-2/3"></div>
        <div class="h-3 bg-slate-800 rounded w-1/3"></div>
      </div>
    </div>
  </section>

  <!-- ========================================== -->
  <!-- TAB 4: CONVIVIENTES & ESTADÍSTICAS -->
  <!-- ========================================== -->
  <section id="view-roommates" class="tab-view hidden space-y-4">
    <!-- Header with Add Roommate button -->
    <div class="flex items-center justify-between gap-3">
      <div>
        <h2 class="text-base sm:text-lg font-bold text-white tracking-tight flex items-center gap-2">
          <span>👥</span> Convivientes
        </h2>
        <p class="text-xs text-slate-400 font-medium">
          Gestiona las personas de la casa
        </p>
      </div>

      <button
        id="btn-open-new-user-modal"
        class="fixed bottom-24 right-4 sm:bottom-24 sm:right-6 z-40 inline-flex items-center gap-1.5 px-4 py-3 rounded-full bg-gradient-to-r from-purple-600 to-indigo-600 hover:from-purple-500 hover:to-indigo-500 text-white text-sm font-bold shadow-xl shadow-purple-600/40 active:scale-95 transition"
        title="Añadir Conviviente"
      >
        <span class="text-xl leading-none">+</span>
        <span>Añadir Conviviente</span>
      </button>
    </div>

    <!-- Roommates Cards List -->
    <div>
      <h3 class="text-xs font-bold text-slate-400 uppercase tracking-wider mb-2 px-1">
        Lista de Convivientes
      </h3>
      <div id="roommates-cards-container" class="grid grid-cols-1 sm:grid-cols-2 gap-2.5 pb-20">
        <!-- Rendered by JS -->
      </div>
    </div>
  </section>

  <!-- ========================================== -->
  <!-- TAB 3: LISTA DE LA COMPRA (SUPERMERCADO) -->
  <!-- ========================================== -->
  <section id="view-shopping" class="tab-view hidden space-y-4">
    <!-- Header & Sub-Tabs pegajosos (siempre visibles al hacer scroll) -->
    <div class="shopping-sticky-header space-y-2">
      <div class="flex items-center justify-between gap-3">
        <h2 class="text-base sm:text-lg font-bold text-white tracking-tight flex items-center gap-2">
          <span>🛒</span> Lista de la Compra
        </h2>

        <div class="flex items-center gap-1.5">
          <button
            id="btn-shopping-clear-bought"
            type="button"
            class="hidden text-[11px] px-2.5 py-1.5 rounded-xl bg-slate-800 hover:bg-rose-950/40 text-slate-300 hover:text-rose-300 border border-slate-700/60 hover:border-rose-500/30 font-semibold transition active:scale-95"
            title="Borrar productos ya comprados del carro"
          >
            🧹 Limpiar comprados
          </button>
        </div>
      </div>

      <!-- Sub-Tabs: [ 🛒 Lista de la compra (X) ] | [ 📦 Artículos en uso (Y) ] -->
      <div class="inline-flex p-1 rounded-2xl bg-slate-800/80 border border-slate-700/60 text-xs font-semibold w-full shadow-inner">
        <button
          id="shopping-subtab-btn-list"
          type="button"
          class="shopping-subtab-btn flex-1 py-2 rounded-xl bg-emerald-600 text-white font-bold transition shadow-sm flex items-center justify-center gap-1.5"
        >
          <span>🛒 Lista de la compra</span>
          <span id="badge-subtab-shopping-count" class="px-1.5 py-0.2 bg-emerald-950/60 text-emerald-200 border border-emerald-400/30 rounded-full text-[10px] font-extrabold">0</span>
        </button>
        <button
          id="shopping-subtab-btn-catalog"
          type="button"
          class="shopping-subtab-btn flex-1 py-2 rounded-xl text-slate-400 hover:text-white font-semibold transition flex items-center justify-center gap-1.5"
        >
          <span>📦 Artículos en uso</span>
          <span id="badge-subtab-catalog-count" class="px-1.5 py-0.2 bg-slate-900/60 text-slate-400 rounded-full text-[10px]">0</span>
        </button>
      </div>
    </div>

    <!-- ========================================== -->
    <!-- SUB-PANEL 1: LISTA ACTIVA DE LA COMPRA -->
    <!-- ========================================== -->
    <div id="shopping-panel-list" class="space-y-3">
      <!-- Category Filter pills -->
      <div id="shopping-category-filter" class="flex items-center gap-1.5 overflow-x-auto pb-1 text-xs">
        <!-- Filter buttons: Todas, Fruta, Lácteos... -->
      </div>

      <!-- Shopping Status Bar -->
      <div id="shopping-status-bar" class="flex items-center justify-between text-xs px-1 text-slate-400">
        <span id="shopping-pending-count-label">0 artículos por comprar</span>
        <span id="shopping-active-shopper" class="text-slate-500"></span>
      </div>

      <!-- Pending Shopping Items (Grouped by Category) -->
      <div id="shopping-pending-container" class="space-y-3 pb-4">
        <!-- Rendered by JS -->
      </div>

      <!-- Bought Items Section (Collapsible) -->
      <div id="shopping-bought-wrapper" class="hidden space-y-2 pt-3 border-t border-slate-800">
        <div class="flex items-center justify-between">
          <button
            id="btn-toggle-bought-section"
            type="button"
            class="flex items-center gap-1.5 text-xs font-bold text-slate-400 hover:text-slate-200 transition"
          >
            <span id="bought-chevron" class="text-[10px]">▼</span>
            <span>Ya en el carro (<span id="shopping-bought-count">0</span>)</span>
          </button>
        </div>

        <div id="shopping-bought-container" class="space-y-1.5">
          <!-- Rendered by JS -->
        </div>
      </div>

      <!-- Botón Finalizar Compra y Vaciar Lista Completa -->
      <div class="pt-6 pb-32 sm:pb-24 text-center">
        <button
          id="btn-shopping-finish-all"
          type="button"
          class="w-full sm:w-auto px-6 py-3.5 rounded-2xl bg-gradient-to-r from-emerald-600 via-teal-600 to-indigo-600 hover:from-emerald-500 hover:to-indigo-500 text-white text-sm font-black shadow-xl shadow-emerald-950/40 transition active:scale-95 inline-flex items-center justify-center gap-2 mx-auto"
        >
          <span class="text-base">🏁</span>
          <span>Finalizar compra y vaciar lista</span>
        </button>
        <p class="text-[11px] text-slate-400 mt-2 font-medium">
          Vacía los pendientes y el carro. Tus artículos en uso seguirán intactos para la próxima compra.
        </p>
      </div>
    </div>

    <!-- ========================================== -->
    <!-- SUB-PANEL 2: ARTÍCULOS EN USO (DESPENSA / CATÁLOGO A-Z) -->
    <!-- ========================================== -->
    <div id="shopping-panel-catalog" class="hidden space-y-3">
      <!-- Search in catalog and quick add -->
      <div class="glass-card rounded-2xl p-3 border border-indigo-500/30 bg-slate-900/90 shadow-xl shadow-indigo-950/20 space-y-2">
        <form id="form-catalog-search" class="flex items-center gap-2">
          <div class="relative flex-1">
            <span class="absolute left-3 top-1/2 -translate-y-1/2 text-slate-400 text-sm">🔍</span>
            <input
              type="text"
              id="input-catalog-search"
              placeholder="Buscar o crear artículo... (A-Z)"
              class="w-full bg-slate-800 border border-slate-700 rounded-xl pl-9 pr-9 py-2 text-sm text-white placeholder-slate-500 focus:outline-none focus:ring-2 focus:ring-indigo-500 transition"
              autocomplete="off"
            />
            <button
              id="btn-catalog-clear-search"
              type="button"
              class="hidden absolute right-3 top-1/2 -translate-y-1/2 text-slate-400 hover:text-white text-base leading-none p-1"
            >&times;</button>
          </div>
          <button
            type="submit"
            id="btn-catalog-quick-add"
            class="px-3.5 py-2 rounded-xl bg-indigo-600 hover:bg-indigo-500 text-white font-bold text-xs shadow-md shadow-indigo-600/30 transition active:scale-95 flex items-center gap-1 shrink-0"
            title="Crear y pasar a la compra"
          >
            <span>+</span>
            <span class="hidden xs:inline">Crear</span>
          </button>
        </form>

