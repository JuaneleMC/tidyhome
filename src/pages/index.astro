  // 2. RENDER ARTÍCULOS EN USO (Catálogo permanente A-Z con estado de color en vivo si ya están en la compra)
  function renderShoppingCatalog() {
    const container = document.getElementById('shopping-catalog-container');
    const catFilterContainer = document.getElementById('catalog-category-filter');
    const clearSearchBtn = document.getElementById('btn-catalog-clear-search');

    if (!container) return;

    if (clearSearchBtn) {
      clearSearchBtn.classList.toggle('hidden', !catalogSearchQuery);
    }

    // Filtrar catálogo por búsqueda y categoría
    const normalizedQuery = catalogSearchQuery
      .toLowerCase()
      .normalize('NFD')
      .replace(/[\u0300-\u036f]/g, '')
      .trim();

    let filtered = shoppingCatalogList.filter((item) => {
      if (catalogCategoryFilter !== 'all' && (item.category || 'Otros') !== catalogCategoryFilter) {
        return false;
      }
      if (normalizedQuery) {
        const normName = item.name
          .toLowerCase()
          .normalize('NFD')
          .replace(/[\u0300-\u036f]/g, '');
        return normName.includes(normalizedQuery);
      }
      return true;
    });

    // Render Category Filter Pills for Catalog
    if (catFilterContainer) {
      const allCategories = Array.from(new Set(shoppingCatalogList.map((i) => i.category || 'Otros')));
      catFilterContainer.innerHTML = `
        <button
          type="button"
          class="btn-catalog-cat-filter px-3 py-1 rounded-lg text-xs font-semibold transition ${
            catalogCategoryFilter === 'all'
              ? 'bg-indigo-600 text-white shadow-sm'
              : 'bg-slate-800 text-slate-400 hover:text-white'
          }"
          data-cat="all"
        >
          Todos (${shoppingCatalogList.length})
        </button>
        ${allCategories
          .map((cat) => {
            const count = shoppingCatalogList.filter((i) => (i.category || 'Otros') === cat).length;
            const meta = SHOPPING_CATEGORIES_DATA[cat] || SHOPPING_CATEGORIES_DATA['Otros'];
            const isActive = catalogCategoryFilter === cat;
            return `
              <button
                type="button"
                class="btn-catalog-cat-filter shrink-0 inline-flex items-center gap-1 px-2.5 py-1 rounded-lg text-xs font-medium border transition ${
                  isActive
                    ? 'bg-indigo-600 text-white border-indigo-500 shadow-sm'
                    : 'bg-slate-800/80 text-slate-300 hover:text-white border-slate-700/60'
                }"
                data-cat="${escHtml(cat)}"
              >
                <span>${meta.icon}</span>
                <span>${escHtml(cat)}</span>
                <span class="text-[10px] px-1 py-0.2 rounded bg-slate-900/60 font-bold">${count}</span>
              </button>
            `;
          })
          .join('')}
      `;

      catFilterContainer.querySelectorAll('.btn-catalog-cat-filter').forEach((btn) => {
        btn.addEventListener('click', () => {
          catalogCategoryFilter = btn.getAttribute('data-cat') || 'all';
          renderShoppingCatalog();
        });
      });
    }

    // Render Items
    if (filtered.length === 0) {
      if (catalogSearchQuery) {
        container.innerHTML = `
          <div class="glass-card rounded-2xl p-6 text-center space-y-3 border border-indigo-500/40 bg-slate-900/90 shadow-xl">
            <div class="text-3xl">🔍</div>
            <h4 class="text-sm font-bold text-white">No está en tus Artículos en uso</h4>
            <p class="text-xs text-slate-400 max-w-sm mx-auto">
              No encontramos "<strong>${escHtml(catalogSearchQuery)}</strong>". ¿Quieres añadirlo ahora a tus artículos habituales y pasarlo a la compra?
            </p>
            <button
              type="button"
              id="btn-quick-create-catalog"
              class="px-4 py-2.5 rounded-xl bg-gradient-to-r from-emerald-600 to-teal-600 hover:from-emerald-500 hover:to-teal-500 text-white text-xs font-bold shadow-lg shadow-emerald-600/30 transition active:scale-95 inline-flex items-center gap-1.5"
            >
              <span>+</span>
              <span>Añadir "${escHtml(catalogSearchQuery)}" a Artículos en uso y a la lista</span>
            </button>
          </div>
        `;

        document.getElementById('btn-quick-create-catalog')?.addEventListener('click', async () => {
          await createAndAddCatalogItem(catalogSearchQuery);
        });
      } else {
        container.innerHTML = `
          <div class="glass-card rounded-2xl p-6 text-center text-slate-400 text-xs">
            No hay artículos en uso en esta categoría.
          </div>
        `;
      }
      return;
    }

    // Ordenar alfabéticamente A-Z
    filtered.sort((a, b) => a.name.localeCompare(b.name, 'es', { sensitivity: 'base' }));

    // Agrupar por letra inicial para una navegación limpia
    const letterGroups = new Map<string, any[]>();
    for (const item of filtered) {
      const firstLetter = item.name.charAt(0).toUpperCase();
      if (!letterGroups.has(firstLetter)) letterGroups.set(firstLetter, []);
      letterGroups.get(firstLetter)!.push(item);
    }

    container.innerHTML = Array.from(letterGroups.entries())
      .map(([letter, items]) => `
        <div class="space-y-1.5">
          <div class="px-2 pt-1 text-xs font-black text-slate-500 tracking-wider">
            ${escHtml(letter)}
          </div>

          <div class="grid grid-cols-1 sm:grid-cols-2 gap-2">
            ${items
              .map((item) => {
                const meta = SHOPPING_CATEGORIES_DATA[item.category] || SHOPPING_CATEGORIES_DATA['Otros'];
                const inList = Boolean(item.inShoppingList);

                return `
                  <div
                    class="glass-card rounded-2xl p-3 flex items-center justify-between gap-2.5 transition duration-200 ${
                      inList
                        ? 'bg-emerald-500/15 border-emerald-500/80 ring-2 ring-emerald-500/40 shadow-md shadow-emerald-950/20'
                        : 'border-slate-700/60 hover:border-slate-500 bg-slate-900/60'
                    }"
                    id="catalog-card-${item.id}"
                  >
                    <!-- Left: Info and Tap Action -->
                    <div
                      class="btn-catalog-card-tap flex items-center gap-2.5 min-w-0 flex-1 cursor-pointer select-none"
                      data-id="${item.id}"
                      data-inlist="${inList}"
                    >
                      <div class="w-9 h-9 rounded-xl flex items-center justify-center text-xl shrink-0 ${
                        inList ? 'bg-emerald-500/20 text-emerald-300' : 'bg-slate-800 text-slate-300'
                      }">
                        ${meta.icon}
                      </div>

                      <div class="min-w-0 flex-1">
                        <div class="flex items-center gap-1.5 flex-wrap leading-tight">
                          <span class="text-sm font-bold ${inList ? 'text-emerald-200' : 'text-white'} break-words">
                            ${escHtml(item.name)}
                          </span>
                          ${
                            inList
                              ? `<span class="text-[10px] px-2 py-0.5 rounded-full font-black bg-emerald-500 text-slate-950 flex items-center gap-0.5 shadow-sm">
                                  <span>✓</span> En la compra
                                 </span>`
                              : ''
                          }
                        </div>

                        <div class="flex items-center gap-1.5 mt-0.5 text-[11px] text-slate-400">
                          <span>${escHtml(item.category)}</span>
                          <span>•</span>
                          <span class="text-slate-300 font-medium">Unidad: <strong>${escHtml(item.defaultUnit || 'ud')}</strong></span>
                        </div>
                      </div>
                    </div>

                    <!-- Right Controls -->
                    <div class="shrink-0 flex items-center gap-1">
                      ${
                        inList
                          ? `
                            <!-- Si ya está en la compra: Stepper rápido en la misma tarjeta -->
                            <div class="inline-flex items-center rounded-xl bg-slate-800/90 border border-emerald-500/50 p-0.5 shadow-sm">
                              <button
                                type="button"
                                class="btn-catalog-step-down w-6 h-6 rounded-lg text-slate-300 hover:text-rose-400 hover:bg-slate-700/50 flex items-center justify-center font-bold text-xs transition active:scale-90"
                                data-shopping-id="${item.shoppingItemId}"
                                data-qty="${item.currentQty || 1}"
                                title="Disminuir (o quitar si es 1)"
                              >
                                ${Number(item.currentQty || 1) <= 1 ? '🗑' : '−'}
                              </button>
                              <span class="font-extrabold text-xs px-1.5 text-emerald-300">
                                ${escHtml(item.currentQty || 1)}
                              </span>
                              <button
                                type="button"
                                class="btn-catalog-step-up w-6 h-6 rounded-lg text-slate-300 hover:text-emerald-400 hover:bg-slate-700/50 flex items-center justify-center font-bold text-xs transition active:scale-90"
                                data-shopping-id="${item.shoppingItemId}"
                                data-qty="${item.currentQty || 1}"
                                title="Aumentar cantidad en la compra"
                              >
                                +
                              </button>
                            </div>
                          `
                          : `
                            <!-- Si no está: botón añadir con 1 toque -->
                            <button
                              type="button"
                              class="btn-quick-add-from-catalog px-3 py-1.5 rounded-xl bg-emerald-600/20 hover:bg-emerald-600 text-emerald-300 hover:text-white border border-emerald-500/40 text-xs font-bold transition active:scale-95 flex items-center gap-1 shrink-0"
                              data-id="${item.id}"
                              title="Añadir a la lista de la compra"
                            >
                              <span class="text-base leading-none">+</span>
                              <span>Añadir</span>
                            </button>
                          `
                      }

                      <!-- Botón para editar artículo genérico del catálogo -->
                      <button
                        type="button"
                        class="btn-edit-catalog-item p-1.5 text-slate-500 hover:text-indigo-400 hover:bg-slate-800 rounded-lg transition shrink-0"
                        data-id="${item.id}"
                        title="Editar nombre o unidad por defecto"
                      >
                        <svg class="w-3.5 h-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15.232 5.232l3.536 3.536m-2.036-5.036a2.5 2.5 0 113.536 3.536L6.5 21.036H3v-3.572L16.732 3.732z" />
                        </svg>
                      </button>
                    </div>
                  </div>
                `;
              })
              .join('')}
          </div>
        </div>
      `)
      .join('');

    attachCatalogActionListeners();
  }

  function attachShoppingActionListeners() {
    // Checkbox bought toggle
    document.querySelectorAll('.btn-toggle-shopping-item').forEach((btn) => {
      btn.addEventListener('click', async (e) => {
        e.stopPropagation();
        const id = Number(btn.getAttribute('data-id'));
        const isBought = btn.getAttribute('data-bought') === 'true';
        await toggleShoppingItem(id, isBought);
      });
    });

    // Stepper down in shopping list
    document.querySelectorAll('.btn-shopping-step-down').forEach((btn) => {
      btn.addEventListener('click', async (e) => {
        e.stopPropagation();
        const id = Number(btn.getAttribute('data-id'));
        const currentQty = parseInt(btn.getAttribute('data-qty') || '1', 10);
        if (currentQty <= 1) {
          await deleteShoppingItem(id);
        } else {
          await updateShoppingItemQty(id, currentQty - 1);
        }
      });
    });

    // Stepper up in shopping list
    document.querySelectorAll('.btn-shopping-step-up').forEach((btn) => {
      btn.addEventListener('click', async (e) => {
        e.stopPropagation();
        const id = Number(btn.getAttribute('data-id'));
        const currentQty = parseInt(btn.getAttribute('data-qty') || '1', 10);
        await updateShoppingItemQty(id, currentQty + 1);
      });
    });

    // Direct quantity input in shopping list
    document.querySelectorAll('.input-shopping-item-qty').forEach((inp) => {
      inp.addEventListener('change', async () => {
        const inputEl = inp as HTMLInputElement;
        const id = Number(inputEl.getAttribute('data-id'));
        const val = Math.max(1, parseInt(inputEl.value || '1', 10));
        await updateShoppingItemQty(id, val);
      });
    });

    // Change unit chip
    document.querySelectorAll('.btn-open-change-unit').forEach((btn) => {
      btn.addEventListener('click', (e) => {
        e.stopPropagation();
        const id = Number(btn.getAttribute('data-id'));
        const type = (btn.getAttribute('data-type') || 'shopping') as 'shopping' | 'catalog';
        const name = btn.getAttribute('data-name') || '';
        const unit = btn.getAttribute('data-unit') || 'ud';
        openChangeUnitModal(id, type, name, unit);
      });
    });

    // Delete item
    document.querySelectorAll('.btn-delete-shopping-item').forEach((btn) => {
      btn.addEventListener('click', async (e) => {
        e.stopPropagation();
        const id = Number(btn.getAttribute('data-id'));
        await deleteShoppingItem(id);
      });
    });
  }

  function attachCatalogActionListeners() {
    // Quick Add button from catalog
    document.querySelectorAll('.btn-quick-add-from-catalog').forEach((btn) => {
      btn.addEventListener('click', async (e) => {
        e.stopPropagation();
        const id = Number(btn.getAttribute('data-id'));
        await addFromCatalog(id);
      });
    });

    // Tap on card body: if not in list, add it! If already in list, increase qty!
    document.querySelectorAll('.btn-catalog-card-tap').forEach((cardTap) => {
      cardTap.addEventListener('click', async () => {
        const id = Number(cardTap.getAttribute('data-id'));
        await addFromCatalog(id);
      });
    });

    // Stepper down in catalog card
    document.querySelectorAll('.btn-catalog-step-down').forEach((btn) => {
      btn.addEventListener('click', async (e) => {
        e.stopPropagation();
        const shoppingId = Number(btn.getAttribute('data-shopping-id'));
        const currentQty = parseInt(btn.getAttribute('data-qty') || '1', 10);
        if (currentQty <= 1) {
          await deleteShoppingItem(shoppingId);
        } else {
          await updateShoppingItemQty(shoppingId, currentQty - 1);
        }
      });
    });

    // Stepper up in catalog card
    document.querySelectorAll('.btn-catalog-step-up').forEach((btn) => {
      btn.addEventListener('click', async (e) => {
        e.stopPropagation();
        const shoppingId = Number(btn.getAttribute('data-shopping-id'));
        const currentQty = parseInt(btn.getAttribute('data-qty') || '1', 10);
        await updateShoppingItemQty(shoppingId, currentQty + 1);
      });
    });

    // Edit catalog item
    document.querySelectorAll('.btn-edit-catalog-item').forEach((btn) => {
      btn.addEventListener('click', (e) => {
        e.stopPropagation();
        const id = Number(btn.getAttribute('data-id'));
        openEditCatalogModal(id);
      });
    });
  }

  // ACCIONES DE COMPRA Y CATÁLOGO

  async function addFromCatalog(catalogId: number) {
    try {
      const res = await fetch('/api/shopping', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({
          catalogId,
          addedBy: activeUser?.id,
        }),
      });

      const data = await res.json();
      if (data.success) {
        showToast(data.updatedQty ? `Cantidad aumentada en la compra 🛒` : `Añadido a la compra 🛒`, 'success');
        await loadShoppingList();
        await loadShoppingCatalog();
      } else {
        showToast(data.error || 'Error al añadir', 'error');
      }
    } catch (err) {
      showToast('Error de conexión', 'error');
    }
  }

  async function createAndAddCatalogItem(name: string) {
    if (!name || !name.trim()) return;

    try {
      const res = await fetch('/api/shopping/catalog', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({
          name: name.trim(),
          addToListImmediately: true,
          addedBy: activeUser?.id,
        }),
      });

      const data = await res.json();
      if (data.success) {
        showToast(`"${name.trim()}" guardado en artículos en uso y en la compra 🛒`, 'success');
        catalogSearchQuery = '';
        const searchInput = document.getElementById('input-catalog-search') as HTMLInputElement | null;
        if (searchInput) searchInput.value = '';
        await loadShoppingCatalog();
        await loadShoppingList();
      } else {
        showToast(data.error || 'Error al crear artículo', 'error');
      }
    } catch (err) {
      showToast('Error de conexión', 'error');
    }
  }

  async function addShoppingItem(name: string, category?: string, quantity?: string, unit?: string, notes?: string) {
    if (!name || !name.trim()) return;

    try {
      const res = await fetch('/api/shopping', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({
          name: name.trim(),
          category: category && category !== 'auto' ? category : undefined,
          quantity: quantity?.trim() || '1',
          unit: unit?.trim() || undefined,
          notes: notes?.trim() || undefined,
          addedBy: activeUser?.id,
        }),
      });

      const data = await res.json();
      if (data.success) {
        showToast(`"${name.trim()}" añadido a la compra 🛒`, 'success');
        await loadShoppingList();
        await loadShoppingCatalog();
      } else {
        showToast(data.error || 'Error al añadir artículo', 'error');
      }
    } catch (err) {
      showToast('Error de conexión', 'error');
    }
  }

  async function updateShoppingItemQty(id: number, newQty: number) {
    // Optimistic update
    const item = shoppingItemsList.find((i) => i.id === id);
    if (item) {
      item.quantity = String(newQty);
      renderShoppingList();
      renderShoppingCatalog();
    }

    try {
      const res = await fetch(`/api/shopping/${id}`, {
        method: 'PATCH',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ quantity: String(newQty) }),
      });
      const data = await res.json();
      if (!data.success) {
        showToast('Error al actualizar cantidad', 'error');
        await loadShoppingList();
        await loadShoppingCatalog();
      }
    } catch (err) {
      showToast('Error de conexión', 'error');
      await loadShoppingList();
      await loadShoppingCatalog();
    }
  }

  async function toggleShoppingItem(id: number, isBought: boolean) {
    // Optimistic update
    const item = shoppingItemsList.find((i) => i.id === id);
    if (item) {
      item.isBought = isBought;
      item.boughtById = isBought && activeUser ? activeUser.id : null;
      item.boughtByName = isBought && activeUser ? activeUser.name : null;
      item.boughtByAvatar = isBought && activeUser ? activeUser.avatar : null;
      updateShoppingBadge();
      renderShoppingList();
      renderShoppingCatalog();
    }

    try {
      const res = await fetch(`/api/shopping/${id}`, {
        method: 'PATCH',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({
          isBought,
          boughtBy: isBought && activeUser ? activeUser.id : null,
        }),
      });
      const data = await res.json();
      if (!data.success) {
        showToast('Error al actualizar artículo', 'error');
        await loadShoppingList();
        await loadShoppingCatalog();
      }
    } catch (err) {
      showToast('Error de conexión', 'error');
      await loadShoppingList();
      await loadShoppingCatalog();
    }
  }

  async function deleteShoppingItem(id: number) {
    try {
      const res = await fetch(`/api/shopping/${id}`, { method: 'DELETE' });
      const data = await res.json();
      if (data.success) {
        shoppingItemsList = shoppingItemsList.filter((i) => i.id !== id);
        updateShoppingBadge();
        renderShoppingList();
        await loadShoppingCatalog();
      } else {
        showToast(data.error || 'Error al eliminar', 'error');
      }
    } catch (err) {
      showToast('Error de conexión', 'error');
    }
  }

  async function clearBoughtShoppingItems() {
    try {
      const res = await fetch('/api/shopping/clear-bought', { method: 'POST' });
      const data = await res.json();
      if (data.success) {
        showToast('Artículos comprados archivados ✅ (Tus artículos en uso siguen intactos)', 'success');
        await loadShoppingList();
        await loadShoppingCatalog();
      } else {
        showToast(data.error || 'Error al limpiar', 'error');
      }
    } catch (err) {
      showToast('Error de conexión', 'error');
    }
  }

  // MODALES DE UNIDAD Y EDICIÓN DE CATÁLOGO

  function openAddOneOffModal() {
    const modal = document.getElementById('modal-add-one-off-shopping');
    const inputName = document.getElementById('input-one-off-name') as HTMLInputElement | null;
    const inputQty = document.getElementById('input-one-off-qty') as HTMLInputElement | null;
    const inputUnit = document.getElementById('input-one-off-unit') as HTMLInputElement | null;
    const inputNotes = document.getElementById('input-one-off-notes') as HTMLInputElement | null;
    const checkCatalog = document.getElementById('check-one-off-save-catalog') as HTMLInputElement | null;
    const selectCat = document.getElementById('select-one-off-category') as HTMLSelectElement | null;

    if (!modal) return;
    if (inputName) inputName.value = '';
    if (inputQty) inputQty.value = '1';
    if (inputUnit) inputUnit.value = '';
