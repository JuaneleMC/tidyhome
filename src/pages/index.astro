      )
      .join('');

    container.querySelectorAll('.btn-history-catalog-chore').forEach((btn) => {
      btn.addEventListener('click', (e) => {
        e.stopPropagation();
        const id = Number(btn.getAttribute('data-id'));
        openChoreHistoryModal(id);
      });
    });

    container.querySelectorAll('.btn-edit-catalog-chore').forEach((btn) => {
      btn.addEventListener('click', (e) => {
        e.stopPropagation();
        const id = Number(btn.getAttribute('data-id'));
        openEditChoreModal(id);
      });
    });

    container.querySelectorAll('.btn-delete-catalog-chore').forEach((btn) => {
      btn.addEventListener('click', async () => {
        const id = Number(btn.getAttribute('data-id'));
        const name = btn.getAttribute('data-name');
        if (confirm(`¿Deseas eliminar "${name}" de la lista de tareas?`)) {
          await deleteCatalogChore(id);
        }
      });
    });
  }

  async function deleteCatalogChore(id: number) {
    try {
      const res = await fetch(`/api/catalog/${id}`, { method: 'DELETE' });
      const data = await res.json();
      if (data.success) {
        showToast('Tarea eliminada del catálogo', 'info');
        await loadCatalog();
      } else {
        showToast(data.error || 'Error al eliminar', 'error');
      }
    } catch (err) {
      showToast('Error de conexión', 'error');
    }
  }

  // ==========================================
  // VISTA 4: CONVIVIENTES (CARGA Y RENDER)
  // ==========================================
  
  // ==========================================
  // HISTORIAL DE TAREAS DEL CATÁLOGO
  // ==========================================
  async function openChoreHistoryModal(choreId: number) {
    const modal = document.getElementById('modal-chore-history');
    const titleEl = document.getElementById('hist-chore-title');
    const iconEl = document.getElementById('hist-chore-icon');
    const freqEl = document.getElementById('hist-chore-freq');
    const totalEl = document.getElementById('hist-total-count');
    const lastDoneEl = document.getElementById('hist-last-done');
    const listEl = document.getElementById('hist-list-container');

    if (!modal || !titleEl || !listEl) return;

    modal.classList.remove('hidden');
    modal.classList.add('flex');
    listEl.innerHTML = '<div class="py-6 text-center text-xs text-slate-500 animate-pulse">Cargando historial...</div>';

    try {
      const res = await fetch(`/api/catalog/${choreId}/history`);
      const data = await res.json();

      if (!data.success) {
        listEl.innerHTML = `<div class="py-4 text-center text-xs text-rose-400">${escHtml(data.error)}</div>`;
        return;
      }

      if (titleEl) titleEl.textContent = data.chore.name;
      if (iconEl) iconEl.textContent = data.chore.icon || '🧹';
      if (freqEl) freqEl.textContent = `${data.chore.category} · ${data.chore.frequency === 'once' ? 'Puntual' : data.chore.frequency}`;
      if (totalEl) totalEl.textContent = String(data.totalDone);

      if (lastDoneEl) {
        if (data.lastDone) {
          const parts = data.lastDone.targetDate.split('-').map(Number);
          const d = new Date(parts[0], parts[1] - 1, parts[2]);
          const dateStr = d.toLocaleDateString('es-ES', { day: 'numeric', month: 'short', year: 'numeric' });
          lastDoneEl.textContent = `${dateStr} por ${data.lastDone.executedByName || 'Conviviente'}`;
        } else {
          lastDoneEl.textContent = 'Nunca realizada';
        }
      }

      if (data.history.length === 0) {
        listEl.innerHTML = '<div class="py-6 text-center text-xs text-slate-500">Aún no se ha registrado ninguna ejecución de esta tarea.</div>';
      } else {
        listEl.innerHTML = data.history.map((h: any) => {
          const parts = h.targetDate.split('-').map(Number);
          const d = new Date(parts[0], parts[1] - 1, parts[2]);
          const dateFormatted = d.toLocaleDateString('es-ES', { weekday: 'short', day: 'numeric', month: 'short', year: 'numeric' });
          return `
            <div class="flex items-center justify-between p-2.5 rounded-xl bg-slate-800/60 border border-slate-700/50 text-xs">
              <div class="flex items-center gap-2">
                <span class="text-base">${escHtml(h.executedByAvatar || '👤')}</span>
                <div>
                  <span class="font-bold text-white block">${escHtml(h.executedByName || 'Conviviente')}</span>
                  <span class="text-[10px] text-slate-400">${dateFormatted}</span>
                </div>
              </div>
              <span class="text-[10px] px-2 py-0.5 rounded-full font-bold bg-emerald-500/15 text-emerald-400">
                ✓ Hecha
              </span>
            </div>
          `;
        }).join('');
      }
    } catch (err) {
      listEl.innerHTML = '<div class="py-4 text-center text-xs text-rose-400">Error al cargar historial</div>';
    }
  }

  function closeChoreHistoryModal() {
    const modal = document.getElementById('modal-chore-history');
    modal?.classList.add('hidden');
    modal?.classList.remove('flex');
  }

