  function renderCatalog() {
    const container = document.getElementById('catalog-list-container');
    if (!container) return;

    let list = [...catalogData];
    if (catalogFilterFreq !== 'all') {
      list = list.filter((c) => c.frequency === catalogFilterFreq);
    }
    list.sort((a, b) => a.name.localeCompare(b.name, 'es', { sensitivity: 'base' }));

    if (list.length === 0) {
      container.innerHTML = `
        <div class="col-span-full glass-card rounded-2xl p-8 text-center space-y-2">
          <div class="text-3xl">📭</div>
          <h4 class="text-sm font-bold text-white">No hay tareas en esta categoría</h4>
          <p class="text-xs text-slate-400">Pulsa "+ Nueva Tarea" para dar de alta una.</p>
        </div>
      `;
      return;
    }

    const freqLabels: Record<string, string> = {
      daily: 'Diaria',
      twice_weekly: '2 veces/sem',
      weekly: 'Semanal',
      biweekly: 'Quincenal',
      monthly: 'Mensual',
      once: 'Puntual',
    };

    const daysName = ['Domingo', 'Lunes', 'Martes', 'Miércoles', 'Jueves', 'Viernes', 'Sábado'];

    container.innerHTML = list
      .map(
        (item) => `
        <div class="glass-card glass-card-hover rounded-2xl p-4 flex items-start justify-between gap-3 border border-slate-700/60" id="catalog-card-${item.id}">
          <div class="flex items-start gap-3 min-w-0 flex-1">
            <div class="w-10 h-10 rounded-xl bg-slate-800 flex items-center justify-center text-xl shrink-0">
              ${item.icon || '🧹'}
            </div>

            <div class="min-w-0 flex-1">
              <h4 class="text-sm font-bold text-white tracking-tight break-words leading-snug">${item.name}</h4>
              <div class="flex items-center gap-1.5 flex-wrap mt-1">
                <span class="text-[10px] px-2 py-0.5 rounded-md font-semibold bg-indigo-500/20 text-indigo-300 border border-indigo-500/30">
                  ${freqLabels[item.frequency] || item.frequency}
                </span>
                <span class="text-[10px] px-1.5 py-0.5 rounded-md bg-slate-800 text-slate-400">
                  ${item.category}
                </span>
                ${
                  item.frequency === 'once'
                    ? `<span class="text-[10px] px-2 py-0.5 rounded-md font-semibold bg-emerald-500/20 text-emerald-300 border border-emerald-500/30">
                        ⚡ Puntual
                       </span>`
                    : item.assignmentMode === 'rotating'
                    ? `<span class="text-[10px] px-2 py-0.5 rounded-md font-bold bg-purple-500/20 text-purple-300 border border-purple-500/30">
                        🔄 Rotativa semanal
                       </span>`
                    : `<span class="text-[10px] px-2 py-0.5 rounded-md font-medium bg-slate-800 text-slate-400">
                        📌 Asignación fija
                       </span>`
                }
              </div>

              ${
