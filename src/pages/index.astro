                  ? ''
                  : `
              <div class="flex items-center gap-2 mt-2 text-[11px] text-slate-400 flex-wrap">
                <span>${item.assignmentMode === 'rotating' ? 'Punto de partida:' : 'Responsable:'}</span>
                <span class="inline-flex items-center gap-1 font-semibold text-slate-200">
                  <span>${item.assigneeAvatar || '👤'}</span>
