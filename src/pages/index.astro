  // MÓDULO GARAJE / VEHÍCULOS
  // ==========================================
  async function loadGarage() {
    try {
      const res = await fetch('/api/garage');
      const data = await res.json();
      if (!data.success) {
        showToast(data.error || 'Error al cargar garaje', 'error');
        return;
      }

      garageData = data.vehicles || [];

      // Check global alert badge for garage
      const totalOverdue = garageData.reduce((acc, v) => acc + (v.overdueCount || 0) + (v.needsKmUpdate ? 1 : 0), 0);
      const garageAlertBadge = document.getElementById('badge-garage-alert');
      if (garageAlertBadge) {
        garageAlertBadge.classList.toggle('hidden', totalOverdue === 0);
      }

      // Restore active vehicle or default to first
      if (garageData.length > 0) {
        if (!activeVehicleId || !garageData.find((v) => v.id === activeVehicleId)) {
          activeVehicleId = garageData[0].id;
        }
      } else {
        activeVehicleId = null;
      }

      renderGarageFleetPills();
      renderGarageActiveVehicle();
    } catch (err) {
      console.error('Error loading garage:', err);
      showToast('Error de conexión al cargar garaje', 'error');
    }
  }

  function renderGarageFleetPills() {
    const pillsContainer = document.getElementById('garage-fleet-pills');
    if (!pillsContainer) return;

    if (garageData.length === 0) {
      pillsContainer.innerHTML = '<span class="text-xs text-slate-500">No hay vehículos registrados</span>';
      return;
    }

    pillsContainer.innerHTML = garageData.map((v) => {
      const isActive = v.id === activeVehicleId;
      const hasAlert = (v.overdueCount > 0) || v.needsKmUpdate;
      return `
        <button
          type="button"
          data-vehicle-id="${v.id}"
          class="btn-garage-vehicle-pill shrink-0 flex items-center gap-1.5 px-3 py-1.5 rounded-xl border text-xs font-bold transition ${
            isActive
              ? 'bg-blue-600 text-white border-blue-500 shadow-md shadow-blue-600/30'
              : 'bg-slate-800/80 text-slate-300 border-slate-700/60 hover:border-slate-500'
          }"
        >
          <span>${escHtml(v.icon || '🚗')}</span>
          <span>${escHtml(v.name)}</span>
          ${hasAlert ? '<span class="w-2 h-2 rounded-full bg-rose-500 shrink-0"></span>' : ''}
        </button>
      `;
    }).join('');

    pillsContainer.querySelectorAll('.btn-garage-vehicle-pill').forEach((btn) => {
      btn.addEventListener('click', () => {
        activeVehicleId = Number(btn.getAttribute('data-vehicle-id'));
        renderGarageFleetPills();
        renderGarageActiveVehicle();
      });
    });
  }

