                }
                <button
                  class="btn-edit-roommate p-1.5 text-slate-500 hover:text-indigo-400 hover:bg-slate-800 rounded-lg transition shrink-0"
                  data-id="${u.id}"
                  title="Editar datos del conviviente"
                >
                  <svg class="w-4 h-4 pointer-events-none" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15.232 5.232l3.536 3.536m-2.036-5.036a2.5 2.5 0 113.536 3.536L6.5 21.036H3v-3.572L16.732 3.732z" />
                  </svg>
                </button>
                <button
                  class="btn-delete-roommate p-1.5 text-slate-500 hover:text-rose-400 hover:bg-slate-800 rounded-lg transition shrink-0"
                  data-id="${u.id}"
                  data-name="${u.name}"
                  title="Eliminar conviviente"
                >
                  <svg class="w-4 h-4 pointer-events-none" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16" />
                  </svg>
                </button>
              </div>
            </div>

            <div class="mt-3 pt-3 border-t border-slate-800 grid grid-cols-3 gap-2 text-center text-xs">
              <div class="p-1 rounded-lg bg-slate-800/40">
                <span class="text-[10px] text-slate-400 block">Asignadas</span>
                <span class="font-bold text-white">${uStat?.assignedCount ?? 0}</span>
              </div>
              <div class="p-1 rounded-lg bg-slate-800/40">
                <span class="text-[10px] text-slate-400 block">Hechas</span>
                <span class="font-bold text-emerald-400">${uStat?.totalDone ?? 0}</span>
              </div>
              <div class="p-1 rounded-lg bg-slate-800/40">
                <span class="text-[10px] text-slate-400 block">Robos ⚡</span>
                <span class="font-bold text-pink-400">${uStat?.stolenAndDoneCount ?? 0}</span>
              </div>
            </div>
          </div>
        `;
      })
      .join('');

    cardsEl.querySelectorAll('.btn-select-as-active').forEach((btn) => {
      btn.addEventListener('click', () => {
        const id = Number(btn.getAttribute('data-id'));
        setActiveUser(id);
        loadRoommates();
      });
    });

    cardsEl.querySelectorAll('.btn-edit-roommate').forEach((btn) => {
      btn.addEventListener('click', (e) => {
        e.stopPropagation();
        const id = Number(btn.getAttribute('data-id'));
        openEditUserModal(id);
      });
    });

    cardsEl.querySelectorAll('.btn-delete-roommate').forEach((btn) => {
      btn.addEventListener('click', async () => {
        const id = Number(btn.getAttribute('data-id'));
        const name = btn.getAttribute('data-name');
        if (confirm(`¿Eliminar a "${name}" de la casa? Sus tareas asociadas también se borrarán.`)) {
          try {
            const res = await fetch(`/api/users/${id}`, { method: 'DELETE' });
            const data = await res.json();
            if (data.success) {
              showToast(`Conviviente "${name}" eliminado`, 'success');
              await loadUsers();
              await loadRoommates();
              if (activeTab === 'dashboard') loadDashboard();
            } else {
              showToast(data.error || 'Error al eliminar', 'error');
