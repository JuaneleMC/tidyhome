  async function loadGarage() {
    try {
      const res = await fetch('/api/garage');
      const data = await res.json();
      if (!data.success) {
        showToast(data.error || 'Error al cargar garaje', 'error');
        return;
      }

      garageData = data.vehicles || [];

      // Check global alert badge for garage
      const totalOverdue = garageData.reduce((acc, v) => acc + (v.overdueCount || 0) + (v.needsKmUpdate ? 1 : 0), 0);
      const garageAlertBadge = document.getElementById('badge-garage-alert');
      if (garageAlertBadge) {
        garageAlertBadge.classList.toggle('hidden', totalOverdue === 0);
      }

      // Restore active vehicle or default to first
      if (garageData.length > 0) {
        if (!activeVehicleId || !garageData.find((v) => v.id === activeVehicleId)) {
          activeVehicleId = garageData[0].id;
        }
      } else {
        activeVehicleId = null;
      }

      renderGarageFleetPills();
      renderGarageActiveVehicle();
    } catch (err) {
      console.error('Error loading garage:', err);
      showToast('Error de conexión al cargar garaje', 'error');
    }
  }

  function renderGarageFleetPills() {
    const pillsContainer = document.getElementById('garage-fleet-pills');
    if (!pillsContainer) return;

    if (garageData.length === 0) {
      pillsContainer.innerHTML = '<span class="text-xs text-slate-500">No hay vehículos registrados</span>';
      return;
    }

    pillsContainer.innerHTML = garageData.map((v) => {
      const isActive = v.id === activeVehicleId;
      const hasAlert = (v.overdueCount > 0) || v.needsKmUpdate;
      return `
        <button
          type="button"
          data-vehicle-id="${v.id}"
          class="btn-garage-vehicle-pill shrink-0 flex items-center gap-1.5 px-3 py-1.5 rounded-xl border text-xs font-bold transition ${
            isActive
              ? 'bg-blue-600 text-white border-blue-500 shadow-md shadow-blue-600/30'
              : 'bg-slate-800/80 text-slate-300 border-slate-700/60 hover:border-slate-500'
          }"
        >
          <span>${escHtml(v.icon || '🚗')}</span>
          <span>${escHtml(v.name)}</span>
          ${hasAlert ? '<span class="w-2 h-2 rounded-full bg-rose-500 shrink-0"></span>' : ''}
        </button>
      `;
    }).join('');

    pillsContainer.querySelectorAll('.btn-garage-vehicle-pill').forEach((btn) => {
      btn.addEventListener('click', () => {
        activeVehicleId = Number(btn.getAttribute('data-vehicle-id'));
        renderGarageFleetPills();
        renderGarageActiveVehicle();
      });
    });
  }

  function renderGarageActiveVehicle() {
    const hero = document.getElementById('garage-vehicle-hero');
    if (!hero) return;

    const v = garageData.find((item) => item.id === activeVehicleId);
    if (!v) {
      hero.innerHTML = `
        <div class="py-8 text-center space-y-2">
          <div class="text-3xl">🚗</div>
          <h4 class="text-sm font-bold text-white">Sin vehículos en el garaje</h4>
          <p class="text-xs text-slate-400">Pulsa "+ Añadir Vehículo" para agregar tu primer coche o caravana.</p>
        </div>
      `;
      return;
    }

    // Badge counts
    const countOverdueEl = document.getElementById('badge-count-overdue');
    const countIncidentsEl = document.getElementById('badge-count-incidents');
    if (countOverdueEl) {
      countOverdueEl.textContent = String(v.overdueCount || 0);
      countOverdueEl.classList.toggle('hidden', (v.overdueCount || 0) === 0);
    }
    if (countIncidentsEl) {
      countIncidentsEl.textContent = String(v.openIncidentsCount || 0);
      countIncidentsEl.classList.toggle('hidden', (v.openIncidentsCount || 0) === 0);
    }

    // Hero card
    hero.innerHTML = `
      <!-- Cabecera del vehículo -->
      <div class="flex items-center justify-between gap-2.5">
        <div class="flex items-center gap-2.5 min-w-0">
          <div class="w-11 h-11 rounded-2xl bg-blue-600/20 border border-blue-500/30 flex items-center justify-center text-2xl shrink-0 shadow-inner">
            ${escHtml(v.icon || '🚗')}
          </div>
          <div class="min-w-0">
            <div class="flex items-center gap-1.5 flex-wrap">
              <h3 class="text-base font-bold text-white tracking-tight truncate">${escHtml(v.name)}</h3>
              ${v.plate ? `<span class="text-[11px] px-2 py-0.5 rounded-md bg-slate-800 text-slate-300 font-mono font-bold border border-slate-700/80 shrink-0">${escHtml(v.plate)}</span>` : ''}
            </div>
            <p class="text-[11px] text-slate-400 font-medium truncate mt-0.5">
              ${v.hasMileage ? `Última lectura: <span class="text-slate-300 font-semibold">${v.lastKmDate || 'Sin registro'}</span>` : 'Vehículo sin cuentakilómetros'}
            </p>
          </div>
        </div>

        <button
          type="button"
          class="btn-delete-active-vehicle text-slate-500 hover:text-rose-400 p-2 text-xs transition rounded-lg hover:bg-slate-800/60 shrink-0"
          data-id="${v.id}"
          data-name="${escHtml(v.name)}"
          title="Eliminar este vehículo"
        >
          🗑️
        </button>
      </div>

      <!-- Cuentakilómetros prominente y botón Actualizar -->
      ${
        v.hasMileage
          ? `
            <div class="flex items-center justify-between gap-3 p-3 rounded-xl bg-slate-800/60 border border-slate-700/50">
              <div class="min-w-0">
                <span class="text-[10px] font-bold text-slate-400 uppercase tracking-wider block">Cuentakilómetros actual</span>
                <div class="flex items-baseline gap-1 mt-0.5">
                  <span class="text-xl sm:text-2xl font-black text-blue-400 font-mono tracking-tight">${(v.currentKm || 0).toLocaleString('es-ES')}</span>
                  <span class="text-xs font-semibold text-slate-400">km</span>
                </div>
              </div>
              <button
                type="button"
                id="btn-hero-update-km"
                class="inline-flex items-center gap-1.5 px-3 py-1.5 rounded-xl bg-blue-600 hover:bg-blue-500 text-white text-xs font-bold shadow-md shadow-blue-600/30 transition shrink-0 active:scale-95"
              >
                <span>✏️</span>
                <span>Actualizar</span>
              </button>
            </div>
          `
          : ''
      }

      ${
        v.needsKmUpdate
          ? `
            <div class="p-2.5 rounded-xl bg-amber-500/15 border border-amber-500/30 flex items-center justify-between gap-2 text-xs text-amber-200">
              <div class="flex items-center gap-1.5">
                <span>⚠️</span>
                <span>Hace más de 30 días que no se anotan los kilómetros de este vehículo.</span>
              </div>
              <button
                type="button"
                id="btn-alert-update-km"
                class="px-2 py-0.5 rounded-md bg-amber-500 text-slate-900 font-bold text-[10px] shrink-0 active:scale-95"
              >
                Anotar
              </button>
            </div>
          `
          : ''
      }
    `;

    hero.querySelector('.btn-delete-active-vehicle')?.addEventListener('click', async (e) => {
      e.stopPropagation();
      const target = e.currentTarget as HTMLElement;
      const id = Number(target.getAttribute('data-id'));
      const name = target.getAttribute('data-name');
      if (confirm(`¿Eliminar definitivamente el vehículo "${name}" y todos sus mantenimientos e incidencias?`)) {
        try {
          const res = await fetch(`/api/garage/${id}`, { method: 'DELETE' });
          const data = await res.json();
          if (data.success) {
            showToast('Vehículo eliminado', 'info');
            activeVehicleId = null;
            await loadGarage();
          } else {
            showToast(data.error || 'Error al eliminar vehículo', 'error');
          }
        } catch {
          showToast('Error de conexión', 'error');
        }
      }
    });

    document.getElementById('btn-hero-update-km')?.addEventListener('click', openUpdateKmModal);
    document.getElementById('btn-alert-update-km')?.addEventListener('click', openUpdateKmModal);

    renderGarageSubpanels(v);
  }

  function setGarageSubtab(subtab: 'maint' | 'incidents' | 'history') {
    garageSubtab = subtab;
    const btnMaint = document.getElementById('garage-subtab-btn-maint');
    const btnInc = document.getElementById('garage-subtab-btn-incidents');
    const btnHist = document.getElementById('garage-subtab-btn-history');

    const panelMaint = document.getElementById('garage-panel-maint');
    const panelInc = document.getElementById('garage-panel-incidents');
    const panelHist = document.getElementById('garage-panel-history');

    [btnMaint, btnInc, btnHist].forEach((b) => {
      b?.classList.remove('bg-indigo-600', 'text-white', 'font-bold');
      b?.classList.add('text-slate-400');
    });

    [panelMaint, panelInc, panelHist].forEach((p) => p?.classList.add('hidden'));

    if (subtab === 'maint') {
      btnMaint?.classList.add('bg-indigo-600', 'text-white', 'font-bold');
      btnMaint?.classList.remove('text-slate-400');
      panelMaint?.classList.remove('hidden');
    } else if (subtab === 'incidents') {
      btnInc?.classList.add('bg-indigo-600', 'text-white', 'font-bold');
      btnInc?.classList.remove('text-slate-400');
      panelInc?.classList.remove('hidden');
    } else if (subtab === 'history') {
      btnHist?.classList.add('bg-indigo-600', 'text-white', 'font-bold');
      btnHist?.classList.remove('text-slate-400');
      panelHist?.classList.remove('hidden');
    }
  }

  function renderGarageSubpanels(v: any) {
    // 1. Mantenimientos
    const maintContainer = document.getElementById('garage-maint-list');
    if (maintContainer) {
      if (!v.maintenance || v.maintenance.length === 0) {
        maintContainer.innerHTML = `
          <div class="glass-card rounded-2xl p-6 text-center space-y-2">
            <div class="text-2xl">🔧</div>
            <p class="text-xs text-slate-400">Sin tareas de mantenimiento configuradas para este vehículo.</p>
            <button type="button" class="btn-inner-add-maint text-xs text-indigo-400 font-bold hover:underline">+ Añadir primera tarea</button>
          </div>
        `;
        maintContainer.querySelector('.btn-inner-add-maint')?.addEventListener('click', () => openNewMaintModal());
      } else {
        maintContainer.innerHTML = v.maintenance.map((m: any) => {
          const isOverdue = m.status === 'overdue';
          const isSoon = m.status === 'soon';

          let statusBadge = '';
          if (isOverdue) {
            statusBadge = '<span class="px-2 py-0.5 rounded-full text-[10px] font-bold bg-rose-500 text-white shadow-xs">⚠️ Vencida</span>';
          } else if (isSoon) {
            statusBadge = '<span class="px-2 py-0.5 rounded-full text-[10px] font-bold bg-amber-500 text-slate-900 shadow-xs">⏳ Próxima</span>';
          } else {
            statusBadge = '<span class="px-2 py-0.5 rounded-full text-[10px] font-bold bg-emerald-500/20 text-emerald-400 border border-emerald-500/30">✓ Al día</span>';
          }

          let remainingText = '';
          if (m.remainingKm !== null && m.remainingKm !== undefined) {
            if (m.remainingKm <= 0) {
              remainingText += `<span class="text-rose-400 font-bold">Excedida en ${Math.abs(m.remainingKm).toLocaleString('es-ES')} km</span>`;
            } else {
              remainingText += `Faltan ${m.remainingKm.toLocaleString('es-ES')} km`;
            }
          }
          if (m.remainingDays !== null && m.remainingDays !== undefined) {
            if (remainingText) remainingText += ' · ';
            if (m.remainingDays <= 0) {
              remainingText += `<span class="text-rose-400 font-bold">Excedida en ${Math.abs(m.remainingDays)} días</span>`;
            } else {
              remainingText += `Faltan ${m.remainingDays} días (${m.nextDueDate})`;
            }
          }

          let intervalsText = '';
          if (m.intervalKm) intervalsText += `Cada ${m.intervalKm.toLocaleString('es-ES')} km`;
          if (m.intervalMonths) {
            if (intervalsText) intervalsText += ' o ';
            intervalsText += `cada ${m.intervalMonths} meses`;
          }

          return `
            <div class="glass-card rounded-2xl p-3.5 border transition ${
              isOverdue
                ? 'border-rose-500/50 bg-rose-950/15'
                : isSoon
                ? 'border-amber-500/40 bg-amber-950/10'
                : 'border-slate-700/60'
            }">
              <div class="flex items-start justify-between gap-3">
                <div class="flex-1 min-w-0">
                  <div class="flex items-center gap-2 flex-wrap">
                    <h4 class="text-sm font-bold text-white truncate">${escHtml(m.name)}</h4>
                    ${statusBadge}
                  </div>
                  <p class="text-[11px] text-slate-400 mt-0.5 font-medium">${intervalsText || 'Sin periodicidad definida'}</p>
                  <p class="text-xs text-indigo-300 font-semibold mt-1.5">${remainingText || 'Al día'}</p>
                  <div class="text-[10px] text-slate-400 mt-1">
                    Última vez: ${m.lastDoneDate || 'Nunca registrada'} ${m.lastDoneKm ? `(${m.lastDoneKm.toLocaleString('es-ES')} km)` : ''}
                  </div>
                </div>

                <div class="flex flex-col items-end gap-1.5 shrink-0">
                  <button
                    type="button"
                    class="btn-maint-execute px-3 py-1.5 rounded-xl bg-indigo-600 hover:bg-indigo-500 text-white text-xs font-bold shadow-md shadow-indigo-600/30 transition active:scale-95"
                    data-id="${m.id}"
                    data-name="${escHtml(m.name)}"
                  >
                    ✓ Registrar
                  </button>
                  <div class="flex items-center gap-1">
                    <button
                      type="button"
                      class="btn-maint-edit p-1 text-slate-400 hover:text-indigo-300 transition"
                      data-id="${m.id}"
                      title="Editar regla"
                    >
                      ✏️
                    </button>
                    <button
                      type="button"
                      class="btn-maint-delete p-1 text-slate-400 hover:text-rose-400 transition"
                      data-id="${m.id}"
                      data-name="${escHtml(m.name)}"
                      title="Eliminar regla"
                    >
                      🗑️
                    </button>
                  </div>
                </div>
              </div>
            </div>
          `;
        }).join('');

        maintContainer.querySelectorAll('.btn-maint-execute').forEach((btn) => {
          btn.addEventListener('click', () => {
            const id = Number(btn.getAttribute('data-id'));
            const name = btn.getAttribute('data-name') || 'Mantenimiento';
            openExecuteMaintModal(id, name);
          });
        });

        maintContainer.querySelectorAll('.btn-maint-edit').forEach((btn) => {
          btn.addEventListener('click', () => {
            const id = Number(btn.getAttribute('data-id'));
            openNewMaintModal(id);
          });
        });

        maintContainer.querySelectorAll('.btn-maint-delete').forEach((btn) => {
          btn.addEventListener('click', async () => {
            const id = Number(btn.getAttribute('data-id'));
            const name = btn.getAttribute('data-name');
            if (confirm(`¿Eliminar la tarea "${name}" de este vehículo?`)) {
              await fetch(`/api/garage/maintenance/${id}`, { method: 'DELETE' });
              showToast('Tarea eliminada', 'info');
              loadGarage();
            }
          });
        });
      }
    }

    // 2. Incidencias
    const incContainer = document.getElementById('garage-incidents-list');
    if (incContainer) {
      const openIncidents = (v.incidents || []).filter((i: any) => i.status === 'open');
      if (openIncidents.length === 0) {
        incContainer.innerHTML = `
          <div class="glass-card rounded-2xl p-6 text-center space-y-2">
            <div class="text-2xl">✅</div>
            <p class="text-xs text-slate-400">Sin incidencias ni averías activas en este vehículo.</p>
          </div>
        `;
      } else {
        incContainer.innerHTML = openIncidents.map((inc: any) => `
          <div class="glass-card rounded-2xl p-3.5 border border-amber-500/40 bg-amber-950/15 space-y-2">
            <div class="flex items-start justify-between gap-3">
              <div class="flex-1 min-w-0">
                <div class="flex items-center gap-2">
                  <span class="text-base">⚠️</span>
                  <h4 class="text-sm font-bold text-amber-200 truncate">${escHtml(inc.title)}</h4>
                </div>
                ${inc.description ? `<p class="text-xs text-slate-300 mt-1">${escHtml(inc.description)}</p>` : ''}
                <div class="text-[10px] text-slate-400 mt-1 flex items-center gap-2">
                  <span>Reportado: ${inc.reportedDate}</span>
                  ${inc.reportedByName ? `<span>por ${escHtml(inc.reportedByName)}</span>` : ''}
                </div>
              </div>

              <button
                type="button"
                class="btn-resolve-incident px-3 py-1.5 rounded-xl bg-emerald-600 hover:bg-emerald-500 text-white text-xs font-bold shadow-md shadow-emerald-600/30 transition active:scale-95 shrink-0"
                data-id="${inc.id}"
                data-title="${escHtml(inc.title)}"
              >
                ✓ Resolver
              </button>
            </div>
          </div>
        `).join('');

        incContainer.querySelectorAll('.btn-resolve-incident').forEach((btn) => {
          btn.addEventListener('click', () => {
            const id = Number(btn.getAttribute('data-id'));
            const title = btn.getAttribute('data-title') || '';
            openResolveIncidentModal(id, title);
          });
        });
      }
    }

    // 3. Historial (Libro de revisiones)
    const histContainer = document.getElementById('garage-history-list');
    if (histContainer) {
      if (!v.logs || v.logs.length === 0) {
        histContainer.innerHTML = `
          <div class="glass-card rounded-2xl p-6 text-center space-y-2">
            <div class="text-2xl">📖</div>
            <p class="text-xs text-slate-400">Aún no hay registros en el libro de revisiones de este vehículo.</p>
          </div>
        `;
      } else {
        histContainer.innerHTML = v.logs.map((l: any) => `
          <div class="glass-card rounded-2xl p-3 border border-slate-700/60 text-xs space-y-1">
            <div class="flex items-center justify-between gap-2">
              <span class="font-bold text-white truncate">${escHtml(l.title)}</span>
              <span class="text-[10px] font-semibold text-slate-400 shrink-0">${l.performedDate}</span>
            </div>
            <div class="flex items-center gap-2 text-[11px] text-slate-400 flex-wrap">
              ${l.performedKm ? `<span class="text-blue-300 font-mono font-bold">${l.performedKm.toLocaleString('es-ES')} km</span>` : ''}
              ${l.workshop ? `<span class="bg-slate-800 px-1.5 py-0.2 rounded text-slate-300">🏢 ${escHtml(l.workshop)}</span>` : ''}
              ${l.cost ? `<span class="bg-emerald-500/15 text-emerald-300 px-1.5 py-0.2 rounded font-bold">${escHtml(l.cost)}</span>` : ''}
              ${l.performedByName ? `<span>por ${escHtml(l.performedByName)}</span>` : ''}
            </div>
            ${l.notes ? `<p class="text-[11px] text-slate-400 italic pt-0.5">${escHtml(l.notes)}</p>` : ''}
          </div>
        `).join('');
      }
    }
  }

  // Modals for Garage
  function openUpdateKmModal() {
    const v = garageData.find((item) => item.id === activeVehicleId);
    if (!v) return;

    const modal = document.getElementById('modal-update-km');
    const nameEl = document.getElementById('modal-km-vehicle-name');
    const inputKm = document.getElementById('input-new-km') as HTMLInputElement;
    const inputDate = document.getElementById('input-date-km') as HTMLInputElement;

    if (nameEl) nameEl.textContent = `${v.name} ${v.plate ? `(${v.plate})` : ''}`;
    if (inputKm) inputKm.value = String(v.currentKm || 0);
    if (inputDate) inputDate.value = new Date().toISOString().split('T')[0];

    modal?.classList.remove('hidden');
    modal?.classList.add('flex');
  }

  function closeUpdateKmModal() {
    const modal = document.getElementById('modal-update-km');
    modal?.classList.add('hidden');
    modal?.classList.remove('flex');
  }

  function openExecuteMaintModal(maintId: number, name: string) {
    const v = garageData.find((item) => item.id === activeVehicleId);
    const modal = document.getElementById('modal-execute-maintenance');
    const inputId = document.getElementById('input-exec-maint-id') as HTMLInputElement;
    const titleEl = document.getElementById('modal-exec-maint-name');
    const inputDate = document.getElementById('input-exec-date') as HTMLInputElement;
    const inputKm = document.getElementById('input-exec-km') as HTMLInputElement;
    const selectUser = document.getElementById('select-exec-user') as HTMLSelectElement;

    if (inputId) inputId.value = String(maintId);
    if (titleEl) titleEl.textContent = name;
    if (inputDate) inputDate.value = new Date().toISOString().split('T')[0];
    if (inputKm) inputKm.value = v && v.hasMileage ? String(v.currentKm || 0) : '';

    if (selectUser) {
      selectUser.innerHTML = usersList.map((u) => `
        <option value="${u.id}" ${activeUser?.id === u.id ? 'selected' : ''}>${escHtml(u.avatar || '👤')} ${escHtml(u.name)}</option>
      `).join('');
    }

    modal?.classList.remove('hidden');
    modal?.classList.add('flex');
  }

  function closeExecuteMaintModal() {
    const modal = document.getElementById('modal-execute-maintenance');
    modal?.classList.add('hidden');
    modal?.classList.remove('flex');
  }

  function openNewMaintModal(maintId?: number) {
    const modal = document.getElementById('modal-new-maintenance');
    const titleEl = document.getElementById('modal-maint-rule-title');
    const inputId = document.getElementById('input-maint-rule-id') as HTMLInputElement;
    const inputName = document.getElementById('input-maint-name') as HTMLInputElement;
    const inputKm = document.getElementById('input-maint-interval-km') as HTMLInputElement;
    const inputMonths = document.getElementById('input-maint-interval-months') as HTMLInputElement;
    const inputLastKm = document.getElementById('input-maint-last-km') as HTMLInputElement;
    const inputLastDate = document.getElementById('input-maint-last-date') as HTMLInputElement;

    const v = garageData.find((item) => item.id === activeVehicleId);

    if (maintId && v) {
      const item = (v.maintenance || []).find((m: any) => m.id === maintId);
      if (item) {
        if (titleEl) titleEl.textContent = 'Editar Tarea de Mantenimiento';
        if (inputId) inputId.value = String(item.id);
        if (inputName) inputName.value = item.name || '';
        if (inputKm) inputKm.value = item.intervalKm ? String(item.intervalKm) : '';
        if (inputMonths) inputMonths.value = item.intervalMonths ? String(item.intervalMonths) : '';
        if (inputLastKm) inputLastKm.value = item.lastDoneKm ? String(item.lastDoneKm) : '';
        if (inputLastDate) inputLastDate.value = item.lastDoneDate || '';
      }
    } else {
      if (titleEl) titleEl.textContent = 'Nueva Tarea de Mantenimiento';
      if (inputId) inputId.value = '';
      if (inputName) inputName.value = '';
      if (inputKm) inputKm.value = '';
      if (inputMonths) inputMonths.value = '';
      if (inputLastKm) inputLastKm.value = '';
      if (inputLastDate) inputLastDate.value = '';
    }

    modal?.classList.remove('hidden');
    modal?.classList.add('flex');
  }

  function closeNewMaintModal() {
    const modal = document.getElementById('modal-new-maintenance');
    modal?.classList.add('hidden');
    modal?.classList.remove('flex');
  }

  function openNewIncidentModal() {
