  // ==========================================
  // EVENT LISTENERS & INITIALIZATION
  // ==========================================
  document.addEventListener('DOMContentLoaded', async () => {
    // 1. Initial Load
    await loadUsers();
    await loadCalendar();
    await loadGarage();

    // Calendario: navegación de mes y cierre del desglose
    const shiftMonth = (delta: number) => {
      const d = new Date(calYear, calMonth - 1 + delta, 1);
      calYear = d.getFullYear();
      calMonth = d.getMonth() + 1;
      loadCalendar();
    };
    document.getElementById('btn-cal-prev')?.addEventListener('click', () => shiftMonth(-1));
    document.getElementById('btn-cal-next')?.addEventListener('click', () => shiftMonth(1));
    document.getElementById('btn-cal-today')?.addEventListener('click', () => {
      calYear = new Date().getFullYear();
      calMonth = new Date().getMonth() + 1;
      loadCalendar();
    });
    const calModal = document.getElementById('cal-day-modal');
    document.getElementById('btn-cal-day-close')?.addEventListener('click', () => calModal?.classList.add('hidden'));
    calModal?.addEventListener('click', (e) => {
      if (e.target === calModal) calModal.classList.add('hidden');
    });

    // 2. Navigation Tabs
    document.querySelectorAll('.nav-tab').forEach((tabBtn) => {
      tabBtn.addEventListener('click', () => {
        const tab = tabBtn.getAttribute('data-tab') as any;
        if (tab) switchTab(tab);
      });
    });

    // 3. User Selector Dropdown Toggle
    const userBtn = document.getElementById('user-selector-btn');
    const userMenu = document.getElementById('user-dropdown-menu');

    userBtn?.addEventListener('click', (e) => {
      e.stopPropagation();
      userMenu?.classList.toggle('hidden');
    });

    document.addEventListener('click', () => {
      userMenu?.classList.add('hidden');
    });

    // 4. Global Sync Button
    document.getElementById('btn-sync-all')?.addEventListener('click', () => {
      syncWeek();
    });

    // Modal registrar tarea hecha
    document.getElementById('btn-close-log-chore')?.addEventListener('click', closeLogChoreModal);
    document.getElementById('btn-cancel-log-chore')?.addEventListener('click', closeLogChoreModal);
    document.getElementById('btn-confirm-log-chore')?.addEventListener('click', confirmLogChore);
    document.getElementById('log-mode-existing')?.addEventListener('click', () => setLogMode('existing'));
    document.getElementById('log-mode-new')?.addEventListener('click', () => setLogMode('new'));
    document.getElementById('log-chore-search')?.addEventListener('input', renderLogChoreList);

    // 6. Dashboard Grouping Toggle (Por Día vs Por Conviviente)
    const btnGroupDay = document.getElementById('btn-group-by-day');
    const btnGroupUser = document.getElementById('btn-group-by-user');

    btnGroupDay?.addEventListener('click', () => {
      dashboardGroupBy = 'day';
      btnGroupDay.classList.add('bg-indigo-600', 'text-white');
      btnGroupDay.classList.remove('text-slate-400');
      btnGroupUser?.classList.remove('bg-indigo-600', 'text-white');
      btnGroupUser?.classList.add('text-slate-400');
      renderDashboardGroups();
    });

    btnGroupUser?.addEventListener('click', () => {
      dashboardGroupBy = 'user';
      btnGroupUser.classList.add('bg-indigo-600', 'text-white');
      btnGroupUser.classList.remove('text-slate-400');
      btnGroupDay?.classList.remove('bg-indigo-600', 'text-white');
      btnGroupDay?.classList.add('text-slate-400');
      renderDashboardGroups();
    });

    // 7. Dashboard Status Filter
    document.getElementById('filter-dashboard-status')?.addEventListener('change', (e) => {
      dashboardFilterStatus = (e.target as HTMLSelectElement).value as any;
      renderDashboardGroups();
    });

    // 8. Catalog Frequency Filter Pills
    document.querySelectorAll('.catalog-filter-btn').forEach((btn) => {
      btn.addEventListener('click', () => {
        const freq = btn.getAttribute('data-freq') || 'all';
        catalogFilterFreq = freq;

        document.querySelectorAll('.catalog-filter-btn').forEach((b) => {
          b.classList.remove('bg-indigo-600', 'text-white');
          b.classList.add('bg-slate-800', 'text-slate-300');
        });

        btn.classList.add('bg-indigo-600', 'text-white');
        btn.classList.remove('bg-slate-800', 'text-slate-300');

        renderCatalog();
      });
    });

    // 9. Quick Emoji Pickers in Modals
    document.querySelectorAll('.quick-emoji').forEach((btn) => {
      btn.addEventListener('click', () => {
        const emoji = btn.textContent || '🧹';
        const input = document.getElementById('input-chore-icon') as HTMLInputElement;
        if (input) input.value = emoji.trim();
      });
    });

    document.querySelectorAll('.quick-avatar').forEach((btn) => {
      btn.addEventListener('click', () => {
        const avatar = btn.textContent || '👤';
        const input = document.getElementById('input-user-avatar') as HTMLInputElement;
        if (input) input.value = avatar.trim();
      });
    });

    
    // Switcher de vista Calendario: Mes vs Semana
    document.getElementById('btn-cal-tab-month')?.addEventListener('click', () => setCalendarViewMode('month'));
    document.getElementById('btn-cal-tab-week')?.addEventListener('click', () => setCalendarViewMode('week'));

    // Subtabs de Garaje
    document.getElementById('garage-subtab-btn-maint')?.addEventListener('click', () => setGarageSubtab('maint'));
    document.getElementById('garage-subtab-btn-incidents')?.addEventListener('click', () => setGarageSubtab('incidents'));
    document.getElementById('garage-subtab-btn-history')?.addEventListener('click', () => setGarageSubtab('history'));

    // Modales de Garaje
    document.getElementById('btn-close-chore-history')?.addEventListener('click', closeChoreHistoryModal);
    document.getElementById('btn-done-chore-history')?.addEventListener('click', closeChoreHistoryModal);

    document.getElementById('btn-close-update-km')?.addEventListener('click', closeUpdateKmModal);
    document.getElementById('btn-cancel-update-km')?.addEventListener('click', closeUpdateKmModal);

    document.getElementById('btn-close-exec-maint')?.addEventListener('click', closeExecuteMaintModal);
    document.getElementById('btn-cancel-exec-maint')?.addEventListener('click', closeExecuteMaintModal);

    document.getElementById('btn-open-new-maint-modal')?.addEventListener('click', () => openNewMaintModal());
    document.getElementById('btn-close-new-maint')?.addEventListener('click', closeNewMaintModal);
    document.getElementById('btn-cancel-new-maint')?.addEventListener('click', closeNewMaintModal);

    document.getElementById('btn-open-new-incident-modal')?.addEventListener('click', openNewIncidentModal);
    document.getElementById('btn-close-new-incident')?.addEventListener('click', closeNewIncidentModal);
    document.getElementById('btn-cancel-new-incident')?.addEventListener('click', closeNewIncidentModal);

    document.getElementById('btn-close-resolve-incident')?.addEventListener('click', closeResolveIncidentModal);
    document.getElementById('btn-cancel-resolve-incident')?.addEventListener('click', closeResolveIncidentModal);

    document.getElementById('btn-open-new-vehicle-modal')?.addEventListener('click', openNewVehicleModal);
    document.getElementById('btn-close-new-vehicle')?.addEventListener('click', closeNewVehicleModal);
    document.getElementById('btn-cancel-new-vehicle')?.addEventListener('click', closeNewVehicleModal);

    // Form Update Km
    document.getElementById('form-update-km')?.addEventListener('submit', async (e) => {
      e.preventDefault();
      const km = (document.getElementById('input-new-km') as HTMLInputElement).value;
      const date = (document.getElementById('input-date-km') as HTMLInputElement).value;
      try {
        const res = await fetch('/api/garage/km', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ vehicleId: activeVehicleId, km: Number(km), date, userId: activeUser?.id }),
        });
        const data = await res.json();
        if (data.success) {
          triggerConfetti();
          showToast('Kilometraje actualizado correctamente', 'success');
          closeUpdateKmModal();
          await loadGarage();
        } else {
          showToast(data.error || 'Error al actualizar km', 'error');
        }
      } catch (err) {
        showToast('Error de conexión', 'error');
      }
    });

    // Form Execute Maintenance
    document.getElementById('form-exec-maint')?.addEventListener('submit', async (e) => {
      e.preventDefault();
      const maintId = (document.getElementById('input-exec-maint-id') as HTMLInputElement).value;
      const performedDate = (document.getElementById('input-exec-date') as HTMLInputElement).value;
      const performedKm = (document.getElementById('input-exec-km') as HTMLInputElement).value;
      const performedBy = (document.getElementById('select-exec-user') as HTMLSelectElement).value;
      const workshop = (document.getElementById('input-exec-workshop') as HTMLInputElement).value;
      const cost = (document.getElementById('input-exec-cost') as HTMLInputElement).value;
      const notes = (document.getElementById('input-exec-notes') as HTMLTextAreaElement).value;

      try {
        const res = await fetch('/api/garage/execute', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({
            vehicleId: activeVehicleId,
            maintenanceId: maintId ? Number(maintId) : null,
            performedDate,
            performedKm: performedKm ? Number(performedKm) : null,
            performedBy: performedBy ? Number(performedBy) : null,
            workshop,
            cost,
            notes,
          }),
        });
        const data = await res.json();
        if (data.success) {
          triggerConfetti();
          showToast('Mantenimiento registrado y anotado en historial', 'success');
          closeExecuteMaintModal();
          await loadGarage();
        } else {
          showToast(data.error || 'Error al guardar', 'error');
        }
      } catch (err) {
        showToast('Error de conexión', 'error');
      }
    });

    // Form New/Edit Maintenance
    document.getElementById('form-new-maintenance')?.addEventListener('submit', async (e) => {
      e.preventDefault();
      const id = (document.getElementById('input-maint-rule-id') as HTMLInputElement).value;
      const name = (document.getElementById('input-maint-name') as HTMLInputElement).value;
      const intervalKm = (document.getElementById('input-maint-interval-km') as HTMLInputElement).value;
      const intervalMonths = (document.getElementById('input-maint-interval-months') as HTMLInputElement).value;
      const lastDoneKm = (document.getElementById('input-maint-last-km') as HTMLInputElement).value;
      const lastDoneDate = (document.getElementById('input-maint-last-date') as HTMLInputElement).value;

      try {
        const res = await fetch('/api/garage/maintenance', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({
            id: id ? Number(id) : undefined,
            vehicleId: activeVehicleId,
            name,
            intervalKm: intervalKm ? Number(intervalKm) : null,
            intervalMonths: intervalMonths ? Number(intervalMonths) : null,
            lastDoneKm: lastDoneKm ? Number(lastDoneKm) : null,
            lastDoneDate: lastDoneDate || null,
          }),
        });
        const data = await res.json();
        if (data.success) {
          showToast(id ? 'Tarea actualizada' : 'Tarea de mantenimiento creada', 'success');
          closeNewMaintModal();
          await loadGarage();
        } else {
          showToast(data.error || 'Error al guardar', 'error');
        }
      } catch (err) {
        showToast('Error de conexión', 'error');
      }
    });

    // Form Report Incident
    document.getElementById('form-new-incident')?.addEventListener('submit', async (e) => {
      e.preventDefault();
      const title = (document.getElementById('input-incident-title') as HTMLInputElement).value;
      const description = (document.getElementById('input-incident-desc') as HTMLTextAreaElement).value;
      const reportedBy = (document.getElementById('select-incident-user') as HTMLSelectElement).value;
      const reportedDate = (document.getElementById('input-incident-date') as HTMLInputElement).value;

      try {
        const res = await fetch('/api/garage/incidents', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({
            vehicleId: activeVehicleId,
            title,
            description,
            reportedBy: reportedBy ? Number(reportedBy) : null,
            reportedDate,
          }),
        });
        const data = await res.json();
        if (data.success) {
          showToast('Incidencia reportada', 'warning');
          closeNewIncidentModal();
          await loadGarage();
        } else {
          showToast(data.error || 'Error al guardar', 'error');
        }
      } catch (err) {
        showToast('Error de conexión', 'error');
      }
    });

    // Form Resolve Incident
    document.getElementById('form-resolve-incident')?.addEventListener('submit', async (e) => {
      e.preventDefault();
      const incidentId = (document.getElementById('input-resolve-incident-id') as HTMLInputElement).value;
      const resolutionNotes = (document.getElementById('input-resolve-notes') as HTMLTextAreaElement).value;
      const workshop = (document.getElementById('input-resolve-workshop') as HTMLInputElement).value;
      const resolvedDate = (document.getElementById('input-resolve-date') as HTMLInputElement).value;

      try {
        const res = await fetch('/api/garage/incidents', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({
            action: 'resolve',
            incidentId: Number(incidentId),
            resolutionNotes,
            workshop,
            resolvedDate,
            performedBy: activeUser?.id,
          }),
        });
        const data = await res.json();
        if (data.success) {
          triggerConfetti();
          showToast('Incidencia resuelta y archivada', 'success');
          closeResolveIncidentModal();
          await loadGarage();
        } else {
          showToast(data.error || 'Error al resolver', 'error');
        }
      } catch (err) {
        showToast('Error de conexión', 'error');
      }
    });

    // Form New Vehicle
    document.getElementById('form-new-vehicle')?.addEventListener('submit', async (e) => {
      e.preventDefault();
      const name = (document.getElementById('input-veh-name') as HTMLInputElement).value;
      const plate = (document.getElementById('input-veh-plate') as HTMLInputElement).value;
      const icon = (document.getElementById('input-veh-icon') as HTMLInputElement).value;
      const hasMileage = (document.getElementById('check-veh-has-mileage') as HTMLInputElement).checked;
      const currentKm = (document.getElementById('input-veh-initial-km') as HTMLInputElement).value;

      try {
        const res = await fetch('/api/garage', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({
            name,
            plate,
            icon,
            hasMileage,
            currentKm: hasMileage && currentKm ? Number(currentKm) : 0,
          }),
        });
        const data = await res.json();
        if (data.success) {
          triggerConfetti();
          showToast('Vehículo añadido al garaje', 'success');
          closeNewVehicleModal();
          activeVehicleId = data.vehicle.id;
          await loadGarage();
        } else {
          showToast(data.error || 'Error al crear vehículo', 'error');
        }
      } catch (err) {
        showToast('Error de conexión', 'error');
      }
    });

    // Vehicle icon buttons
    document.querySelectorAll('.quick-veh-icon').forEach((btn) => {
      btn.addEventListener('click', () => {
        const input = document.getElementById('input-veh-icon') as HTMLInputElement;
        if (input) input.value = (btn.textContent || '🚗').trim();
      });
    });

    // Toggle container veh km
    document.getElementById('check-veh-has-mileage')?.addEventListener('change', (e) => {
      const checked = (e.target as HTMLInputElement).checked;
      document.getElementById('container-veh-km')?.classList.toggle('hidden', !checked);
    });

    // 10. Modal Nueva Tarea
    const modalChore = document.getElementById('modal-new-chore');
    const openChoreBtn = document.getElementById('btn-open-new-chore-modal');
    const closeChoreBtn = document.getElementById('btn-close-new-chore-modal');
    const cancelChoreBtn = document.getElementById('btn-cancel-new-chore');
    const formChore = document.getElementById('form-new-chore') as HTMLFormElement;
    const selectFreq = document.getElementById('select-chore-frequency') as HTMLSelectElement | null;
    const containerSecondDay = document.getElementById('container-second-day');
    const labelDay1 = document.getElementById('label-chore-day-1');

    // Escuchar cambio en periodicidad para mostrar/ocultar segundo día
    selectFreq?.addEventListener('change', () => {
      const isOnce = selectFreq.value === 'once';
      const containerDay1 = document.getElementById('container-day-1');
      const labelAssignee = document.getElementById('label-assignee-select');
      const selectAssignee = document.getElementById('select-chore-assignee') as HTMLSelectElement | null;

      if (containerDay1) containerDay1.classList.toggle('hidden', isOnce);
      if (selectAssignee) {
        if (isOnce) {
          selectAssignee.removeAttribute('required');
          if (labelAssignee) labelAssignee.textContent = 'Responsable (Opcional para puntuales)';
        } else {
          selectAssignee.setAttribute('required', 'true');
          if (labelAssignee) labelAssignee.textContent = 'Responsable habitual';
        }
      }

      if (selectFreq.value === 'twice_weekly') {
        containerSecondDay?.classList.remove('hidden');
        if (labelDay1) labelDay1.textContent = 'Primer día';
      } else {
        containerSecondDay?.classList.add('hidden');
        if (labelDay1) labelDay1.textContent = 'Día preferido';
      }
    });

    // Escuchar cambio en modalidad de reparto (fija vs rotativa)
    document.querySelectorAll('input[name="assignment-mode"]').forEach((radio) => {
      radio.addEventListener('change', (e) => {
        const val = (e.target as HTMLInputElement).value;
        const descEl = document.getElementById('desc-assignment-mode');
        const labelAssignee = document.getElementById('label-assignee-select');
        if (val === 'rotating') {
          if (descEl) descEl.textContent = '🔄 La tarea irá rotando automáticamente entre todos los convivientes cada semana.';
          if (labelAssignee) labelAssignee.textContent = 'Punto de partida de la rotación';
        } else {
          if (descEl) descEl.textContent = '📌 La tarea estará siempre asignada a la misma persona seleccionada.';
          if (labelAssignee) labelAssignee.textContent = 'Responsable habitual';
        }
      });
    });

    openChoreBtn?.addEventListener('click', openNewChoreModal);
    closeChoreBtn?.addEventListener('click', closeChoreModal);
    cancelChoreBtn?.addEventListener('click', closeChoreModal);

    formChore?.addEventListener('submit', async (e) => {
      e.preventDefault();
      const editId = (document.getElementById('input-edit-chore-id') as HTMLInputElement).value;
      const name = (document.getElementById('input-chore-name') as HTMLInputElement).value;
      const frequency = (document.getElementById('select-chore-frequency') as HTMLSelectElement).value;
      const assignmentMode = (document.querySelector('input[name="assignment-mode"]:checked') as HTMLInputElement)?.value || 'fixed';
      const defaultAssigneeId = (document.getElementById('select-chore-assignee') as HTMLSelectElement).value;
      const icon = (document.getElementById('input-chore-icon') as HTMLInputElement).value;
      const category = (document.getElementById('input-chore-category') as HTMLInputElement).value;
      const dayOfWeek = (document.getElementById('select-chore-day') as HTMLSelectElement).value;
      const secondDayOfWeek = (document.getElementById('select-chore-second-day') as HTMLSelectElement)?.value;

      const url = editId ? `/api/catalog/${editId}` : '/api/catalog';
      const method = editId ? 'PUT' : 'POST';

      try {
        const res = await fetch(url, {
          method,
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({
            name,
            frequency,
            assignmentMode,
            defaultAssigneeId: Number(defaultAssigneeId),
            icon,
            category,
            dayOfWeek: Number(dayOfWeek),
            secondDayOfWeek: frequency === 'twice_weekly' ? Number(secondDayOfWeek || 4) : undefined,
          }),
        });

        const data = await res.json();
        if (data.success) {
          showToast(editId ? '¡Tarea actualizada correctamente!' : '¡Tarea agregada al catálogo y programada!', 'success');
          closeChoreModal();
          formChore.reset();
          await loadCatalog();
          if (activeTab === 'dashboard') loadDashboard();
        } else {
          showToast(data.error || 'Error al guardar tarea', 'error');
        }
      } catch (err) {
        showToast('Error de conexión', 'error');
      }
    });

    // 11. Modal Nuevo / Editar Conviviente
    const modalUser = document.getElementById('modal-new-user');
    const openUserBtn = document.getElementById('btn-open-new-user-modal');
    const openUserFromDropdown = document.getElementById('btn-open-new-user-from-dropdown');
    const closeUserBtn = document.getElementById('btn-close-new-user-modal');
    const cancelUserBtn = document.getElementById('btn-cancel-new-user');
    const formUser = document.getElementById('form-new-user') as HTMLFormElement;

    openUserBtn?.addEventListener('click', openNewUserModal);
    openUserFromDropdown?.addEventListener('click', openNewUserModal);
    closeUserBtn?.addEventListener('click', closeUserModal);
    cancelUserBtn?.addEventListener('click', closeUserModal);

    formUser?.addEventListener('submit', async (e) => {
      e.preventDefault();
      const editId = (document.getElementById('input-edit-user-id') as HTMLInputElement).value;
      const name = (document.getElementById('input-user-name') as HTMLInputElement).value;
      const email = (document.getElementById('input-user-email') as HTMLInputElement).value;
      const avatar = (document.getElementById('input-user-avatar') as HTMLInputElement).value;
      const color = (document.getElementById('input-user-color') as HTMLInputElement).value;

      const url = editId ? `/api/users/${editId}` : '/api/users';
      const method = editId ? 'PUT' : 'POST';

      try {
        const res = await fetch(url, {
          method,
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ name, email, avatar, color }),
        });

        const data = await res.json();
        if (data.success) {
          showToast(editId ? `Conviviente "${name}" actualizado con éxito` : `¡Conviviente ${name} creado con éxito!`, 'success');
          closeUserModal();
          formUser.reset();
          await loadUsers();
          if (editId) {
            if (activeUser?.id === Number(editId)) {
              setActiveUser(Number(editId));
            }
          } else {
            setActiveUser(data.user.id);
          }
          if (activeTab === 'roommates') loadRoommates();
          if (activeTab === 'dashboard') loadDashboard();
        } else {
          showToast(data.error || 'Error al guardar conviviente', 'error');
        }
      } catch (err) {
        showToast('Error de conexión', 'error');
      }
    });
  });
</script>
