<!-- Client Application Logic in TypeScript -->
<script>
  // Declare confetti from CDN
  declare const confetti: any;

  // Types
  interface User {
    id: number;
    name: string;
    email: string;
    avatar: string;
    color: string;
  }

  interface ChoreLogItem {
    id: number;
    choreId: number;
    choreName: string;
    icon: string;
    category: string;
    frequency: string;
    assignmentMode: 'fixed' | 'rotating';
    targetDate: string;
    originalTargetDate: string | null;
    status: 'pending' | 'completed';
    assignedToId: number;
    assignedToName: string;
    assignedToColor: string;
    assignedToAvatar: string;
    executedById: number | null;
    executedByName: string | null;
    executedByColor: string | null;
    executedByAvatar: string | null;
    executionDate: string | null;
    isStolen: boolean;
    isToday: boolean;
    isOverdue: boolean;
  }

  interface DayGroup {
    day: {
      dateStr: string;
      dayOfWeek: number;
      dayName: string;
      dayShort: string;
      dayNumber: number;
      monthName: string;
      isToday: boolean;
      isPast: boolean;
    };
    chores: ChoreLogItem[];
    totalCount: number;
    completedCount: number;
    pendingCount: number;
    isComplete: boolean;
  }

  // Application State
  let usersList: User[] = [];
  let activeUser: User | null = null;
  let activeTab: 'calendar' | 'garage' | 'catalog' | 'roommates' = 'calendar';
  let calViewMode: 'month' | 'week' = 'month';
  let garageData: any[] = [];
  let activeVehicleId: number | null = null;
  let garageSubtab: 'maint' | 'incidents' | 'history' = 'maint';
  let calYear = new Date().getFullYear();
  let calMonth = new Date().getMonth() + 1;
  let calFilterUser: number | 'all' = 'all';
  let calendarData: {
    todayStr: string;
    users: { id: number; name: string; color: string; avatar: string }[];
    tasks: any[];
  } | null = null;
  let dashboardGroupBy: 'day' | 'user' = 'day';
  let dashboardFilterStatus: 'all' | 'pending' | 'completed' = 'all';
  let catalogFilterFreq: string = 'all';

  // Cached data
  let dashboardData: {
    days: any[];
    choresByDay: DayGroup[];
    allChores: ChoreLogItem[];
    users: User[];
    userStats: any[];
    summary: { totalTasks: number; totalCompleted: number; totalPending: number; overallProgress: number; weekRange: string };
  } | null = null;

  let catalogData: any[] = [];

  // ==========================================
  // TOAST NOTIFICATIONS
  // ==========================================
  function showToast(message: string, type: 'success' | 'info' | 'error' = 'success') {
    const container = document.getElementById('toast-container');
    if (!container) return;

    const toast = document.createElement('div');
    const colors = {
      success: 'bg-emerald-950/90 border-emerald-500/40 text-emerald-200',
      info: 'bg-indigo-950/90 border-indigo-500/40 text-indigo-200',
      error: 'bg-rose-950/90 border-rose-500/40 text-rose-200',
    };
    const icons = {
      success: '✅',
      info: '💡',
      error: '⚠️',
    };

    toast.className = `p-3 rounded-2xl border shadow-xl backdrop-blur-md flex items-center gap-2.5 text-xs font-medium pointer-events-auto transition-all duration-300 transform translate-y-2 opacity-0 ${colors[type]}`;
    toast.innerHTML = `
      <span class="text-base">${icons[type]}</span>
      <span class="flex-1">${message}</span>
      <button class="text-slate-400 hover:text-white text-sm px-1 leading-none font-bold">&times;</button>
    `;

    toast.querySelector('button')?.addEventListener('click', () => {
      toast.remove();
    });

    container.appendChild(toast);

    // Animate in
    requestAnimationFrame(() => {
      toast.classList.remove('translate-y-2', 'opacity-0');
    });

    // Auto remove
    setTimeout(() => {
      toast.classList.add('opacity-0', '-translate-y-2');
      setTimeout(() => toast.remove(), 300);
    }, 4000);
  }

  // ==========================================
  // CONFETTI EFFECT
  // ==========================================
  function triggerConfetti() {
    try {
      if (typeof confetti === 'function') {
        confetti({
          particleCount: 65,
          spread: 60,
          origin: { y: 0.75 },
          colors: ['#6366f1', '#10b981', '#ec4899', '#f59e0b'],
        });
      }
    } catch (e) {
      // Ignore if not loaded
    }
  }

  // ==========================================
  // BADGE DE FECHA PROGRAMADA ORIGINAL
  // ==========================================
  function formatScheduledDateBadge(item: ChoreLogItem): string {
    // Solo aplica para tareas completadas, no diarias, que tengan fecha programada registrada
    if (item.status !== 'completed' || item.frequency === 'daily' || !item.originalTargetDate) {
      return '';
    }

    const daysOfWeekEs = ['Domingo', 'Lunes', 'Martes', 'Miércoles', 'Jueves', 'Viernes', 'Sábado'];
    const monthsShortEs = ['ene', 'feb', 'mar', 'abr', 'may', 'jun', 'jul', 'ago', 'sep', 'oct', 'nov', 'dic'];

    const parts = item.originalTargetDate.split('-').map(Number);
    if (parts.length !== 3) return '';
    const [y, m, d] = parts;
    const dateObj = new Date(y, m - 1, d);
    const dayName = daysOfWeekEs[dateObj.getDay()];
    const monthShort = monthsShortEs[dateObj.getMonth()];

    const isMoved = item.originalTargetDate !== item.targetDate;

    if (isMoved) {
      return `
        <span
          class="inline-flex items-center gap-1 px-2 py-0.5 rounded-md text-[10px] font-semibold bg-indigo-50 text-indigo-700 border border-indigo-200/90 shadow-xs"
          title="Tarea movida al día ejecutado (${item.targetDate}). Estaba programada para el ${dayName}, ${d} de ${monthShort}"
        >
          <span>📅 Programada:</span> <strong class="font-bold text-indigo-950">${dayName} (${d} ${monthShort})</strong>
        </span>
      `;
    } else {
      return `
        <span
          class="inline-flex items-center gap-1 px-1.5 py-0.5 rounded-md text-[10px] font-medium bg-slate-100 text-slate-600 border border-slate-200"
          title="Completada en su día programado (${dayName})"
        >
          <span>📅 Programada:</span> <span>${dayName}</span>
        </span>
      `;
    }
  }

  // ==========================================
  // NAVIGATION & TABS
  // ==========================================
  // ==========================================
  // VISTA: CALENDARIO MENSUAL
  // ==========================================
  function escHtml(s: string): string {
    return String(s).replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;');
  }

  async function loadCalendar() {
    const grid = document.getElementById('cal-grid');
    if (!grid) return;
    try {
      const res = await fetch(`/api/chores/calendar?year=${calYear}&month=${calMonth}`);
      const data = await res.json();
      if (!data.success) {
        grid.innerHTML = `<div class="col-span-7 p-4 text-center text-rose-400 text-xs">${escHtml(data.error)}</div>`;
        return;
      }
      calendarData = data;
      renderCalendar();
    } catch (err) {
      console.error('Error fetching calendar:', err);
    }
  }

  function renderCalendar() {
    const grid = document.getElementById('cal-grid');
    const title = document.getElementById('cal-month-title');
    const filterEl = document.getElementById('cal-user-filter');
    if (!grid || !calendarData) return;

    const monthsEs = ['Enero', 'Febrero', 'Marzo', 'Abril', 'Mayo', 'Junio', 'Julio', 'Agosto', 'Septiembre', 'Octubre', 'Noviembre', 'Diciembre'];
    if (title) title.textContent = `${monthsEs[calMonth - 1]} ${calYear}`;
    const monthBtn = document.getElementById('btn-cal-today');
    if (monthBtn) monthBtn.textContent = monthsEs[calMonth - 1].toLowerCase();

    // Filtro de convivientes
    if (filterEl) {
      const pill = (id: number | 'all', label: string, color?: string) => {
        const active = calFilterUser === id;
        const style = active
          ? `background:${color || '#6366f1'};color:#fff;box-shadow:inset 0 0 0 2px ${color || '#6366f1'};`
          : `box-shadow:inset 0 0 0 2px ${color || 'transparent'};`;
        return `<button data-cal-user="${id}" style="${style}" class="cal-user-btn px-3 py-1.5 rounded-lg font-semibold transition whitespace-nowrap ${
          active ? 'shadow-md' : 'bg-slate-800 text-slate-300 hover:text-white'
        }">${label}</button>`;
      };
      filterEl.innerHTML =
        pill('all', 'Todos') +
        calendarData.users.map((u) => pill(u.id, `${escHtml(u.avatar)} ${escHtml(u.name)}`, u.color)).join('');
      filterEl.querySelectorAll('.cal-user-btn').forEach((btn) => {
        btn.addEventListener('click', () => {
          const v = btn.getAttribute('data-cal-user')!;
          calFilterUser = v === 'all' ? 'all' : Number(v);
          renderCalendar();
        });
      });
    }

    const userColor = new Map(calendarData.users.map((u) => [u.id, u.color]));
    const visible = calendarData.tasks.filter((t) => calFilterUser === 'all' || t.assignedToId === calFilterUser);
    const byDate = new Map<string, any[]>();
    for (const t of visible) {
      if (!byDate.has(t.targetDate)) byDate.set(t.targetDate, []);
      byDate.get(t.targetDate)!.push(t);
    }

    const first = new Date(calYear, calMonth - 1, 1);
    const daysInMonth = new Date(calYear, calMonth, 0).getDate();
    const offset = (first.getDay() + 6) % 7; // Lunes = 0
    const pad = (n: number) => String(n).padStart(2, '0');

    let html = '';
    for (let i = 0; i < offset; i++) html += '<div></div>';

    for (let d = 1; d <= daysInMonth; d++) {
      const dateStr = `${calYear}-${pad(calMonth)}-${pad(d)}`;
      const tasks = byDate.get(dateStr) || [];
      const isToday = dateStr === calendarData.todayStr;
      let style = '';
      let cls = 'bg-slate-800/40 text-slate-300 border border-slate-700/40';

      if (tasks.length > 0) {
        const colors = Array.from(new Set(tasks.map((t) => userColor.get(t.assignedToId) || '#6366f1')));
        if (colors.length === 1) {
          style = `background:${colors[0]};`;
        } else {
          const step = 100 / colors.length;
          const stops = colors.map((c, i) => `${c} ${i * step}% ${(i + 1) * step}%`).join(',');
          style = `background:linear-gradient(135deg,${stops});`;
        }
        cls = 'text-white border border-white/30 shadow-sm';
      }

      const pending = tasks.filter((t) => t.status === 'pending').length;
      html += `
        <button data-cal-date="${dateStr}" style="${style}"
          class="cal-day relative h-10 sm:h-12 rounded-lg flex flex-col items-center justify-center text-xs font-bold transition active:scale-90 hover:brightness-110 ${cls} ${
            isToday ? 'ring-2 ring-indigo-500 ring-offset-1 ring-offset-white' : ''
          }">
          <span style="${tasks.length ? 'text-shadow:0 1px 2px rgba(0,0,0,.45);' : ''}">${d}</span>
          ${
            tasks.length
              ? `<span class="text-[9px] font-semibold leading-none mt-0.5" style="text-shadow:0 1px 2px rgba(0,0,0,.45);">${
                  pending === 0 ? '✓' : tasks.length
                }</span>`
              : ''
          }
        </button>`;
    }
    grid.innerHTML = html;

    grid.querySelectorAll('.cal-day').forEach((btn) => {
      btn.addEventListener('click', () => openCalendarDay(btn.getAttribute('data-cal-date')!));
    });
  }

  function openCalendarDay(dateStr: string) {
    if (!calendarData) return;
    const modal = document.getElementById('cal-day-modal');
    const titleEl = document.getElementById('cal-day-title');
    const listEl = document.getElementById('cal-day-list');
    if (!modal || !titleEl || !listEl) return;

    const [y, m, d] = dateStr.split('-').map(Number);
    titleEl.textContent = new Date(y, m - 1, d).toLocaleDateString('es-ES', {
      weekday: 'long', day: 'numeric', month: 'long',
    });

    const usersMap = new Map(calendarData.users.map((u) => [u.id, u]));
    const tasks = calendarData.tasks.filter(
      (t) => t.targetDate === dateStr && (calFilterUser === 'all' || t.assignedToId === calFilterUser)
    );

    listEl.innerHTML = tasks.length === 0
      ? '<div class="py-6 text-center text-xs text-slate-400">Sin tareas para este día 🎉</div>'
      : tasks.map((t) => {
          const u = usersMap.get(t.assignedToId);
          const done = t.status === 'completed';
          return `
            <div class="flex items-center gap-3 p-2.5 pl-3.5 rounded-xl bg-slate-800/60 border border-slate-700/50" style="box-shadow:inset 5px 0 0 ${u?.color || '#6366f1'}">
              <span class="text-xl">${escHtml(t.icon)}</span>
              <div class="flex-1 min-w-0">
                <div class="text-sm font-bold truncate ${done ? 'line-through text-slate-400' : 'text-white'}">${escHtml(t.choreName)}</div>
                <div class="text-[11px] text-slate-400">${u ? escHtml(u.avatar + ' ' + u.name) : 'Usuario'} · ${escHtml(t.category)}</div>
              </div>
              <span class="text-[10px] font-bold px-2 py-0.5 rounded-full ${
                done ? 'bg-emerald-500/20 text-emerald-500' : t.isOverdue ? 'bg-rose-500/20 text-rose-500' : 'bg-indigo-500/15 text-indigo-500'
              }">${done ? 'Hecha' : t.isOverdue ? 'Con retraso' : 'Pendiente'}</span>
              <button
                class="btn-cal-toggle w-9 h-9 rounded-xl flex items-center justify-center transition active:scale-90 shrink-0 ${
                  done
                    ? 'bg-emerald-500 text-white shadow-md shadow-emerald-500/25'
                    : 'bg-slate-800 text-slate-400 border border-slate-600/80 hover:border-indigo-500'
                }"
                data-id="${t.id}" data-done="${done}"
                title="${done ? 'Desmarcar tarea' : 'Marcar como hecha'}"
              >
                <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M5 13l4 4L19 7" /></svg>
              </button>
            </div>`;
        }).join('');

    listEl.querySelectorAll('.btn-cal-toggle').forEach((btn) => {
      btn.addEventListener('click', async () => {
        const id = Number(btn.getAttribute('data-id'));
        const isDone = btn.getAttribute('data-done') === 'true';
        btn.setAttribute('disabled', 'true');
        btn.classList.add('animate-pulse');
        await toggleChore(id, isDone ? 'pending' : 'completed');
        await loadCalendar();
        openCalendarDay(dateStr);
      });
    });

    const addBtn = document.getElementById('btn-cal-day-add') as HTMLButtonElement | null;
    if (addBtn) {
      const isFuture = dateStr > calendarData.todayStr;
      addBtn.classList.toggle('hidden', isFuture);
      addBtn.onclick = () => {
        openLogChoreModal(dateStr, async () => {
          await loadCalendar();
          openCalendarDay(dateStr);
        });
      };
    }

    modal.classList.remove('hidden');
  }

  // ==========================================
  // REGISTRAR TAREA HECHA EN UN DÍA
  // ==========================================
  let logDate = '';
  let logMode: 'existing' | 'new' = 'existing';
  let logSelectedChoreId: number | null = null;
  let logAfterSave: (() => void | Promise<void>) | null = null;

  function renderLogChoreList() {
    const listEl = document.getElementById('log-chore-list');
    const search = ((document.getElementById('log-chore-search') as HTMLInputElement)?.value || '').trim().toLowerCase();
    if (!listEl) return;

    const items = [...catalogData]
      .filter((c) => !search || String(c.name).toLowerCase().includes(search))
      .sort((a, b) => (a.frequency === 'once' ? -1 : 0) - (b.frequency === 'once' ? -1 : 0));

    listEl.innerHTML = items.length === 0
      ? '<div class="py-4 text-center text-xs text-slate-500">Sin resultados. Prueba con "Nueva puntual".</div>'
      : items.map((c) => {
          const selected = c.id === logSelectedChoreId;
          return `
            <button type="button" data-id="${c.id}" class="log-chore-item w-full flex items-center gap-2.5 px-3 py-2 rounded-xl border text-left transition ${
              selected ? 'bg-indigo-600/20 border-indigo-500/60' : 'bg-slate-800/60 border-slate-700/50 hover:border-slate-600'
            }">
              <span class="text-lg">${escHtml(c.icon || '🧹')}</span>
              <span class="flex-1 min-w-0">
                <span class="block text-xs font-bold text-white truncate">${escHtml(c.name)}</span>
                <span class="block text-[10px] text-slate-400">${escHtml(c.category || 'Hogar')}${c.frequency === 'once' ? ' · Puntual' : ''}</span>
              </span>
              ${selected ? '<span class="text-indigo-300 text-xs">✓</span>' : ''}
            </button>`;
        }).join('');

    listEl.querySelectorAll('.log-chore-item').forEach((btn) => {
      btn.addEventListener('click', () => {
        logSelectedChoreId = Number(btn.getAttribute('data-id'));
        renderLogChoreList();
      });
    });
  }

  function setLogMode(mode: 'existing' | 'new') {
    logMode = mode;
    document.getElementById('log-existing-panel')?.classList.toggle('hidden', mode !== 'existing');
    document.getElementById('log-new-panel')?.classList.toggle('hidden', mode !== 'new');
    document.querySelectorAll('.log-mode-btn').forEach((b) => {
      const active = b.id === (mode === 'existing' ? 'log-mode-existing' : 'log-mode-new');
      b.classList.toggle('bg-indigo-600', active);
      b.classList.toggle('text-white', active);
      b.classList.toggle('text-slate-400', !active);
    });
  }

  async function openLogChoreModal(dateStr: string, after?: () => void | Promise<void>) {
    if (usersList.length === 0) {
      showToast('Primero añade un conviviente', 'error');
      return;
    }
    logDate = dateStr;
    logAfterSave = after || null;
    logSelectedChoreId = null;

    const [y, m, d] = dateStr.split('-').map(Number);
    const label = document.getElementById('log-chore-date-label');
    if (label) label.textContent = new Date(y, m - 1, d).toLocaleDateString('es-ES', { weekday: 'long', day: 'numeric', month: 'long' });

    const userSel = document.getElementById('log-chore-user') as HTMLSelectElement | null;
    if (userSel) {
      userSel.innerHTML = usersList
        .map((u) => `<option value="${u.id}" ${activeUser?.id === u.id ? 'selected' : ''}>${escHtml(u.avatar || '👤')} ${escHtml(u.name)}</option>`)
        .join('');
    }

    (document.getElementById('log-chore-search') as HTMLInputElement).value = '';
    (document.getElementById('log-new-name') as HTMLInputElement).value = '';
    setLogMode('existing');

    const modal = document.getElementById('modal-log-chore');
    modal?.classList.remove('hidden');
    modal?.classList.add('flex');

    if (catalogData.length === 0) {
      try {
        const res = await fetch('/api/catalog');
        const data = await res.json();
        if (data.success) catalogData = data.catalog;
      } catch (err) {
        console.error('Error fetching catalog:', err);
      }
    }
    renderLogChoreList();
  }

  function closeLogChoreModal() {
    const modal = document.getElementById('modal-log-chore');
    modal?.classList.add('hidden');
    modal?.classList.remove('flex');
  }

  async function confirmLogChore() {
    const userId = Number((document.getElementById('log-chore-user') as HTMLSelectElement).value);
    const body: any = { date: logDate, userId };

    if (logMode === 'existing') {
      if (!logSelectedChoreId) {
        showToast('Elige una tarea de la lista', 'error');
        return;
      }
      body.choreId = logSelectedChoreId;
    } else {
      const name = (document.getElementById('log-new-name') as HTMLInputElement).value.trim();
      if (!name) {
        showToast('Escribe un nombre para la tarea', 'error');
        return;
      }
      body.newChore = {
        name,
        icon: (document.getElementById('log-new-icon') as HTMLInputElement).value.trim() || '✅',
        category: (document.getElementById('log-new-category') as HTMLInputElement).value.trim() || 'Hogar',
      };
    }

    const btn = document.getElementById('btn-confirm-log-chore') as HTMLButtonElement;
    btn.disabled = true;
    try {
      const res = await fetch('/api/chores/log', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify(body),
      });
      const data = await res.json();
      if (data.success) {
        triggerConfetti();
        showToast('Tarea registrada ✅', 'success');
        closeLogChoreModal();
        if (logMode === 'new') await loadCatalog();
        else catalogData = [];
        await logAfterSave?.();
      } else {
        showToast(data.error || 'Error al registrar la tarea', 'error');
      }
    } catch (err) {
      showToast('Error de conexión', 'error');
    } finally {
      btn.disabled = false;
    }
  }

  function switchTab(tab: 'calendar' | 'garage' | 'catalog' | 'roommates') {
    activeTab = tab;

    // Update bottom nav buttons
    document.querySelectorAll('.nav-tab').forEach((btn) => {
      const btnTab = btn.getAttribute('data-tab');
      if (btnTab === tab) {
        btn.classList.add('text-indigo-400');
        btn.classList.remove('text-slate-400');
      } else {
        btn.classList.remove('text-indigo-400');
        btn.classList.add('text-slate-400');
      }
    });

    // Update views visibility
    document.querySelectorAll('.tab-view').forEach((view) => {
      view.classList.add('hidden');
    });

    const targetView = document.getElementById(`view-${tab}`);
    if (targetView) {
      targetView.classList.remove('hidden');
    }

    // Refresh content for active tab
    if (tab === 'calendar') {
      if (calViewMode === 'month') {
        loadCalendar();
      } else {
        loadDashboard();
      }
    } else if (tab === 'garage') {
      loadGarage();
    } else if (tab === 'catalog') {
      loadCatalog();
    } else if (tab === 'roommates') {
      loadRoommates();
    }
  }

  function setCalendarViewMode(mode: 'month' | 'week') {
    calViewMode = mode;
    const btnMonth = document.getElementById('btn-cal-tab-month');
    const btnWeek = document.getElementById('btn-cal-tab-week');
    const subviewMonth = document.getElementById('cal-subview-month');
    const subviewWeek = document.getElementById('cal-subview-week');

    if (mode === 'month') {
      btnMonth?.classList.add('bg-indigo-600', 'text-white', 'font-bold');
      btnMonth?.classList.remove('text-slate-400');
      btnWeek?.classList.remove('bg-indigo-600', 'text-white', 'font-bold');
      btnWeek?.classList.add('text-slate-400');

      subviewMonth?.classList.remove('hidden');
      subviewWeek?.classList.add('hidden');

      loadCalendar();
    } else {
      btnWeek?.classList.add('bg-indigo-600', 'text-white', 'font-bold');
      btnWeek?.classList.remove('text-slate-400');
      btnMonth?.classList.remove('bg-indigo-600', 'text-white', 'font-bold');
      btnMonth?.classList.add('text-slate-400');

      subviewWeek?.classList.remove('hidden');
      subviewMonth?.classList.add('hidden');

      loadDashboard();
    }
  }

  // ==========================================
  // ==========================================
  // USER MANAGEMENT & SWITCHING
  // ==========================================
  async function loadUsers() {
    try {
      const res = await fetch('/api/users');
      const data = await res.json();
      if (data.success && data.users.length > 0) {
        usersList = data.users;

        // Restore active user from localStorage or pick the first
        const savedUserId = localStorage.getItem('tidyhome_active_user_id');
        if (savedUserId) {
          const found = usersList.find((u) => u.id === Number(savedUserId));
          activeUser = found || usersList[0];
        } else {
          activeUser = usersList[0];
        }

        localStorage.setItem('tidyhome_active_user_id', String(activeUser.id));
      } else {
        usersList = [];
        activeUser = null;
        localStorage.removeItem('tidyhome_active_user_id');
      }

      updateActiveUserUI();
      populateUserDropdown();
      populateAssigneeSelect();
    } catch (err) {
      console.error('Error loading users:', err);
    }
  }

  function setActiveUser(userId: number) {
    const user = usersList.find((u) => u.id === userId);
    if (!user) return;

    activeUser = user;
    localStorage.setItem('tidyhome_active_user_id', String(user.id));
    updateActiveUserUI();
    showToast(`Conviviente activo cambiado a ${user.name}`, 'info');

    // Reload active tab
    if (activeTab === 'calendar') {
      if (calViewMode === 'month') loadCalendar(); else loadDashboard();
    } else if (activeTab === 'garage') {
      loadGarage();
    }
  }

  function updateActiveUserUI() {
    const avatarEl = document.getElementById('active-user-avatar');
    const nameEl = document.getElementById('active-user-name');

    if (activeUser) {
      if (avatarEl) avatarEl.textContent = activeUser.avatar || '👤';
      if (nameEl) nameEl.textContent = activeUser.name;
    } else {
      if (avatarEl) avatarEl.textContent = '👤';
      if (nameEl) nameEl.textContent = 'Sin convivientes';
    }
  }

  function populateUserDropdown() {
    const list = document.getElementById('user-dropdown-list');
    if (!list) return;

    if (usersList.length === 0) {
      list.innerHTML = `<div class="px-2 py-1.5 text-xs text-slate-500 text-center">Sin convivientes dados de alta</div>`;
      return;
    }

    list.innerHTML = usersList
      .map(
        (u) => `
        <button
          type="button"
          data-user-id="${u.id}"
          class="user-dropdown-item w-full flex items-center justify-between px-2.5 py-2 rounded-xl text-xs font-semibold text-left transition ${
            activeUser?.id === u.id ? 'bg-indigo-600/20 text-indigo-300 border border-indigo-500/30' : 'text-slate-300 hover:bg-slate-800'
          }"
        >
          <div class="flex items-center gap-2">
            <span class="text-base">${u.avatar || '👤'}</span>
            <span>${u.name}</span>
          </div>
          ${activeUser?.id === u.id ? '<span class="text-indigo-400 text-xs">✓</span>' : ''}
        </button>
      `
      )
      .join('');

    list.querySelectorAll('.user-dropdown-item').forEach((btn) => {
      btn.addEventListener('click', () => {
        const userId = Number(btn.getAttribute('data-user-id'));
        setActiveUser(userId);
        document.getElementById('user-dropdown-menu')?.classList.add('hidden');
      });
    });
  }

  function populateAssigneeSelect() {
    const select = document.getElementById('select-chore-assignee') as HTMLSelectElement | null;
    if (!select) return;

    if (usersList.length === 0) {
      select.innerHTML = `<option value="">Primero añade un conviviente</option>`;
      return;
    }

    select.innerHTML = usersList
      .map(
        (u) => `
        <option value="${u.id}" ${activeUser?.id === u.id ? 'selected' : ''}>
          ${u.avatar || '👤'} ${u.name}
        </option>
      `
      )
      .join('');
  }

  // ==========================================
  // SYNC & GENERATE ENDPOINT CALL
  // ==========================================
  async function syncWeek() {
    const icon = document.getElementById('sync-icon');
    if (icon) icon.classList.add('rotate-180');

    try {
      const res = await fetch('/api/chores/generate', { method: 'POST' });
      const data = await res.json();
      if (data.success) {
        showToast(data.message || 'Semana sincronizada correctamente', 'success');
        if (activeTab === 'calendar') { if (calViewMode === 'month') loadCalendar(); else loadDashboard(); } else if (activeTab === 'garage') { loadGarage(); }
      } else {
        showToast(data.error || 'Error al sincronizar', 'error');
      }
    } catch (err) {
      showToast('Error de conexión al sincronizar', 'error');
    } finally {
      if (icon) {
        setTimeout(() => icon.classList.remove('rotate-180'), 600);
      }
    }
  }

  // ==========================================
  // VISTA 2: DASHBOARD / CASA (CARGA Y RENDER)
  // ==========================================
  async function loadDashboard() {
    const container = document.getElementById('dashboard-groups-container');
    if (!container) return;

    try {
      const res = await fetch('/api/chores/dashboard');
      const data = await res.json();

      if (!data.success) {
        container.innerHTML = `<div class="p-4 text-center text-rose-400 text-xs">${data.error}</div>`;
        return;
      }

      dashboardData = data;

      // Update Summary Header
      const pctEl = document.getElementById('dashboard-global-pct');
      const barEl = document.getElementById('dashboard-progress-bar');
      const doneEl = document.getElementById('dashboard-done-count');
      const pendingEl = document.getElementById('dashboard-pending-count');
      const rangeEl = document.getElementById('dashboard-week-range');

      if (pctEl) pctEl.textContent = `${data.summary.overallProgress}%`;
      if (barEl) barEl.style.width = `${data.summary.overallProgress}%`;
      if (doneEl) doneEl.textContent = String(data.summary.totalCompleted);
      if (pendingEl) pendingEl.textContent = String(data.summary.totalPending);
      if (rangeEl) rangeEl.textContent = `Semana: ${data.summary.weekRange}`;

      renderDashboardGroups();
    } catch (err) {
      console.error('Error fetching dashboard:', err);
    }
  }

  function renderDashboardGroups() {
    const container = document.getElementById('dashboard-groups-container');
    if (!container || !dashboardData) return;

    if (dashboardGroupBy === 'day') {
      renderDashboardByDay(container);
    } else {
      renderDashboardByUser(container);
    }
  }

  function renderDashboardByDay(container: HTMLElement) {
    if (!dashboardData) return;

    const days = dashboardData.choresByDay;

    container.innerHTML = days
      .map((dayGroup) => {
        const day = dayGroup.day;
        let chores = dayGroup.chores;

        // Apply status filter
        if (dashboardFilterStatus === 'pending') {
          chores = chores.filter((c) => c.status === 'pending');
        } else if (dashboardFilterStatus === 'completed') {
          chores = chores.filter((c) => c.status === 'completed');
        }

        const isToday = day.isToday;

        return `
          <div class="glass-card rounded-2xl overflow-hidden transition border ${
            isToday ? 'border-indigo-500/50 ring-1 ring-indigo-500/20' : 'border-slate-800'
          }">
            <!-- Day Header -->
            <div class="px-4 py-3 bg-slate-800/60 flex items-center justify-between border-b border-slate-700/50">
              <div class="flex items-center gap-2">
                <span class="text-sm font-bold text-white">
                  ${day.dayName} ${day.dayNumber}
                </span>
                ${
                  isToday
                    ? `<span class="px-2 py-0.5 text-[10px] font-bold bg-indigo-500 text-white rounded-full uppercase tracking-wider">
                        Hoy
                       </span>`
                    : ''
                }
              </div>

              <div class="flex items-center gap-2">
                ${
                  day.isToday || day.isPast
                    ? `<button type="button" class="btn-dash-add-day w-7 h-7 rounded-lg bg-indigo-600/20 hover:bg-indigo-600/40 text-indigo-300 font-bold text-base leading-none transition active:scale-90" data-date="${day.dateStr}" title="Añadir tarea hecha este día">+</button>`
                    : ''
                }
                <span class="text-xs font-semibold ${
                  dayGroup.isComplete
                    ? 'text-emerald-400'
                    : dayGroup.completedCount > 0
                    ? 'text-amber-400'
                    : 'text-slate-400'
                }">
                  ${dayGroup.completedCount} / ${dayGroup.totalCount}
                </span>
              </div>
            </div>

            <!-- Day Chores List -->
            <div class="p-3 space-y-2">
              ${
                chores.length === 0
                  ? `<div class="py-3 text-center text-xs text-slate-500">
                      ${dayGroup.totalCount === 0 ? 'Sin tareas programadas para este día.' : 'No hay tareas con el filtro seleccionado.'}
                     </div>`
                  : chores.map((chore) => renderChoreCardInDashboard(chore)).join('')
              }
            </div>
          </div>
        `;
      })
      .join('');

    attachDashboardActionListeners(container);
  }

  function renderDashboardByUser(container: HTMLElement) {
    if (!dashboardData) return;

    const users = dashboardData.users;
    const allChores = dashboardData.allChores;

    container.innerHTML = users
      .map((user) => {
        let userChores = allChores.filter((c) => c.assignedToId === user.id);

        if (dashboardFilterStatus === 'pending') {
          userChores = userChores.filter((c) => c.status === 'pending');
        } else if (dashboardFilterStatus === 'completed') {
          userChores = userChores.filter((c) => c.status === 'completed');
        }

        const totalUser = allChores.filter((c) => c.assignedToId === user.id).length;
        const doneUser = allChores.filter((c) => c.assignedToId === user.id && c.status === 'completed').length;
        const isMe = activeUser?.id === user.id;

        return `
          <div class="glass-card rounded-2xl overflow-hidden border ${
            isMe ? 'border-indigo-500/40' : 'border-slate-800'
          }">
            <!-- User Header -->
            <div class="px-4 py-3 bg-slate-800/60 flex items-center justify-between border-b border-slate-700/50">
              <div class="flex items-center gap-2.5">
                <span class="text-xl">${user.avatar || '👤'}</span>
                <div>
                  <div class="flex items-center gap-1.5">
                    <span class="text-sm font-bold text-white">${user.name}</span>
                    ${
                      isMe
                        ? `<span class="px-1.5 py-0.2 text-[9px] font-bold bg-indigo-500/20 text-indigo-300 rounded border border-indigo-500/30">TÚ</span>`
                        : ''
                    }
                  </div>
                  <span class="text-[10px] text-slate-400 font-medium">${user.email}</span>
                </div>
              </div>

              <div class="text-right">
                <span class="text-xs font-bold ${
                  doneUser === totalUser && totalUser > 0 ? 'text-emerald-400' : 'text-slate-300'
                }">
                  ${doneUser} / ${totalUser}
                </span>
                <span class="text-[10px] text-slate-500 block">completadas</span>
              </div>
            </div>

            <!-- Chores List -->
            <div class="p-3 space-y-2">
              ${
                userChores.length === 0
                  ? `<div class="py-3 text-center text-xs text-slate-500">
                      Sin tareas asignadas con el filtro actual.
                     </div>`
                  : userChores.map((chore) => renderChoreCardInDashboard(chore)).join('')
              }
            </div>
          </div>
        `;
      })
      .join('');

    attachDashboardActionListeners(container);
  }

  /**
   * Render individual chore card in Dashboard with the "¡Lo hago yo!" button
   */
  function renderChoreCardInDashboard(chore: ChoreLogItem): string {
    const isCompleted = chore.status === 'completed';
    const isOverdue = chore.isOverdue;
    const isStolen = isCompleted && chore.executedById && chore.executedById !== chore.assignedToId;
    const isAssignedToMe = activeUser?.id === chore.assignedToId;

    return `
      <div
        class="glass-card rounded-xl p-3 flex items-center justify-between gap-3 border transition ${
          isOverdue
            ? 'card-overdue'
            : isCompleted
            ? 'bg-emerald-950/20 border-emerald-500/30 text-slate-300'
            : 'bg-slate-900/60 border-slate-700/60 hover:border-slate-600'
        }"
        id="dash-chore-${chore.id}"
      >
        <!-- Icon & Description -->
        <div class="flex items-start gap-2.5 flex-1 min-w-0">
          <div class="w-8 h-8 rounded-lg flex items-center justify-center text-lg shrink-0 ${
            isOverdue
              ? 'bg-rose-200/60 text-rose-700 ring-1 ring-rose-300'
              : isCompleted
              ? 'bg-emerald-500/20 text-emerald-400'
              : 'bg-slate-800 text-slate-200'
          }">
            ${chore.icon || '🧹'}
          </div>

          <div class="min-w-0 flex-1">
            <div class="flex items-center gap-1.5 flex-wrap">
              <span class="text-xs font-bold truncate ${
                isOverdue ? 'text-rose-950 font-extrabold' : isCompleted ? 'line-through text-slate-400' : 'text-white'
              }">
                ${chore.choreName}
              </span>
              <span class="text-[9px] px-1.5 py-0.2 rounded font-medium bg-slate-800 text-slate-400">
                ${chore.category}
              </span>
              ${
                chore.assignmentMode === 'rotating'
                  ? `<span class="text-[9px] px-1.5 py-0.2 rounded font-semibold bg-purple-500/15 text-purple-300 border border-purple-500/30">
                      🔄 Rotativa
                     </span>`
                  : ''
              }
            </div>

            <!-- Details: Assignee & Executor -->
            <div class="flex items-center gap-2 mt-1 flex-wrap text-[11px]">
              <span class="inline-flex items-center gap-1 text-slate-400">
                <span>${chore.assignedToAvatar}</span>
                <span class="${isAssignedToMe ? 'text-indigo-600 font-semibold' : ''}">
                  ${chore.assignedToName}
                </span>
              </span>

              ${
                isStolen
                  ? `<span class="inline-flex items-center gap-1 px-1.5 py-0.5 rounded-md text-[10px] font-bold bg-pink-500/15 text-pink-300 border border-pink-500/30">
                      ⚡ ¡Robado por ${chore.executedByName}!
                     </span>`
                  : isCompleted
                  ? `<span class="inline-flex items-center gap-1 px-1.5 py-0.5 rounded-md text-[10px] font-semibold bg-emerald-500/15 text-emerald-300 border border-emerald-500/30">
                      ✓ Hecho por ${chore.executedByName || chore.assignedToName}
                     </span>`
                  : isOverdue
                  ? `<span class="text-[10px] text-rose-700 font-bold bg-rose-100/90 px-1.5 py-0.5 rounded border border-rose-200">⚠️ Con retraso</span>`
                  : `<span class="text-[10px] text-amber-400/90 font-medium">⏳ Pendiente</span>`
              }

              ${formatScheduledDateBadge(chore)}
            </div>
          </div>
        </div>

        <!-- Action Button: ¡Lo hago yo! or Toggle Check -->
        <div class="shrink-0 flex items-center gap-1.5">
          ${
            !isCompleted
              ? `
                <button
                  class="btn-steal-chore inline-flex items-center gap-1 px-3 py-1.5 rounded-xl text-xs font-bold text-white transition active:scale-95 shadow-md ${
                    isAssignedToMe
                      ? 'bg-indigo-600 hover:bg-indigo-500 shadow-indigo-600/30'
                      : 'bg-gradient-to-r from-pink-600 to-rose-600 hover:from-pink-500 hover:to-rose-500 shadow-pink-600/30 pulse-steal'
                  }"
                  data-id="${chore.id}"
                  data-assignee="${chore.assignedToName}"
                  data-mine="${isAssignedToMe}"
                  id="btn-steal-${chore.id}"
                >
                  <span class="btn-spinner hidden w-3 h-3 border-2 border-white border-t-transparent rounded-full animate-spin"></span>
                  <span class="btn-text">
                    ${isAssignedToMe ? '✓ Hecho' : '¡Lo hago yo! ⚡'}
                  </span>
                </button>
              `
              : `
                <button
                  class="btn-undo-chore p-1.5 text-slate-400 hover:text-rose-400 hover:bg-slate-800 rounded-lg transition"
                  data-id="${chore.id}"
                  title="Desmarcar y volver a pendiente"
                >
                  <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 10h10a8 8 0 018 8v2M3 10l6 6m-6-6l6-6" />
                  </svg>
                </button>
              `
          }
        </div>
      </div>
    `;
  }

  function attachDashboardActionListeners(container: HTMLElement) {
    // Añadir tarea hecha en un día
    container.querySelectorAll('.btn-dash-add-day').forEach((btn) => {
      btn.addEventListener('click', () => {
        openLogChoreModal(btn.getAttribute('data-date')!, () => loadDashboard());
      });
    });

    // "¡Lo hago yo!" buttons
    container.querySelectorAll('.btn-steal-chore').forEach((btn) => {
      btn.addEventListener('click', async () => {
        const choreId = Number(btn.getAttribute('data-id'));
        const assignee = btn.getAttribute('data-assignee');
        const isMine = btn.getAttribute('data-mine') === 'true';

        // Set Loading state
        const spinner = btn.querySelector('.btn-spinner');
        const text = btn.querySelector('.btn-text');
        btn.setAttribute('disabled', 'true');
        spinner?.classList.remove('hidden');
        if (text) text.textContent = 'Guardando...';

        try {
          const res = await fetch('/api/chores/execute', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({
              choreLogId: choreId,
              userId: activeUser?.id,
              desiredStatus: 'completed',
            }),
          });
          const result = await res.json();

          if (result.success) {
            triggerConfetti();
            let msg = !isMine
              ? `¡Increíble! Has asumido la tarea de ${assignee} 👏`
              : '¡Tarea completada con éxito!';
            if (result.wasMoved && result.originalTargetDate) {
              const origParts = result.originalTargetDate.split('-').map(Number);
              const origDate = new Date(origParts[0], origParts[1] - 1, origParts[2]);
              const daysOfWeekEs = ['domingo', 'lunes', 'martes', 'miércoles', 'jueves', 'viernes', 'sábado'];
              const dayName = daysOfWeekEs[origDate.getDay()];
              msg += ` (Movida a hoy · programada para el ${dayName})`;
            }
            showToast(msg, 'success');
            await loadDashboard();
          } else {
            showToast(result.error || 'Error al completar', 'error');
            btn.removeAttribute('disabled');
            spinner?.classList.add('hidden');
            if (text) text.textContent = isMine ? '✓ Hecho' : '¡Lo hago yo! ⚡';
          }
        } catch (err) {
          showToast('Error de conexión', 'error');
          btn.removeAttribute('disabled');
          spinner?.classList.add('hidden');
        }
      });
    });

    // Undo buttons
    container.querySelectorAll('.btn-undo-chore').forEach((btn) => {
      btn.addEventListener('click', async () => {
        const choreId = Number(btn.getAttribute('data-id'));
        btn.setAttribute('disabled', 'true');
        await toggleChore(choreId, 'pending');
        await loadDashboard();
      });
    });
  }

  // ==========================================
  // TOGGLE / EXECUTE CHORE HELPER
  // ==========================================
  async function toggleChore(choreLogId: number, desiredStatus: 'completed' | 'pending') {
    if (!activeUser) return;

    try {
      const res = await fetch('/api/chores/execute', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({
          choreLogId,
          userId: activeUser.id,
          desiredStatus,
        }),
      });

      const data = await res.json();
      if (data.success) {
        if (desiredStatus === 'completed') {
          triggerConfetti();
          let msg = data.message || 'Tarea completada 🎉';
          if (data.wasMoved && data.originalTargetDate) {
            const origParts = data.originalTargetDate.split('-').map(Number);
            const origDate = new Date(origParts[0], origParts[1] - 1, origParts[2]);
            const daysOfWeekEs = ['domingo', 'lunes', 'martes', 'miércoles', 'jueves', 'viernes', 'sábado'];
            const dayName = daysOfWeekEs[origDate.getDay()];
            msg = `¡Tarea completada y movida a hoy! (Programada para el ${dayName})`;
          }
          showToast(msg, 'success');
        } else {
          showToast('Tarea restablecida a pendiente (en su día programado)', 'info');
        }
        if (dashboardData) loadDashboard();
      } else {
        showToast(data.error || 'Error al actualizar', 'error');
      }
    } catch (err) {
      showToast('Error de red', 'error');
    }
  }

  // ==========================================
  // VISTA 3: CATÁLOGO DE TAREAS (CARGA Y RENDER)
  // ==========================================
  async function loadCatalog() {
    const container = document.getElementById('catalog-list-container');
    if (!container) return;

    try {
      const res = await fetch('/api/catalog');
      const data = await res.json();

      if (!data.success) {
        container.innerHTML = `<div class="p-4 text-center text-rose-400 text-xs">${data.error}</div>`;
        return;
      }

      catalogData = data.catalog;
      renderCatalog();
    } catch (err) {
      console.error('Error fetching catalog:', err);
    }
  }

  // ==========================================
  // MODAL CONTROLLERS (CHORES & USERS)
  // ==========================================
  function openEditChoreModal(id: number) {
    const item = catalogData.find((c) => c.id === id);
    if (!item) {
      console.warn('Tarea no encontrada en catálogo para id:', id);
      return;
    }

    populateAssigneeSelect();

    const modalChore = document.getElementById('modal-new-chore');
    const inputEditId = document.getElementById('input-edit-chore-id') as HTMLInputElement | null;
    const titleEl = document.getElementById('modal-chore-title');
    const iconEl = document.getElementById('modal-chore-icon');
    const submitBtn = document.getElementById('btn-submit-new-chore');

    if (inputEditId) inputEditId.value = String(item.id);
    if (titleEl) titleEl.textContent = 'Editar Tarea';
    if (iconEl) iconEl.textContent = '✏️';
    if (submitBtn) submitBtn.textContent = 'Guardar Cambios';

    const nameInput = document.getElementById('input-chore-name') as HTMLInputElement | null;
    const freqSelect = document.getElementById('select-chore-frequency') as HTMLSelectElement | null;
    const daySelect = document.getElementById('select-chore-day') as HTMLSelectElement | null;
    const secondDaySelect = document.getElementById('select-chore-second-day') as HTMLSelectElement | null;
    const assigneeSelect = document.getElementById('select-chore-assignee') as HTMLSelectElement | null;
    const iconInput = document.getElementById('input-chore-icon') as HTMLInputElement | null;
    const categoryInput = document.getElementById('input-chore-category') as HTMLInputElement | null;

    if (nameInput) nameInput.value = item.name || '';
    if (freqSelect) freqSelect.value = item.frequency || 'weekly';
    if (daySelect) daySelect.value = String(item.dayOfWeek ?? 1);
    if (secondDaySelect) secondDaySelect.value = String(item.secondDayOfWeek ?? 4);

    const containerSecondDay = document.getElementById('container-second-day');
    const labelDay1 = document.getElementById('label-chore-day-1');
    if (item.frequency === 'twice_weekly') {
      containerSecondDay?.classList.remove('hidden');
      if (labelDay1) labelDay1.textContent = 'Primer día';
    } else {
      containerSecondDay?.classList.add('hidden');
      if (labelDay1) labelDay1.textContent = 'Día preferido';
    }

    const radio = document.querySelector(`input[name="assignment-mode"][value="${item.assignmentMode || 'fixed'}"]`) as HTMLInputElement | null;
    if (radio) {
      radio.checked = true;
      radio.dispatchEvent(new Event('change'));
    }

    if (assigneeSelect) assigneeSelect.value = String(item.defaultAssigneeId);
    if (iconInput) iconInput.value = item.icon || '🧹';
    if (categoryInput) categoryInput.value = item.category || 'Hogar';

    modalChore?.classList.remove('hidden');
    modalChore?.classList.add('flex');
  }

  function openNewChoreModal() {
    populateAssigneeSelect();

    const modalChore = document.getElementById('modal-new-chore');
    const formChore = document.getElementById('form-new-chore') as HTMLFormElement | null;
    const inputEditId = document.getElementById('input-edit-chore-id') as HTMLInputElement | null;
    const titleEl = document.getElementById('modal-chore-title');
    const iconEl = document.getElementById('modal-chore-icon');
    const submitBtn = document.getElementById('btn-submit-new-chore');

    if (inputEditId) inputEditId.value = '';
    if (titleEl) titleEl.textContent = 'Nueva Tarea';
    if (iconEl) iconEl.textContent = '✨';
    if (submitBtn) submitBtn.textContent = 'Guardar y Sincronizar';

    formChore?.reset();
    document.getElementById('container-second-day')?.classList.add('hidden');
    const labelDay1 = document.getElementById('label-chore-day-1');
    if (labelDay1) labelDay1.textContent = 'Día preferido';

    const radio = document.querySelector('input[name="assignment-mode"][value="fixed"]') as HTMLInputElement | null;
    if (radio) {
      radio.checked = true;
      radio.dispatchEvent(new Event('change'));
