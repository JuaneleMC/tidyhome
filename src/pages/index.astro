    }

    cardsEl.innerHTML = usersList
      .map((u) => {
        const uStat = stats.find((s: any) => s.user.id === u.id);
        const isMe = activeUser?.id === u.id;

        return `
          <div class="glass-card rounded-2xl p-4 border ${isMe ? 'border-indigo-500/50' : 'border-slate-800'}" id="user-card-${u.id}">
            <div class="flex items-center justify-between gap-2.5 min-w-0">
              <div class="flex items-center gap-2.5 min-w-0 flex-1">
                <span class="text-3xl shrink-0">${u.avatar || '👤'}</span>
                <div class="min-w-0 flex-1">
                  <h4 class="text-sm font-bold text-white flex items-center gap-1.5 truncate">
                    <span class="truncate">${u.name}</span>
                    ${isMe ? '<span class="text-[10px] px-1.5 py-0.2 bg-indigo-600 text-white rounded-full shrink-0">Activo</span>' : ''}
                  </h4>
                  <p class="text-xs text-slate-400 truncate" title="${u.email}">${u.email}</p>
                </div>
              </div>

              <div class="flex items-center gap-1.5 shrink-0">
                ${
                  !isMe
                    ? `<button
                        class="btn-select-as-active px-2.5 py-1.5 rounded-lg bg-slate-800 hover:bg-slate-700 text-slate-300 text-xs font-medium border border-slate-700 transition shrink-0"
                        data-id="${u.id}"
                      >
                        Elegir
                       </button>`
