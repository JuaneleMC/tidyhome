  async function loadShoppingList() {
    try {
      const res = await fetch('/api/shopping');
      const data = await res.json();
      if (data.success) {
        shoppingItemsList = data.items || [];
        updateShoppingBadge();
        renderShoppingList();
      }
    } catch (err) {
      console.error('Error fetching shopping list:', err);
    }
  }

  async function loadShoppingCatalog() {
    try {
      const res = await fetch('/api/shopping/catalog');
      const data = await res.json();
      if (data.success) {
        shoppingCatalogList = data.items || [];
        const badgeCatalogCount = document.getElementById('badge-subtab-catalog-count');
        const badgeTotal = document.getElementById('catalog-total-items-badge');
        if (badgeCatalogCount) badgeCatalogCount.textContent = String(shoppingCatalogList.length);
        if (badgeTotal) badgeTotal.textContent = `${shoppingCatalogList.length} artículos`;
        renderShoppingCatalog();
      }
    } catch (err) {
      console.error('Error fetching shopping catalog:', err);
    }
  }

  function updateShoppingBadge() {
    const badge = document.getElementById('badge-shopping-count');
    const subtabBadge = document.getElementById('badge-subtab-shopping-count');
    const pendingCount = shoppingItemsList.filter((i) => !i.isBought).length;

    const countText = pendingCount > 99 ? '99+' : String(pendingCount);

    if (badge) {
      if (pendingCount > 0) {
        badge.textContent = countText;
        badge.classList.remove('hidden');
      } else {
        badge.classList.add('hidden');
      }
    }

    if (subtabBadge) {
      subtabBadge.textContent = countText;
    }
  }

  // 1. RENDER LISTA ACTIVA DE LA COMPRA (Agrupada por categorías con steppers)
  function renderShoppingList() {
    const pendingContainer = document.getElementById('shopping-pending-container');
    const boughtContainer = document.getElementById('shopping-bought-container');
    const boughtWrapper = document.getElementById('shopping-bought-wrapper');
    const clearBoughtBtn = document.getElementById('btn-shopping-clear-bought');
    const catFilterContainer = document.getElementById('shopping-category-filter');
    const countLabel = document.getElementById('shopping-pending-count-label');
    const boughtCountLabel = document.getElementById('shopping-bought-count');
    const activeShopperEl = document.getElementById('shopping-active-shopper');

    if (!pendingContainer || !boughtContainer) return;

    const pendingItems = shoppingItemsList.filter((i) => !i.isBought);
    const boughtItems = shoppingItemsList.filter((i) => i.isBought);

    // Update counts and status
    if (countLabel) {
      countLabel.textContent = `${pendingItems.length} ${pendingItems.length === 1 ? 'artículo pendiente' : 'artículos por comprar'}`;
    }
    if (boughtCountLabel) {
      boughtCountLabel.textContent = String(boughtItems.length);
    }
    if (activeShopperEl) {
      activeShopperEl.textContent = activeUser ? `Tachando como: ${activeUser.avatar || '👤'} ${activeUser.name}` : '';
    }

    // Toggle Clear Bought button & Bought section
    if (clearBoughtBtn) {
      clearBoughtBtn.classList.toggle('hidden', boughtItems.length === 0);
    }
    if (boughtWrapper) {
      boughtWrapper.classList.toggle('hidden', boughtItems.length === 0);
    }

    // Render Category Filter Pills
    if (catFilterContainer) {
      const categoriesPresent = Array.from(new Set(pendingItems.map((i) => i.category || 'Otros')));
      if (categoriesPresent.length > 1) {
        catFilterContainer.classList.remove('hidden');
        catFilterContainer.innerHTML = `
          <button
            type="button"
            class="btn-shopping-cat-filter px-3 py-1 rounded-lg text-xs font-semibold transition ${
              shoppingCategoryFilter === 'all'
                ? 'bg-emerald-600 text-white shadow-sm'
                : 'bg-slate-800 text-slate-400 hover:text-white'
            }"
            data-cat="all"
          >
            Todos (${pendingItems.length})
          </button>
          ${categoriesPresent
            .map((cat) => {
              const count = pendingItems.filter((i) => (i.category || 'Otros') === cat).length;
              const meta = SHOPPING_CATEGORIES_DATA[cat] || SHOPPING_CATEGORIES_DATA['Otros'];
              const isActive = shoppingCategoryFilter === cat;
              return `
                <button
                  type="button"
                  class="btn-shopping-cat-filter shrink-0 inline-flex items-center gap-1 px-2.5 py-1 rounded-lg text-xs font-medium border transition ${
                    isActive
                      ? 'bg-emerald-600 text-white border-emerald-500 shadow-sm'
                      : 'bg-slate-800/80 text-slate-300 hover:text-white border-slate-700/60'
                  }"
                  data-cat="${escHtml(cat)}"
                >
                  <span>${meta.icon}</span>
                  <span>${escHtml(cat)}</span>
                  <span class="text-[10px] px-1 py-0.2 rounded bg-slate-900/60 font-bold">${count}</span>
                </button>
              `;
            })
            .join('')}
        `;

        catFilterContainer.querySelectorAll('.btn-shopping-cat-filter').forEach((btn) => {
          btn.addEventListener('click', () => {
            shoppingCategoryFilter = btn.getAttribute('data-cat') || 'all';
            renderShoppingList();
          });
        });
      } else {
        catFilterContainer.classList.add('hidden');
      }
    }

    // Filter pending items
    let filteredPending = [...pendingItems];
    if (shoppingCategoryFilter !== 'all') {
      filteredPending = filteredPending.filter((i) => (i.category || 'Otros') === shoppingCategoryFilter);
    }

    // Render Pending Items Grouped by Category
    if (pendingItems.length === 0) {
      pendingContainer.innerHTML = `
        <div class="glass-card rounded-2xl p-8 text-center space-y-3 border border-slate-800">
          <div class="text-4xl animate-bounce">🎉</div>
          <h4 class="text-sm font-bold text-white">¡No falta nada en la despensa!</h4>
          <p class="text-xs text-slate-400 max-w-sm mx-auto">
            Ve a la pestaña <strong>"Artículos en uso"</strong> para marcar con un toque lo que vayáis a comprar.
          </p>
          <button
            type="button"
            id="btn-empty-go-catalog"
            class="inline-flex items-center gap-1.5 px-4 py-2.5 rounded-xl bg-emerald-600/20 hover:bg-emerald-600/30 border border-emerald-500/40 text-emerald-300 text-xs font-bold transition active:scale-95"
          >
            <span>📦</span>
            <span>Ir a Artículos en uso (Despensa) →</span>
          </button>
        </div>
      `;

      document.getElementById('btn-empty-go-catalog')?.addEventListener('click', () => {
        setShoppingSubtab('catalog');
      });
    } else if (filteredPending.length === 0) {
      pendingContainer.innerHTML = `
        <div class="glass-card rounded-2xl p-6 text-center space-y-1 text-slate-400 text-xs">
          <p>No hay artículos pendientes en esta categoría.</p>
        </div>
      `;
    } else {
      // Group by category
      const groupsMap = new Map<string, any[]>();
      for (const item of filteredPending) {
        const cat = item.category || 'Otros';
